import SquareKit.Internal.DependentJudgments.ReferenceDerived

/-! The category generated by finite context extension and structural
substitutions in the reference calculus, modulo its typed source equality. -/
namespace SquareKit.Internal.DependentJudgments.Contextual.Reference
open CategoryTheory
variable {V : Type} {Ξ : List (Declaration V)}

inductive ContextTree (Ξ : List (Declaration V)) : Expression V → Type where
  | empty : ContextTree Ξ empty
  | extend {Γ A : Expression V} : ContextTree Ξ Γ → Derives Ξ (.has (.ty Γ) A) →
      ContextTree Ξ (Contextual.extend Γ A)

namespace ContextTree
noncomputable def typing {Γ : Expression V} (h : ContextTree Ξ Γ) : Derives Ξ (.has .ctx Γ) :=
  match h with
  | .empty => .empty
  | .extend _ hA => .extend hA

def toEmpty {Γ : Expression V} : ContextTree Ξ Γ → Expression V
  | .empty => identitySub Contextual.empty
  | .extend (Γ := Γ) (A := A) hΓ _ => comp hΓ.toEmpty (weaken Γ A)

noncomputable def toEmptyTyped {Γ : Expression V} (h : ContextTree Ξ Γ) :
    Derives Ξ (.has (.sub Γ Contextual.empty) h.toEmpty) :=
  match h with
  | .empty => .identitySub .empty
  | .extend hΓ hA => .comp hΓ.toEmptyTyped (.weaken hA)
end ContextTree

inductive Arrow {Ξ : List (Declaration V)} : {Δ Γ : Expression V} →
    ContextTree Ξ Δ → ContextTree Ξ Γ → Expression V → Type where
  | identity (hΓ : ContextTree Ξ Γ) : Arrow hΓ hΓ (identitySub Γ)
  | comp {hΓ : ContextTree Ξ Γ} {hΔ : ContextTree Ξ Δ} {hΘ : ContextTree Ξ Θ} :
      Arrow hΔ hΓ σ → Arrow hΘ hΔ τ → Arrow hΘ hΓ (Contextual.comp σ τ)
  | weaken (hΓ : ContextTree Ξ Γ) (hA : Derives Ξ (.has (.ty Γ) A)) :
      Arrow (hΓ.extend hA) hΓ (Contextual.weaken Γ A)
  | pair {hΓ : ContextTree Ξ Γ} {hΔ : ContextTree Ξ Δ}
      (hA : Derives Ξ (.has (.ty Γ) A)) : Arrow hΔ hΓ σ →
      Derives Ξ (.has (.tm Δ (subTy A σ)) t) →
      Arrow hΔ (hΓ.extend hA) (Contextual.pair A σ t)
  | convert {hΓ : ContextTree Ξ Γ} {hΔ : ContextTree Ξ Δ} :
      Arrow hΔ hΓ σ → Derives Ξ (.eq (.sub Δ Γ) σ τ) → Arrow hΔ hΓ τ

namespace Arrow
variable {Γ Δ Θ σ τ υ : Expression V} {hΓ : ContextTree Ξ Γ} {hΔ : ContextTree Ξ Δ}
noncomputable def typing {Γ Δ σ : Expression V}
    {hΓ : ContextTree Ξ Γ} {hΔ : ContextTree Ξ Δ} (f : Arrow hΔ hΓ σ) : Derives Ξ (.has (.sub Δ Γ) σ) :=
  match f with
  | .identity hΓ => .identitySub hΓ.typing
  | .comp f g => .comp f.typing g.typing
  | .weaken _ hA => .weaken hA
  | .pair hA f ht => .pair hA f.typing ht
  | .convert _ e => e.eqOperands.2

noncomputable def compEquality {σ' τ' : Expression V}
    (e : Derives Ξ (.eq (.sub Δ Γ) σ σ')) (e' : Derives Ξ (.eq (.sub Θ Δ) τ τ')) :
    Derives Ξ (.eq (.sub Θ Γ) (Contextual.comp σ τ) (Contextual.comp σ' τ')) :=
  .congruence (.inl .comp) ![.sub Δ Γ, .sub Θ Δ]
    (.comp e.eqOperands.1 e'.eqOperands.1) (.comp e.eqOperands.2 e'.eqOperands.2)
    (Fin.cases e (Fin.cases e' (fun i => nomatch i)))

noncomputable def emptyNatural {Γ Δ σ : Expression V}
    {hΓ : ContextTree Ξ Γ} {hΔ : ContextTree Ξ Δ} (f : Arrow hΔ hΓ σ) :
    Derives Ξ (.eq (.sub Δ empty) (Contextual.comp hΓ.toEmpty σ) hΔ.toEmpty) :=
  match f with
  | .identity hΓ => .subIdRight hΓ.toEmptyTyped
  | .comp (hΓ := hΓ) f g =>
      .eqTrans (.eqSymm (.subAssoc hΓ.toEmptyTyped f.typing g.typing))
        (.eqTrans (compEquality f.emptyNatural (.eqRefl g.typing)) g.emptyNatural)
  | .weaken hΓ hA => .eqRefl (.comp hΓ.toEmptyTyped (.weaken hA))
  | .pair (hΓ := hΓ) hA f ht =>
      .eqTrans (.subAssoc hΓ.toEmptyTyped (.weaken hA) (.pair hA f.typing ht))
        (.eqTrans (compEquality (.eqRefl hΓ.toEmptyTyped) (.weakenPair hA f.typing ht))
          f.emptyNatural)
  | .convert f e => .eqTrans (.eqSymm (compEquality (.eqRefl hΓ.toEmptyTyped) e)) f.emptyNatural

noncomputable def emptyUnique (f : Arrow hΔ .empty σ) :
    Derives Ξ (.eq (.sub Δ empty) σ hΔ.toEmpty) :=
  .eqTrans (.eqSymm (.subIdLeft f.typing)) f.emptyNatural

noncomputable def toEmpty {Γ : Expression V} (hΓ : ContextTree Ξ Γ) : Arrow hΓ .empty hΓ.toEmpty :=
  match hΓ with
  | .empty => .identity .empty
  | .extend hΓ hA => .comp (toEmpty hΓ) (.weaken hΓ hA)
end Arrow

namespace GeneratedCategory
noncomputable section

def Object (Ξ : List (Declaration V)) := (Γ : Expression V) × ContextTree Ξ Γ
abbrev Representative (Δ Γ : Object Ξ) := (σ : Expression V) × Arrow Δ.2 Γ.2 σ

def equality (Δ Γ : Object Ξ) : Setoid (Representative Δ Γ) where
  r f g := Nonempty (Derives Ξ (.eq (.sub Δ.1 Γ.1) f.1 g.1))
  iseqv := ⟨fun f => ⟨.eqRefl f.2.typing⟩,
    fun ⟨h⟩ => ⟨.eqSymm h⟩, fun ⟨h⟩ ⟨k⟩ => ⟨.eqTrans h k⟩⟩

def compose {Γ Δ Θ : Object Ξ}
    (f : Quotient (equality Γ Δ)) (g : Quotient (equality Δ Θ)) : Quotient (equality Γ Θ) :=
  Quotient.map₂ (fun f g => ⟨comp g.1 f.1, .comp g.2 f.2⟩)
    (by intro f f' ⟨hf⟩ g g' ⟨hg⟩; exact ⟨Arrow.compEquality hg hf⟩) f g

instance category : Category (Object Ξ) where
  Hom Δ Γ := Quotient (equality Δ Γ)
  id Γ := Quotient.mk _ ⟨identitySub Γ.1, .identity Γ.2⟩
  comp := compose
  id_comp f := Quotient.inductionOn f fun f => Quotient.sound ⟨.subIdRight f.2.typing⟩
  comp_id f := Quotient.inductionOn f fun f => Quotient.sound ⟨.subIdLeft f.2.typing⟩
  assoc f g h := Quotient.inductionOn₃ f g h fun f g h =>
    Quotient.sound ⟨.eqSymm (.subAssoc h.2.typing g.2.typing f.2.typing)⟩

def emptyObject (Ξ : List (Declaration V)) : Object Ξ := ⟨empty, .empty⟩

/-- The reference quotient uses typed source equality, not an equality reflected
from arbitrary raw engine derivations. -/
instance emptyUnique (Δ : Object Ξ) : Unique (Δ ⟶ emptyObject Ξ) where
  default := Quotient.mk _ ⟨Δ.2.toEmpty, Arrow.toEmpty Δ.2⟩
  uniq f := Quotient.inductionOn f fun f => Quotient.sound ⟨f.2.emptyUnique⟩

/-- The target quotient has the same generated representatives but permits
all equalities derivable in the explicitly extended guarded theory. -/
def targetEquality (Δ Γ : Object Ξ) : Setoid (Representative Δ Γ) where
  r f g := Nonempty (Target (Ω := Ξ.map Declaration.encode) (.eq f.1 g.1))
  iseqv := ⟨fun f => ⟨.reflexive f.1⟩,
    fun ⟨h⟩ => ⟨.symmetric h⟩, fun ⟨h⟩ ⟨k⟩ => ⟨.transitive h k⟩⟩

/-- Derivability preservation induces the quotient map. Injectivity would
require a separate reflection theorem, which is not asserted. -/
def forward (Δ Γ : Object Ξ) : Quotient (equality Δ Γ) → Quotient (targetEquality Δ Γ) :=
  Quotient.map id (by intro f g ⟨h⟩; exact ⟨translate h⟩)

theorem forward_empty_unique (Δ : Object Ξ) (f : Quotient (equality Δ (emptyObject Ξ))) :
    forward Δ (emptyObject Ξ) f =
      forward Δ (emptyObject Ξ) (Quotient.mk _ ⟨Δ.2.toEmpty, Arrow.toEmpty Δ.2⟩) := by
  apply congrArg (forward Δ (emptyObject Ξ))
  exact Quotient.inductionOn f fun f => Quotient.sound ⟨f.2.emptyUnique⟩

/-- The earlier closed generated-arrow result remains available in the new
presentation on its exact original domain. This is not a landing theorem for
all reference terms or all guarded substitution judgments. -/
def original_generated_empty_unique {Ω : List (Judgment V)} {Δ σ : Expression V}
    {hΔ : Contextual.GeneratedContext Ω Δ}
    (f : Contextual.GeneratedArrow Contextual.closedArrows Ω hΔ .empty σ) :
    Target (Ω := Ω) (.eq σ hΔ.emptySubstitution) :=
  TelescopePresentation.embed f.empty_unique

end
end GeneratedCategory
end SquareKit.Internal.DependentJudgments.Contextual.Reference
