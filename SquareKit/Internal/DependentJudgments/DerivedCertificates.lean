import SquareKit.Internal.DependentJudgments.DerivedPaths

/-! Selected dependent certificates generated by contextual Contextual.identity elimination.
The composition motive uses the value being transported. The dependent action
compares transport of the source section with its target section. -/
namespace SquareKit.Internal.DependentJudgments.Contextual
open GuardedTheory
set_option backward.isDefEq.respectTransparency false
variable {V : Type} {Ω : List (Judgment V)}
variable {Γ A B x y z p q u t : Expression V}

abbrev transportGeneric (Γ A B x u : Expression V) : Expression V :=
  Contextual.basedJ A x (Contextual.transportMotive Γ A B x) u

def Tm.transportGeneric (hB : Ty (Ω := Ω) (Contextual.extend Γ A) B) (hx : Tm (Ω := Ω) Γ A x)
    (hu : Tm (Ω := Ω) Γ (Contextual.subTy B (Contextual.sectionSub Γ A x)) u) :
    Tm (Ω := Ω) (Contextual.path A x) (Contextual.transportMotive Γ A B x) (Contextual.transportGeneric Γ A B x u) :=
  hx.basedJ (hB.substitute hx.pathProjection) (hu.convert (hB.transportRoot hx).symmetric)

def Tm.transportGenericRoot (hB : Ty (Ω := Ω) (Contextual.extend Γ A) B) (hx : Tm (Ω := Ω) Γ A x)
    (hu : Tm (Ω := Ω) Γ (Contextual.subTy B (Contextual.sectionSub Γ A x)) u) :
    Equal (Ω := Ω) (Contextual.subTm (Contextual.transportGeneric Γ A B x u) (Contextual.root A x)) u :=
  hx.basedJBeta (hB.substitute hx.pathProjection) (hu.convert (hB.transportRoot hx).symmetric)

abbrev concatGeneric (Γ A x y p : Expression V) : Expression V :=
  transportGeneric Γ A (Contextual.pathFamily Γ A x) y p

abbrev concatMap (Γ A x y p : Expression V) : Expression V :=
  Contextual.pair (Contextual.pathFamily Γ A x) (Contextual.weaken (Contextual.extend Γ A) (Contextual.pathFamily Γ A y)) (concatGeneric Γ A x y p)

def Tm.concatGeneric (hx : Tm (Ω := Ω) Γ A x) (hy : Tm (Ω := Ω) Γ A y)
    (hp : Tm (Ω := Ω) Γ (Contextual.identity A x y) p) :
    Tm (Ω := Ω) (Contextual.path A y) (Contextual.transportMotive Γ A (Contextual.pathFamily Γ A x) y)
      (Contextual.concatGeneric Γ A x y p) :=
  Tm.transportGeneric hx.pathFamily hy (hp.convert (hx.pathFamilySection hy).symmetric)

def Tm.concatMap (hx : Tm (Ω := Ω) Γ A x) (hy : Tm (Ω := Ω) Γ A y)
    (hp : Tm (Ω := Ω) Γ (Contextual.identity A x y) p) :
    Sub (Ω := Ω) (Contextual.path A y) (Contextual.path A x) (Contextual.concatMap Γ A x y p) :=
  (Sub.pair hx.pathFamily hy.pathProjection (hx.concatGeneric hy hp)).retarget hx.pathDef.symmetric

def Tm.concatMapProjection (hx : Tm (Ω := Ω) Γ A x) (hy : Tm (Ω := Ω) Γ A y)
    (hp : Tm (Ω := Ω) Γ (Contextual.identity A x y) p) :
    Equal (Ω := Ω) (Contextual.comp (Contextual.weaken (Contextual.extend Γ A) (Contextual.pathFamily Γ A x)) (Contextual.concatMap Γ A x y p))
      (Contextual.weaken (Contextual.extend Γ A) (Contextual.pathFamily Γ A y)) :=
  hx.pathFamily.weakenPair hy.pathProjection (hx.concatGeneric hy hp)

def Tm.concatMapRoot (hx : Tm (Ω := Ω) Γ A x) (hy : Tm (Ω := Ω) Γ A y)
    (hp : Tm (Ω := Ω) Γ (Contextual.identity A x y) p) :
    Equal (Ω := Ω) (Contextual.comp (Contextual.concatMap Γ A x y p) (Contextual.root A y)) (Contextual.endpoint Γ A x y p) :=
  (hx.pathFamily.pairComp hy.pathProjection (hx.concatGeneric hy hp) hy.root).transitive
    (Equal.pair (.reflexive _) hy.rootProjection
      (Tm.transportGenericRoot hx.pathFamily hy (hp.convert (hx.pathFamilySection hy).symmetric)))

def Tm.concatMapEndpoint (hx : Tm (Ω := Ω) Γ A x) (hy : Tm (Ω := Ω) Γ A y)
    (hz : Tm (Ω := Ω) Γ A z) (hp : Tm (Ω := Ω) Γ (Contextual.identity A x y) p)
    (hq : Tm (Ω := Ω) Γ (Contextual.identity A y z) q) :
    Equal (Ω := Ω) (Contextual.comp (Contextual.concatMap Γ A x y p) (Contextual.endpoint Γ A y z q))
      (Contextual.endpoint Γ A x z (Contextual.concat Γ A x y z p q)) :=
  (hx.pathFamily.pairComp hy.pathProjection (hx.concatGeneric hy hp) (hy.endpoint hz hq)).transitive
    (Equal.pair (.reflexive _) (hy.endpointProjection hz hq) (.reflexive _))

abbrev etaLeft (Γ A B x y p u : Expression V) : Expression V :=
  transportGeneric Γ A B y (transport Γ A B x y p u)
abbrev etaRight (Γ A B x y p u : Expression V) : Expression V :=
  Contextual.subTm (transportGeneric Γ A B x u) (concatMap Γ A x y p)
abbrev etaMotive (Γ A B x y p u : Expression V) : Expression V :=
  Contextual.identity (Contextual.transportMotive Γ A B y) (etaLeft Γ A B x y p u) (etaRight Γ A B x y p u)
abbrev etaBranch (Γ A B x y p u : Expression V) : Expression V :=
  Contextual.reflexivity (Contextual.subTy B (Contextual.sectionSub Γ A y)) (transport Γ A B x y p u)
abbrev eta (Γ A B x y z p q u : Expression V) : Expression V :=
  Contextual.subTm (Contextual.basedJ A y (etaMotive Γ A B x y p u) (etaBranch Γ A B x y p u)) (Contextual.endpoint Γ A y z q)

section Eta
variable (hB : Ty (Ω := Ω) (Contextual.extend Γ A) B) (hx : Tm (Ω := Ω) Γ A x)
  (hy : Tm (Ω := Ω) Γ A y) (hp : Tm (Ω := Ω) Γ (Contextual.identity A x y) p)
  (hu : Tm (Ω := Ω) Γ (Contextual.subTy B (Contextual.sectionSub Γ A x)) u)

def Tm.etaLeft : Tm (Ω := Ω) (Contextual.path A y) (Contextual.transportMotive Γ A B y) (Contextual.etaLeft Γ A B x y p u) :=
  Tm.transportGeneric hB hy (Tm.transport hB hx hy hp hu)

def Tm.etaRight : Tm (Ω := Ω) (Contextual.path A y) (Contextual.transportMotive Γ A B y) (Contextual.etaRight Γ A B x y p u) :=
  ((Tm.transportGeneric hB hx hu).substitute (hx.concatMap hy hp)).convert
    ((hB.subComp hx.pathProjection (hx.concatMap hy hp)).transitive
      (Equal.subTy (.reflexive _) (hx.concatMapProjection hy hp)))

def Tm.etaMotive : Ty (Ω := Ω) (Contextual.path A y) (Contextual.etaMotive Γ A B x y p u) :=
  (Tm.etaLeft hB hx hy hp hu).identity (Tm.etaRight hB hx hy hp hu)

def Tm.etaLeftRoot : Equal (Ω := Ω) (Contextual.subTm (Contextual.etaLeft Γ A B x y p u) (Contextual.root A y))
    (Contextual.transport Γ A B x y p u) :=
  Tm.transportGenericRoot hB hy (Tm.transport hB hx hy hp hu)

def Tm.etaRightRoot : Equal (Ω := Ω) (Contextual.subTm (Contextual.etaRight Γ A B x y p u) (Contextual.root A y))
    (Contextual.transport Γ A B x y p u) :=
  ((Tm.transportGeneric hB hx hu).subComp (hx.concatMap hy hp) hy.root).transitive
    (Equal.subTm (.reflexive _) (hx.concatMapRoot hy hp))

def Tm.etaMotiveRoot : Equal (Ω := Ω) (Contextual.subTy (Contextual.etaMotive Γ A B x y p u) (Contextual.root A y))
    (Contextual.identity (Contextual.subTy B (Contextual.sectionSub Γ A y)) (Contextual.transport Γ A B x y p u) (Contextual.transport Γ A B x y p u)) :=
  ((Tm.etaLeft hB hx hy hp hu).identitySub (Tm.etaRight hB hx hy hp hu) hy.root).transitive
    (Equal.identity (hB.transportRoot hy) (Tm.etaLeftRoot hB hx hy hp hu) (Tm.etaRightRoot hB hx hy hp hu))

def Tm.etaBranch : Tm (Ω := Ω) Γ (Contextual.subTy (Contextual.etaMotive Γ A B x y p u) (Contextual.root A y))
    (Contextual.etaBranch Γ A B x y p u) :=
  (Tm.transport hB hx hy hp hu).reflexivity.convert (Tm.etaMotiveRoot hB hx hy hp hu).symmetric

variable (hz : Tm (Ω := Ω) Γ A z) (hq : Tm (Ω := Ω) Γ (Contextual.identity A y z) q)

def Tm.etaMotiveEndpoint : Equal (Ω := Ω) (Contextual.subTy (Contextual.etaMotive Γ A B x y p u) (Contextual.endpoint Γ A y z q))
    (Contextual.identity (Contextual.subTy B (Contextual.sectionSub Γ A z))
      (Contextual.transport Γ A B y z q (Contextual.transport Γ A B x y p u))
      (Contextual.transport Γ A B x z (Contextual.concat Γ A x y z p q) u)) :=
  ((Tm.etaLeft hB hx hy hp hu).identitySub (Tm.etaRight hB hx hy hp hu) (hy.endpoint hz hq)).transitive
    (Equal.identity (hB.transportEndpoint hy hz hq) (.reflexive _)
      (((Tm.transportGeneric hB hx hu).subComp (hx.concatMap hy hp) (hy.endpoint hz hq)).transitive
        (Equal.subTm (.reflexive _) (hx.concatMapEndpoint hy hz hp hq))))

def Tm.eta : Tm (Ω := Ω) Γ
    (Contextual.identity (Contextual.subTy B (Contextual.sectionSub Γ A z))
      (Contextual.transport Γ A B y z q (Contextual.transport Γ A B x y p u))
      (Contextual.transport Γ A B x z (Contextual.concat Γ A x y z p q) u))
    (Contextual.eta Γ A B x y z p q u) :=
  ((hy.basedJ (Tm.etaMotive hB hx hy hp hu) (Tm.etaBranch hB hx hy hp hu)).substitute (hy.endpoint hz hq)).convert
    (Tm.etaMotiveEndpoint hB hx hy hp hu hz hq)

end Eta

abbrev apdMotive (Γ A B x t : Expression V) : Expression V :=
  Contextual.identity (Contextual.transportMotive Γ A B x) (transportGeneric Γ A B x (Contextual.subTm t (Contextual.sectionSub Γ A x)))
    (Contextual.subTm t (Contextual.weaken (Contextual.extend Γ A) (Contextual.pathFamily Γ A x)))
abbrev apdBranch (Γ A B x t : Expression V) : Expression V :=
  Contextual.reflexivity (Contextual.subTy B (Contextual.sectionSub Γ A x)) (Contextual.subTm t (Contextual.sectionSub Γ A x))
abbrev apd (Γ A B x y p t : Expression V) : Expression V :=
  Contextual.subTm (Contextual.basedJ A x (apdMotive Γ A B x t) (apdBranch Γ A B x t)) (Contextual.endpoint Γ A x y p)

section Apd
variable (ht : Tm (Ω := Ω) (Contextual.extend Γ A) B t) (hx : Tm (Ω := Ω) Γ A x)

def Tm.apdMotive : Ty (Ω := Ω) (Contextual.path A x) (Contextual.apdMotive Γ A B x t) :=
  (Tm.transportGeneric ht.family hx (ht.substitute hx.section)).identity (ht.substitute hx.pathProjection)

def Tm.apdMotiveRoot : Equal (Ω := Ω) (Contextual.subTy (Contextual.apdMotive Γ A B x t) (Contextual.root A x))
    (Contextual.identity (Contextual.subTy B (Contextual.sectionSub Γ A x)) (Contextual.subTm t (Contextual.sectionSub Γ A x)) (Contextual.subTm t (Contextual.sectionSub Γ A x))) :=
  ((Tm.transportGeneric ht.family hx (ht.substitute hx.section)).identitySub (ht.substitute hx.pathProjection) hx.root).transitive
    (Equal.identity (ht.family.transportRoot hx)
      (Tm.transportGenericRoot ht.family hx (ht.substitute hx.section))
      ((ht.subComp hx.pathProjection hx.root).transitive (Equal.subTm (.reflexive _) hx.rootProjection)))

def Tm.apdBranch : Tm (Ω := Ω) Γ (Contextual.subTy (Contextual.apdMotive Γ A B x t) (Contextual.root A x))
    (Contextual.apdBranch Γ A B x t) :=
  (ht.substitute hx.section).reflexivity.convert (Tm.apdMotiveRoot ht hx).symmetric

variable (hy : Tm (Ω := Ω) Γ A y) (hp : Tm (Ω := Ω) Γ (Contextual.identity A x y) p)

def Tm.apdMotiveEndpoint : Equal (Ω := Ω) (Contextual.subTy (Contextual.apdMotive Γ A B x t) (Contextual.endpoint Γ A x y p))
    (Contextual.identity (Contextual.subTy B (Contextual.sectionSub Γ A y))
      (Contextual.transport Γ A B x y p (Contextual.subTm t (Contextual.sectionSub Γ A x))) (Contextual.subTm t (Contextual.sectionSub Γ A y))) :=
  ((Tm.transportGeneric ht.family hx (ht.substitute hx.section)).identitySub (ht.substitute hx.pathProjection) (hx.endpoint hy hp)).transitive
    (Equal.identity (ht.family.transportEndpoint hx hy hp) (.reflexive _)
      ((ht.subComp hx.pathProjection (hx.endpoint hy hp)).transitive
        (Equal.subTm (.reflexive _) (hx.endpointProjection hy hp))))

def Tm.apd : Tm (Ω := Ω) Γ
    (Contextual.identity (Contextual.subTy B (Contextual.sectionSub Γ A y))
      (Contextual.transport Γ A B x y p (Contextual.subTm t (Contextual.sectionSub Γ A x))) (Contextual.subTm t (Contextual.sectionSub Γ A y)))
    (Contextual.apd Γ A B x y p t) :=
  ((hx.basedJ (Tm.apdMotive ht hx) (Tm.apdBranch ht hx)).substitute (hx.endpoint hy hp)).convert
    (Tm.apdMotiveEndpoint ht hx hy hp)

end Apd
end SquareKit.Internal.DependentJudgments.Contextual
