import SquareKit.Internal.DependentJudgments.TypedMaps

/-! Empty substitutions are constructed for contexts generated by extension.
No terminality or uniqueness principle for arbitrary contexts is assumed. -/
namespace SquareKit.Internal.DependentJudgments.Contextual
open GuardedTheory
variable {V : Type} {Ω : List (Judgment V)}

inductive GeneratedContext (Ω : List (Judgment V)) : Expression V → Type where
  | empty : GeneratedContext Ω Contextual.empty
  | extend (context : GeneratedContext Ω Γ) (family : Ty (Ω := Ω) Γ A) :
      GeneratedContext Ω (Contextual.extend Γ A)

namespace GeneratedContext

def typing {Γ : Expression V} : GeneratedContext Ω Γ → Ctx (Ω := Ω) Γ
  | .empty => Ctx.empty
  | .extend _ hA => hA.extend

def emptySubstitution {Γ : Expression V} : GeneratedContext Ω Γ → Expression V
  | .empty => identitySub Contextual.empty
  | @GeneratedContext.extend _ _ Γ A hΓ _ => Contextual.comp hΓ.emptySubstitution (Contextual.weaken Γ A)

def emptySubstitution_typed {Γ : Expression V} (hΓ : GeneratedContext Ω Γ) :
    Sub (Ω := Ω) Γ Contextual.empty hΓ.emptySubstitution :=
  match hΓ with
  | .empty => Ctx.empty.identity
  | .extend hΓ hA => hΓ.emptySubstitution_typed.comp hA.weaken

/-- The constructed empty map inherits model-map preservation, just like any
other generated substitution. Its existence does not assert uniqueness. -/
theorem emptySubstitution_map {Γ : Expression V} (hΓ : GeneratedContext Ω Γ)
    {M : PathTransport.Typed.Model.{u}} {N : PathTransport.Typed.Model.{v}}
    (F : PathTransport.Typed.ModelMap M N) (ρ : V → Value M.toStructuralModel)
    (hΩ : ∀ p ∈ Ω, p.eval (algebra M) ρ) :
    Value.map F.toStructuralMap (hΓ.emptySubstitution.eval (algebra M) ρ) =
      hΓ.emptySubstitution.eval (algebra N) (Value.map F.toStructuralMap ∘ ρ) :=
  interpret_map F hΓ.emptySubstitution ρ ((Defined.substitution hΓ.emptySubstitution_typed).sound M ρ hΩ)

/-- The second extension may depend on the first generic variable. -/
def twoExtensions {A B : Expression V}
    (hA : Ty (Ω := Ω) Contextual.empty A)
    (hB : Ty (Ω := Ω) (Contextual.extend Contextual.empty A) B) :
    GeneratedContext Ω (Contextual.extend (Contextual.extend Contextual.empty A) B) :=
  (GeneratedContext.empty.extend hA).extend hB

theorem twoExtensions_expression {A B : Expression V}
    (hA : Ty (Ω := Ω) Contextual.empty A)
    (hB : Ty (Ω := Ω) (Contextual.extend Contextual.empty A) B) :
    (twoExtensions hA hB).emptySubstitution =
      Contextual.comp
        (Contextual.comp (identitySub Contextual.empty) (Contextual.weaken Contextual.empty A))
        (Contextual.weaken (Contextual.extend Contextual.empty A) B) := rfl

end GeneratedContext
end SquareKit.Internal.DependentJudgments.Contextual
