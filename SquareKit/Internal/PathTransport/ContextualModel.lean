import SquareKit.Internal.PathTransport.Model

/-! Finite dependent telescopes and the contextual J model interface.
The structural maps and their commuting squares are constructed from the
comprehension laws before J computation and substitution are specified. -/

namespace SquareKit.Internal.PathTransport.Typed.StructuralModel
universe u
variable (M : StructuralModel.{u})

def sectionSub {Γ : M.Context} (A : M.Family Γ) (x : M.Section Γ A) :
    M.Substitution Γ (M.extend Γ A) :=
  M.pairSub A (M.idSub Γ) (cast (congrArg (M.Section Γ) (M.subTy_id A).symm) x)

def lift {Γ Δ : M.Context} (A : M.Family Γ) (σ : M.Substitution Δ Γ) :
    M.Substitution (M.extend Δ (M.subTy A σ)) (M.extend Γ A) :=
  M.pairSub A (M.compSub σ (M.weaken Δ (M.subTy A σ)))
    (cast (congrArg (M.Section _) (M.subTy_comp A σ (M.weaken Δ (M.subTy A σ))))
      (M.genericVariable Δ (M.subTy A σ)))

def pathFamily {Γ : M.Context} (A : M.Family Γ) (x : M.Section Γ A) :
    M.Family (M.extend Γ A) :=
  M.identity (M.subTy A (M.weaken Γ A)) (M.subTm x (M.weaken Γ A))
    (M.genericVariable Γ A)

def pathContext {Γ : M.Context} (A : M.Family Γ) (x : M.Section Γ A) : M.Context :=
  M.extend (M.extend Γ A) (M.pathFamily A x)

theorem weaken_section {Γ : M.Context} (A : M.Family Γ) (x : M.Section Γ A) :
    M.compSub (M.weaken Γ A) (M.sectionSub A x) = M.idSub Γ :=
  M.weaken_pair _ _ _

theorem weaken_section_type {Γ : M.Context} (A : M.Family Γ) (x : M.Section Γ A)
    (B : M.Family Γ) :
    M.subTy (M.subTy B (M.weaken Γ A)) (M.sectionSub A x) = B := by
  rw [M.subTy_comp, M.weaken_section, M.subTy_id]

theorem weaken_section_term {Γ : M.Context} (A : M.Family Γ) (x : M.Section Γ A)
    {B : M.Family Γ} (t : M.Section Γ B) :
    HEq (M.subTm (M.subTm t (M.weaken Γ A)) (M.sectionSub A x)) t := by
  apply (M.subTm_comp t (M.weaken Γ A) (M.sectionSub A x)).trans
  rw [M.weaken_section]
  exact M.subTm_id t

theorem variable_section {Γ : M.Context} (A : M.Family Γ) (x : M.Section Γ A) :
    HEq (M.subTm (M.genericVariable Γ A) (M.sectionSub A x)) x :=
  (M.variable_pair _ _ _).trans (cast_heq _ _)

theorem identity_congr {Γ : M.Context} {A B : M.Family Γ}
    {x y : M.Section Γ A} {x' y' : M.Section Γ B}
    (hA : A = B) (hx : HEq x x') (hy : HEq y y') :
    M.identity A x y = M.identity B x' y' := by
  cases hA
  cases eq_of_heq hx
  cases eq_of_heq hy
  rfl

theorem pathFamily_root {Γ : M.Context} (A : M.Family Γ) (x : M.Section Γ A) :
    M.subTy (M.pathFamily A x) (M.sectionSub A x) = M.identity A x x := by
  unfold pathFamily
  rw [M.identity_sub]
  exact M.identity_congr (M.weaken_section_type A x A)
    (M.weaken_section_term A x x) (M.variable_section A x)

def rootSub {Γ : M.Context} (A : M.Family Γ) (x : M.Section Γ A) :
    M.Substitution Γ (M.pathContext A x) :=
  M.pairSub (M.pathFamily A x) (M.sectionSub A x)
    (cast (congrArg (M.Section Γ) (M.pathFamily_root A x).symm) (M.reflexivity A x))

/-- A telescope is an ordered sequence of dependent extensions, with no
source function type. This semantic data is generated by typed syntax. -/
inductive Telescope (M : StructuralModel.{u}) : M.Context → Nat → Type u where
  | nil : Telescope M Γ 0
  | cons : (A : M.Family Γ) → Telescope M (M.extend Γ A) n → Telescope M Γ (n + 1)

def Telescope.total {Γ n} : Telescope M Γ n → M.Context
  | .nil => Γ
  | .cons _ tail => tail.total

def Telescope.projection {Γ n} : (T : Telescope M Γ n) → M.Substitution T.total Γ
  | .nil => M.idSub Γ
  | .cons A tail => M.compSub (M.weaken Γ A) (tail.projection)

/-- Reindexing and the induced map into the old total context are built together. -/
def Telescope.reindex {Γ Δ n} (σ : M.Substitution Δ Γ) (T : Telescope M Γ n) :
    (T' : Telescope M Δ n) × M.Substitution T'.total T.total :=
  match T with
  | .nil => ⟨.nil, σ⟩
  | .cons A tail =>
    let r := tail.reindex (M.lift A σ)
    ⟨.cons (M.subTy A σ) r.1, r.2⟩

def Telescope.pullback {Γ Δ n} (T : Telescope M Γ n) (σ : M.Substitution Δ Γ) :
    Telescope M Δ n := (Telescope.reindex M σ T).1

def Telescope.liftSub {Γ Δ n} (T : Telescope M Γ n) (σ : M.Substitution Δ Γ) :
    M.Substitution (Telescope.pullback M T σ).total T.total := (Telescope.reindex M σ T).2

/-- The full reflexive inclusion, including every generalized parameter. -/
def rootTail {Γ n} (A : M.Family Γ) (x : M.Section Γ A)
    (T : Telescope M (M.pathContext A x) n) :
    M.Substitution (Telescope.pullback M T (M.rootSub A x)).total T.total :=
  Telescope.liftSub M T (M.rootSub A x)

end SquareKit.Internal.PathTransport.Typed.StructuralModel

namespace SquareKit.Internal.PathTransport.Typed.StructuralModel
set_option backward.isDefEq.respectTransparency false
universe u
variable (M : StructuralModel.{u})

theorem pair_ext {Γ Δ} (A : M.Family Γ)
    (σ τ : M.Substitution Δ (M.extend Γ A))
    (h : M.compSub (M.weaken Γ A) σ = M.compSub (M.weaken Γ A) τ)
    (ht : HEq (M.subTm (M.genericVariable Γ A) σ)
      (M.subTm (M.genericVariable Γ A) τ)) : σ = τ := by
  rw [← M.pair_eta A σ, ← M.pair_eta A τ]
  congr 1
  exact (cast_heq _ _).trans (ht.trans (cast_heq _ _).symm)

theorem weaken_lift {Γ Δ} (A : M.Family Γ) (σ : M.Substitution Δ Γ) :
    M.compSub (M.weaken Γ A) (M.lift A σ) =
      M.compSub σ (M.weaken Δ (M.subTy A σ)) := M.weaken_pair _ _ _

theorem variable_lift {Γ Δ} (A : M.Family Γ) (σ : M.Substitution Δ Γ) :
    HEq (M.subTm (M.genericVariable Γ A) (M.lift A σ))
      (M.genericVariable Δ (M.subTy A σ)) :=
  (M.variable_pair _ _ _).trans (cast_heq _ _)

theorem pathFamily_sub {Γ Δ} (A : M.Family Γ) (x : M.Section Γ A)
    (σ : M.Substitution Δ Γ) :
    M.subTy (M.pathFamily A x) (M.lift A σ) =
      M.pathFamily (M.subTy A σ) (M.subTm x σ) := by
  unfold pathFamily
  rw [M.identity_sub]
  apply M.identity_congr
  · rw [M.subTy_comp, M.weaken_lift, M.subTy_comp]
  · exact (M.subTm_comp x _ _).trans (by
      rw [M.weaken_lift]
      exact (M.subTm_comp x _ _).symm)
  · exact M.variable_lift A σ

theorem pathSub_type {Γ Δ} (A : M.Family Γ) (x : M.Section Γ A)
    (σ : M.Substitution Δ Γ) :
    M.subTy (M.pathFamily A x)
      (M.compSub (M.lift A σ)
        (M.weaken _ (M.pathFamily (M.subTy A σ) (M.subTm x σ)))) =
    M.subTy (M.pathFamily (M.subTy A σ) (M.subTm x σ))
      (M.weaken _ (M.pathFamily (M.subTy A σ) (M.subTm x σ))) := by
  rw [← M.subTy_comp, M.pathFamily_sub]

def pathSub {Γ Δ} (A : M.Family Γ) (x : M.Section Γ A)
    (σ : M.Substitution Δ Γ) :
    M.Substitution (M.pathContext (M.subTy A σ) (M.subTm x σ)) (M.pathContext A x) :=
  M.pairSub (M.pathFamily A x)
    (M.compSub (M.lift A σ) (M.weaken _ (M.pathFamily (M.subTy A σ) (M.subTm x σ))))
    (cast (congrArg (M.Section _) (M.pathSub_type A x σ).symm)
      (M.genericVariable _ (M.pathFamily (M.subTy A σ) (M.subTm x σ))))

theorem weaken_pathSub {Γ Δ} (A : M.Family Γ) (x : M.Section Γ A)
    (σ : M.Substitution Δ Γ) :
    M.compSub (M.weaken _ (M.pathFamily A x)) (M.pathSub A x σ) =
      M.compSub (M.lift A σ) (M.weaken _ (M.pathFamily (M.subTy A σ) (M.subTm x σ))) :=
  M.weaken_pair _ _ _

theorem variable_pathSub {Γ Δ} (A : M.Family Γ) (x : M.Section Γ A)
    (σ : M.Substitution Δ Γ) :
    HEq (M.subTm (M.genericVariable _ (M.pathFamily A x)) (M.pathSub A x σ))
      (M.genericVariable _ (M.pathFamily (M.subTy A σ) (M.subTm x σ))) :=
  (M.variable_pair _ _ _).trans (cast_heq _ _)
theorem subTm_congr {Γ Δ} {A B : M.Family Γ}
    {t : M.Section Γ A} {s : M.Section Γ B} (hA : A = B) (ht : HEq t s)
    (σ : M.Substitution Δ Γ) : HEq (M.subTm t σ) (M.subTm s σ) := by
  cases hA
  cases eq_of_heq ht
  rfl

theorem weaken_lift_type {Γ Δ} (A : M.Family Γ) (σ : M.Substitution Δ Γ) :
    M.subTy (M.subTy A (M.weaken Γ A)) (M.lift A σ) =
      M.subTy (M.subTy A σ) (M.weaken Δ (M.subTy A σ)) := by
  rw [M.subTy_comp, M.weaken_lift, M.subTy_comp]

theorem section_lift {Γ Δ} (A : M.Family Γ) (x : M.Section Γ A)
    (σ : M.Substitution Δ Γ) :
    M.compSub (M.lift A σ) (M.sectionSub (M.subTy A σ) (M.subTm x σ)) =
      M.compSub (M.sectionSub A x) σ := by
  apply M.pair_ext A
  · rw [← M.comp_assoc, M.weaken_lift, M.comp_assoc, M.weaken_section,
      M.comp_id_right, ← M.comp_assoc, M.weaken_section, M.comp_id_left]
  · apply (M.subTm_comp _ _ _).symm.trans
    apply (M.subTm_congr (M.weaken_lift_type A σ) (M.variable_lift A σ) _).trans
    apply (M.variable_section (M.subTy A σ) (M.subTm x σ)).trans
    apply HEq.trans _ (M.subTm_comp _ _ _)
    exact (M.subTm_congr (M.weaken_section_type A x A) (M.variable_section A x) σ).symm

theorem weaken_root {Γ} (A : M.Family Γ) (x : M.Section Γ A) :
    M.compSub (M.weaken _ (M.pathFamily A x)) (M.rootSub A x) = M.sectionSub A x :=
  M.weaken_pair _ _ _

theorem variable_root {Γ} (A : M.Family Γ) (x : M.Section Γ A) :
    HEq (M.subTm (M.genericVariable _ (M.pathFamily A x)) (M.rootSub A x))
      (M.reflexivity A x) := (M.variable_pair _ _ _).trans (cast_heq _ _)
theorem variable_pathSub_type {Γ Δ} (A : M.Family Γ) (x : M.Section Γ A)
    (σ : M.Substitution Δ Γ) :
    M.subTy (M.subTy (M.pathFamily A x) (M.weaken _ (M.pathFamily A x)))
      (M.pathSub A x σ) =
    M.subTy (M.pathFamily (M.subTy A σ) (M.subTm x σ))
      (M.weaken _ (M.pathFamily (M.subTy A σ) (M.subTm x σ))) := by
  rw [M.subTy_comp, M.weaken_pathSub, M.pathSub_type]

theorem variable_root_type {Γ} (A : M.Family Γ) (x : M.Section Γ A) :
    M.subTy (M.subTy (M.pathFamily A x) (M.weaken _ (M.pathFamily A x)))
      (M.rootSub A x) = M.identity A x x := by
  rw [M.subTy_comp, M.weaken_root, M.pathFamily_root]

theorem pathSub_root {Γ Δ} (A : M.Family Γ) (x : M.Section Γ A)
    (σ : M.Substitution Δ Γ) :
    M.compSub (M.pathSub A x σ) (M.rootSub (M.subTy A σ) (M.subTm x σ)) =
      M.compSub (M.rootSub A x) σ := by
  apply M.pair_ext (M.pathFamily A x)
  · rw [← M.comp_assoc, M.weaken_pathSub, M.comp_assoc, M.weaken_root,
      M.section_lift, ← M.comp_assoc, M.weaken_root]
  · apply (M.subTm_comp _ _ _).symm.trans
    apply (M.subTm_congr (M.variable_pathSub_type A x σ) (M.variable_pathSub A x σ) _).trans
    apply (M.variable_root (M.subTy A σ) (M.subTm x σ)).trans
    apply (M.refl_sub A x σ).symm.trans
    apply HEq.trans _ (M.subTm_comp _ _ _)
    exact (M.subTm_congr (M.variable_root_type A x) (M.variable_root A x) σ).symm
end SquareKit.Internal.PathTransport.Typed.StructuralModel

namespace SquareKit.Internal.PathTransport.Typed.StructuralModel
set_option backward.isDefEq.respectTransparency false
universe u
variable (M : StructuralModel.{u})
variable {Γ Γ' Δ Δ' : M.Context}
variable (F : M.Substitution Δ Γ) (F' : M.Substitution Δ' Γ')
variable (K : M.Substitution Γ' Γ) (L : M.Substitution Δ' Δ)
variable (h : M.compSub K F' = M.compSub F L) (A : M.Family Γ)
include h

theorem square_type : M.subTy (M.subTy A K) F' = M.subTy (M.subTy A F) L := by
  rw [M.subTy_comp, M.subTy_comp, h]

theorem square_variable_type :
    M.subTy (M.subTy A F) (M.compSub L (M.weaken _ (M.subTy (M.subTy A K) F'))) =
    M.subTy (M.subTy (M.subTy A K) F') (M.weaken _ (M.subTy (M.subTy A K) F')) := by
  rw [← M.subTy_comp, ← M.square_type F F' K L h A]

def squareLift :
    M.Substitution (M.extend Δ' (M.subTy (M.subTy A K) F')) (M.extend Δ (M.subTy A F)) :=
  M.pairSub (M.subTy A F)
    (M.compSub L (M.weaken _ (M.subTy (M.subTy A K) F')))
    (cast (congrArg (M.Section _) (M.square_variable_type F F' K L h A).symm)
      (M.genericVariable _ (M.subTy (M.subTy A K) F')))

theorem weaken_squareLift :
    M.compSub (M.weaken _ (M.subTy A F)) (M.squareLift F F' K L h A) =
    M.compSub L (M.weaken _ (M.subTy (M.subTy A K) F')) := M.weaken_pair _ _ _

theorem variable_squareLift :
    HEq (M.subTm (M.genericVariable _ (M.subTy A F)) (M.squareLift F F' K L h A))
      (M.genericVariable _ (M.subTy (M.subTy A K) F')) :=
  (M.variable_pair _ _ _).trans (cast_heq _ _)

theorem squareLift_forward :
    M.compSub (M.lift A K) (M.lift (M.subTy A K) F') =
    M.compSub (M.lift A F) (M.squareLift F F' K L h A) := by
  apply M.pair_ext A
  · rw [← M.comp_assoc, M.weaken_lift, M.comp_assoc, M.weaken_lift,
      ← M.comp_assoc, h, M.comp_assoc, ← M.weaken_squareLift F F' K L h A,
      ← M.comp_assoc, ← M.weaken_lift, M.comp_assoc]
  · apply (M.subTm_comp _ _ _).symm.trans
    apply (M.subTm_congr (M.weaken_lift_type A K) (M.variable_lift A K) _).trans
    apply (M.variable_lift (M.subTy A K) F').trans
    apply (M.variable_squareLift F F' K L h A).symm.trans
    apply HEq.trans _ (M.subTm_comp _ _ _)
    exact (M.subTm_congr (M.weaken_lift_type A F) (M.variable_lift A F) _).symm
def Telescope.square (M : StructuralModel.{u}) {Γ Γ' Δ Δ' : M.Context}
    (F : M.Substitution Δ Γ) (F' : M.Substitution Δ' Γ')
    (K : M.Substitution Γ' Γ) (L : M.Substitution Δ' Δ)
    (h : M.compSub K F' = M.compSub F L) {n} (T : Telescope M Γ n) :
    { b : M.Substitution (Telescope.total M (Telescope.pullback M (Telescope.pullback M T K) F')) (Telescope.total M (Telescope.pullback M T F)) //
      M.compSub (Telescope.liftSub M T K) (Telescope.liftSub M (Telescope.pullback M T K) F') = M.compSub (Telescope.liftSub M T F) b } :=
  match T with
  | .nil => ⟨L, h⟩
  | .cons A tail => Telescope.square M
      (M.lift A F) (M.lift (M.subTy A K) F')
      (M.lift A K) (M.squareLift F F' K L h A)
      (M.squareLift_forward F F' K L h A) tail
termination_by sizeOf T

end SquareKit.Internal.PathTransport.Typed.StructuralModel

namespace SquareKit.Internal.PathTransport.Typed.StructuralModel
set_option backward.isDefEq.respectTransparency false
universe u
variable (M : StructuralModel.{u})
variable {Γ Δ : M.Context} {n : Nat}
variable (A : M.Family Γ) (x : M.Section Γ A)
variable (T : Telescope M (M.pathContext A x) n) (σ : M.Substitution Δ Γ)

def pathTail := Telescope.pullback M T (M.pathSub A x σ)
def pathTailMap := Telescope.liftSub M T (M.pathSub A x σ)

def branchMap := (Telescope.square M (M.rootSub A x)
  (M.rootSub (M.subTy A σ) (M.subTm x σ)) (M.pathSub A x σ) σ
  (M.pathSub_root A x σ) T).val

theorem branchMap_square :
    M.compSub (M.pathTailMap A x T σ)
      (M.rootTail (M.subTy A σ) (M.subTm x σ) (M.pathTail A x T σ)) =
    M.compSub (M.rootTail A x T) (M.branchMap A x T σ) :=
  (Telescope.square M (M.rootSub A x)
    (M.rootSub (M.subTy A σ) (M.subTm x σ)) (M.pathSub A x σ) σ
    (M.pathSub_root A x σ) T).property

variable (D : M.Family (Telescope.total M T))

theorem branchMap_type :
    M.subTy (M.subTy D (M.pathTailMap A x T σ))
      (M.rootTail (M.subTy A σ) (M.subTm x σ) (M.pathTail A x T σ)) =
    M.subTy (M.subTy D (M.rootTail A x T)) (M.branchMap A x T σ) := by
  rw [M.subTy_comp, M.subTy_comp, M.branchMap_square]

def reindexBranch
    (d : M.Section (Telescope.total M (Telescope.pullback M T (M.rootSub A x)))
      (M.subTy D (M.rootTail A x T))) :
    M.Section (Telescope.total M
      (Telescope.pullback M (M.pathTail A x T σ) (M.rootSub (M.subTy A σ) (M.subTm x σ))))
      (M.subTy (M.subTy D (M.pathTailMap A x T σ))
        (M.rootTail (M.subTy A σ) (M.subTm x σ) (M.pathTail A x T σ))) :=
  cast (congrArg (M.Section _) (M.branchMap_type A x T σ D).symm)
    (M.subTm d (M.branchMap A x T σ))
end SquareKit.Internal.PathTransport.Typed.StructuralModel

namespace SquareKit.Internal.PathTransport.Typed
universe u

/-- Full supported models extend the structural algebra by contextual J. -/
structure Model extends StructuralModel.{u} where
  j : {Γ : Context} → {n : Nat} → (A : Family Γ) → (x : Section Γ A) →
    (T : StructuralModel.Telescope toStructuralModel (toStructuralModel.pathContext A x) n) →
    (C : Family (StructuralModel.Telescope.total toStructuralModel T)) →
    (d : Section
      (StructuralModel.Telescope.total toStructuralModel
        (StructuralModel.Telescope.pullback toStructuralModel T (toStructuralModel.rootSub A x)))
      (subTy C (toStructuralModel.rootTail A x T))) →
    Section (StructuralModel.Telescope.total toStructuralModel T) C
  j_beta : ∀ {Γ n} (A : Family Γ) (x : Section Γ A)
    (T : StructuralModel.Telescope toStructuralModel (toStructuralModel.pathContext A x) n)
    (C : Family (StructuralModel.Telescope.total toStructuralModel T))
    (d : Section
      (StructuralModel.Telescope.total toStructuralModel
        (StructuralModel.Telescope.pullback toStructuralModel T (toStructuralModel.rootSub A x)))
      (subTy C (toStructuralModel.rootTail A x T))),
    HEq (subTm (j A x T C d) (toStructuralModel.rootTail A x T)) d

  j_sub : ∀ {Γ Δ n} (A : Family Γ) (x : Section Γ A)
    (T : StructuralModel.Telescope toStructuralModel (toStructuralModel.pathContext A x) n)
    (D : Family (StructuralModel.Telescope.total toStructuralModel T))
    (d : Section
      (StructuralModel.Telescope.total toStructuralModel
        (StructuralModel.Telescope.pullback toStructuralModel T (toStructuralModel.rootSub A x)))
      (subTy D (toStructuralModel.rootTail A x T)))
    (σ : Substitution Δ Γ),
    HEq (subTm (j A x T D d) (toStructuralModel.pathTailMap A x T σ))
      (j (subTy A σ) (subTm x σ) (toStructuralModel.pathTail A x T σ)
        (subTy D (toStructuralModel.pathTailMap A x T σ))
        (toStructuralModel.reindexBranch A x T σ D d))

end SquareKit.Internal.PathTransport.Typed
