import SquareKit.SmoothPresentationCategory
import Mathlib.CategoryTheory.Sites.Coverage

/-! Experimental Grothendieck topology generated by finite ordinary-unit-ideal
principal covers. Stability is proved for every smooth arrow of the small site. -/
noncomputable section
namespace SquareKit.SmoothPresentationSite
open CategoryTheory Opposite SmoothAlgebra PresentedLocalization PrincipalCover

abbrev Site := Codeᵒᵖ

def principalPresieve (A : Code) {k : ℕ} (s : Fin k → Carrier A) : Presieve (op A) :=
  Presieve.ofArrows (fun i => op (localization A (s i))) (fun i => (localizationBase A (s i)).op)

def principalSieve (A : Code) {k : ℕ} (s : Fin k → Carrier A) : Sieve (op A) :=
  Sieve.generate (principalPresieve A s)

/-- The pulled-back family is the localization at the image elements, for any smooth map. -/
theorem principal_refinement {A B : Code} (h : A ⟶ B) {k : ℕ} (s : Fin k → Carrier A) :
    (principalPresieve B (fun i => (smoothMap h).toFun (s i))).FactorsThruAlong (principalPresieve A s) h.op := by
  rintro Z g ⟨i⟩
  refine ⟨op (localization A (s i)),(localizationMap h (s i)).op,(localizationBase A (s i)).op,⟨i⟩,?_⟩
  exact congrArg Quiver.Hom.op (localization_square h (s i))

def coverage : Coverage Site where
  coverings X := {R | ∃ k, ∃ s : Fin k → Carrier X.unop, Covers s ∧ R=principalPresieve X.unop s}
  pullback := by
    intro X Y f R hR
    obtain ⟨k,s,hs,rfl⟩ := hR
    refine ⟨principalPresieve Y.unop (fun i => (smoothMap f.unop).toFun (s i)),⟨k,_,map_covers (smoothMap f.unop) s hs,rfl⟩,?_⟩
    exact principal_refinement f.unop s

/-- This is the topology generated by the proved coverage, not the canonical topology by fiat. -/
def topology : GrothendieckTopology Site := coverage.toGrothendieck

theorem principal_covering (A : Code) {k : ℕ} (s : Fin k → Carrier A) (hs : Covers s) :
    principalSieve A s ∈ topology (op A) :=
  coverage.mem_toGrothendieck_sieves_of_superset (Sieve.le_generate _) ⟨k,s,hs,rfl⟩

/-- Exact generation criterion: sheafness on all finite principal cover families
is equivalent to sheafness for the resulting Grothendieck topology. -/
theorem isSheaf_iff_principal (P : Siteᵒᵖ ⥤ Type) : Presieve.IsSheaf topology P ↔
    ∀ (A : Code) (k : ℕ) (s : Fin k → Carrier A), Covers s → Presieve.IsSheafFor P (principalPresieve A s) := by
  rw [topology,Presieve.isSheaf_coverage]
  constructor
  · intro h A k s hs
    exact h _ ⟨k,s,hs,rfl⟩
  · rintro h X R ⟨k,s,hs,rfl⟩
    exact h X.unop k s hs

end SquareKit.SmoothPresentationSite
