import SquareKit.SheafFamilyCover
import Mathlib.CategoryTheory.Sites.Coverage
import Mathlib.CategoryTheory.Sites.Over

/-! The topology generated by independent joint local lifting of sheaf families. -/
noncomputable section
set_option autoImplicit false
set_option warningAsError true
set_option backward.isDefEq.respectTransparency false
namespace SquareKit.SheafFamilyCover
open CategoryTheory Opposite
universe u v
variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
variable {I : Type (max u v)} {X : Sheaf J (Type (max u v))}
variable {Y : I → Sheaf J (Type (max u v))} {f : ∀ i, Y i ⟶ X}

/-- Composite covering families still lift sections locally through one member. -/
theorem composition (hf : JointlyLocallySurjective f)
    {K : I → Type (max u v)} {Z : ∀ i, K i → Sheaf J (Type (max u v))}
    (g : ∀ i k, Z i k ⟶ Y i) (hg : ∀ i, JointlyLocallySurjective (g i)) :
    JointlyLocallySurjective (fun p : Σ i, K i => g p.1 p.2 ≫ f p.1) := by
  intro U x
  apply J.transitive (hf x)
  rintro V k ⟨i,y,hy⟩
  apply J.superset_covering _ (hg i y)
  rintro W l ⟨j,z,hz⟩
  refine ⟨⟨i,j⟩, z, ?_⟩
  change (f i).hom.app _ ((g i j).hom.app _ z) = _
  rw [hz, NatTrans.naturality_apply, hy, op_comp, X.obj.map_comp]
  rfl

/-- A covering sieve contains a jointly locally-surjective family, not necessarily
its aggregate map. -/
def topology : GrothendieckTopology (Sheaf J (Type (max u v))) where
  sieves X := {R | ∃ (I : Type (max u v)) (Y : I → Sheaf J (Type (max u v)))
    (f : ∀ i, Y i ⟶ X), JointlyLocallySurjective f ∧ ∀ i, R (f i)}
  top_mem' X := ⟨PUnit, fun _ => X, fun _ => 𝟙 X,
    (singleton_iff _).mpr inferInstance, fun _ => trivial⟩
  pullback_stable' {_ _ R} g := by
    rintro ⟨I,Y,f,hf,hR⟩
    refine ⟨I, fun i => SplitSheaf.extension (pullbackFamily f g i), pullbackMaps f g,
      jointlyLocallySurjective_pullbackMaps f hf g, ?_⟩
    intro i
    change R (pullbackMaps f g i ≫ g)
    rw [← (pullback_square f g i).w]
    exact R.downward_closed (hR i) _
  transitive' := by
    rintro X S ⟨I,Y,f,hf,hS⟩ R hR
    have hs := fun i => hR (hS i)
    choose K Z g hg h using hs
    refine ⟨Σ i, K i, fun p => Z p.1 p.2, fun p => g p.1 p.2 ≫ f p.1,
      composition hf g hg, ?_⟩
    rintro ⟨i,k⟩
    exact h i k

lemma covering {I : Type (max u v)} {Y : I → Sheaf J (Type (max u v))}
    {f : ∀ i, Y i ⟶ X} (hf : JointlyLocallySurjective f) :
    Sieve.ofArrows Y f ∈ topology (J := J) X :=
  ⟨I,Y,f,hf, fun i => Sieve.ofArrows_mk Y f i⟩

/-- Jointly covering families in a slice, with the same local lifting predicate. -/
def overCoverage (S : Sheaf J (Type (max u v))) : Coverage (Over S) where
  coverings X := {R | ∃ (I : Type (max u v)) (Y : I → Over S) (f : ∀ i, Y i ⟶ X),
    R = Presieve.ofArrows Y f ∧ JointlyLocallySurjective (fun i => (f i).left)}
  pullback := by
    rintro X Y g R ⟨I,Z,f,rfl,hf⟩
    let P := pullbackFamily (fun i => (f i).left) g.left
    let p := pullbackMaps (fun i => (f i).left) g.left
    let q := fun i => SplitSheaf.lift (SplitSheaf.ofDisplay (f i).left) g.left ≫
      (SplitSheaf.displayIso (f i).left).hom
    have eq (i) : q i ≫ (f i).left = p i ≫ g.left :=
      (pullback_square (fun i => (f i).left) g.left i).w
    let W : I → Over S := fun i => Over.mk (p i ≫ Y.hom)
    let p' : ∀ i, W i ⟶ Y := fun i => Over.homMk (p i)
    let q' : ∀ i, W i ⟶ Z i := fun i => Over.homMk (q i) (by
      dsimp [W]; rw [← Over.w (f i), ← Category.assoc, eq, Category.assoc, Over.w g])
    refine ⟨Presieve.ofArrows W p', ⟨I,W,p',rfl,jointlyLocallySurjective_pullbackMaps _ hf g.left⟩, ?_⟩
    intro V a ha
    obtain ⟨i⟩ := ha
    exact ⟨Z i, q' i, f i, ⟨i⟩, by apply Over.OverMorphism.ext; exact eq i⟩

lemma over_topology_le (S : Sheaf J (Type (max u v))) :
    (topology (J := J)).over S ≤ (overCoverage S).toGrothendieck := by
  intro X R hR
  obtain ⟨I,Y,f,hf,h⟩ := hR
  let Y' : I → Over S := fun i => Over.mk (f i ≫ X.hom)
  let f' : ∀ i, Y' i ⟶ X := fun i => Over.homMk (f i)
  apply Coverage.mem_toGrothendieck_sieves_of_superset (overCoverage S)
    (R := Presieve.ofArrows Y' f')
  · intro Z g hg
    obtain ⟨i⟩ := hg
    exact (Sieve.overEquiv_iff _ _).mp (h i)
  · exact ⟨I,Y',f',rfl,hf⟩

/-- This is the least topology containing all jointly locally-surjective families. -/
lemma topology_le_iff (K : GrothendieckTopology (Sheaf J (Type (max u v)))) :
    topology (J := J) ≤ K ↔
      ∀ {X : Sheaf J (Type (max u v))} {I : Type (max u v)}
        {Y : I → Sheaf J (Type (max u v))} (f : ∀ i, Y i ⟶ X),
        JointlyLocallySurjective f → Sieve.ofArrows Y f ∈ K X := by
  constructor
  · intro h X I Y f hf
    exact h _ (covering hf)
  · rintro h X R ⟨I,Y,f,hf,hR⟩
    apply K.superset_covering _ (h f hf)
    rintro Z g ⟨W,k,l,⟨i⟩,rfl⟩
    exact R.downward_closed (hR i) k

end SquareKit.SheafFamilyCover
