import SquareKit.SmoothPrincipalTopology
import SquareKit.SmoothOpenCover
import SquareKit.SmoothSitePullback

/-! Experimental topology generated by all Type-indexed real-locus principal
covers. The presentation category and its smooth morphisms remain small. -/
noncomputable section
namespace SquareKit.SmoothOpenSite
open CategoryTheory Opposite SmoothAlgebra PresentedLocalization OpenCover SmoothPresentationSite

def coverage : Coverage Site where
  coverings X := {R | ∃ ι : Type, ∃ s : ι → Carrier X.unop, Covers s ∧ R=principalPresieve X.unop s}
  pullback := by
    intro X Y f R hR
    obtain ⟨ι,s,hs,rfl⟩ := hR
    refine ⟨principalPresieve Y.unop (fun i => (smoothMap f.unop).toFun (s i)),⟨ι,_,map_covers (smoothMap f.unop) s hs,rfl⟩,?_⟩
    exact principal_refinement f.unop s

/-- This is the topology generated by the proved coverage, not the canonical topology by fiat. -/
def topology : GrothendieckTopology Site := coverage.toGrothendieck

theorem principal_covering (A : Code) {ι : Type} (s : ι → Carrier A) (hs : Covers s) :
    principalSieve A s ∈ topology (op A) :=
  coverage.mem_toGrothendieck_sieves_of_superset (Sieve.le_generate _) ⟨ι,s,hs,rfl⟩

/-- Exact generation criterion: sheafness on all arbitrary small principal cover families
is equivalent to sheafness for the resulting Grothendieck topology. -/
theorem isSheaf_iff_principal (P : Siteᵒᵖ ⥤ Type) : Presieve.IsSheaf topology P ↔
    ∀ (A : Code) (ι : Type) (s : ι → Carrier A), Covers s → Presieve.IsSheafFor P (principalPresieve A s) := by
  rw [topology,Presieve.isSheaf_coverage]
  constructor
  · intro h A ι s hs
    exact h _ ⟨ι,s,hs,rfl⟩
  · rintro h X R ⟨ι,s,hs,rfl⟩
    exact h X.unop ι s hs

/-- Every previous finite principal cover is among the new generators. -/
theorem finite_topology_le : SmoothPresentationSite.topology ≤ topology := by
  apply (Coverage.gi Site).gc.monotone_l
  intro X R hR
  obtain ⟨k,s,hs,rfl⟩ := hR
  exact ⟨Fin k,s,(finite_iff X.unop.equations s).mpr hs,rfl⟩

/-- Exact pullback stability of the generating covering sieve. -/
theorem covering_pullback {A B : Code} (f : A ⟶ B) {ι : Type} (s : ι → Carrier A)
    (hs : Covers s) : (principalSieve A s).pullback f.op ∈ topology (op B) := by
  rw [principalSieve_pullback]
  exact principal_covering B _ (map_covers f s hs)

end SquareKit.SmoothOpenSite
