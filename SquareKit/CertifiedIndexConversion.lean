import Mathlib.Tactic

/-! A bounded arithmetic index theory. Meaning is independent of conversion. -/
namespace CertifiedIndexConversion

inductive Expr where
  | var : Nat → Expr
  | zero : Expr
  | succ : Expr → Expr
  | add : Expr → Expr → Expr
  | double : Expr → Expr
  deriving DecidableEq, Repr
open Expr

def meaning (ρ : Nat → Nat) : Expr → Nat
  | var i => ρ i
  | zero => 0
  | succ x => meaning ρ x + 1
  | add x y => meaning ρ x + meaning ρ y
  | double x => 2 * meaning ρ x

def subst (σ : Nat → Expr) : Expr → Expr
  | var i => σ i
  | zero => zero
  | succ x => succ (subst σ x)
  | add x y => add (subst σ x) (subst σ y)
  | double x => double (subst σ x)

theorem meaning_subst (ρ : Nat → Nat) (σ : Nat → Expr) (e : Expr) :
    meaning ρ (subst σ e) = meaning (fun i => meaning ρ (σ i)) e := by
  induction e <;> simp_all [subst, meaning]

/-- Context-closed directed rewriting for the jointly admitted packages. -/
inductive Step : Expr → Expr → Prop where
  | addZero (y) : Step (add zero y) y
  | addSucc (x y) : Step (add (succ x) y) (succ (add x y))
  | double (x) : Step (Expr.double x) (add x x)
  | succ {x y} : Step x y → Step (Expr.succ x) (Expr.succ y)
  | left {x y} (z) : Step x y → Step (add x z) (add y z)
  | right (z) {x y} : Step x y → Step (add z x) (add z y)
  | underDouble {x y} : Step x y → Step (Expr.double x) (Expr.double y)

/-- Natural interpretation proving termination of every context-closed rewrite. -/
def weight : Expr → Nat
  | var _ => 0
  | zero => 0
  | succ x => weight x + 1
  | add x y => 2 * weight x + weight y + 1
  | double x => 4 * weight x + 2

theorem step_decreases {x y : Expr} (h : Step x y) : weight y < weight x := by
  induction h <;> simp_all [weight] <;> omega

theorem step_meaning {x y : Expr} (h : Step x y) (ρ : Nat → Nat) :
    meaning ρ x = meaning ρ y := by
  induction h <;> simp_all [meaning] <;> omega

theorem step_subst {x y : Expr} (h : Step x y) (σ : Nat → Expr) :
    Step (subst σ x) (subst σ y) := by
  induction h with
  | addZero y => exact Step.addZero _
  | addSucc x y => exact Step.addSucc _ _
  | double x => exact Step.double _
  | succ h ih => exact Step.succ ih
  | left z h ih => exact Step.left _ ih
  | right z h ih => exact Step.right _ ih
  | underDouble h ih => exact Step.underDouble ih

/-- Congruence generated by admitted equations; distinct from all semantic equality. -/
inductive Converts : Expr → Expr → Prop where
  | refl (x) : Converts x x
  | step {x y} : Step x y → Converts x y
  | symm {x y} : Converts x y → Converts y x
  | trans {x y z} : Converts x y → Converts y z → Converts x z

theorem converts_meaning {x y : Expr} (h : Converts x y) (ρ : Nat → Nat) :
    meaning ρ x = meaning ρ y := by
  induction h with
  | refl => rfl
  | step h => exact step_meaning h ρ
  | symm _ ih => exact ih.symm
  | trans _ _ ih ij => exact ih.trans ij

def addNF : Expr → Expr → Expr
  | zero, y => y
  | succ x, y => succ (addNF x y)
  | x, y => add x y

def normalize : Expr → Expr
  | var i => var i
  | zero => zero
  | succ x => succ (normalize x)
  | add x y => addNF (normalize x) (normalize y)
  | double x => addNF (normalize x) (normalize x)

theorem step_normalize {x y : Expr} (h : Step x y) : normalize x = normalize y := by
  induction h <;> simp_all [normalize, addNF]

theorem converts_normalize {x y : Expr} (h : Converts x y) : normalize x = normalize y := by
  induction h with
  | refl => rfl
  | step h => exact step_normalize h
  | symm _ ih => exact ih.symm
  | trans _ _ ih ij => exact ih.trans ij

abbrev Reduces := Relation.ReflTransGen Step

namespace Reduces
 theorem succ {x y : Expr} (h : Reduces x y) : Reduces (Expr.succ x) (Expr.succ y) :=
   Relation.ReflTransGen.lift Expr.succ (fun _ _ => Step.succ) _ _ h
 theorem left {x y : Expr} (h : Reduces x y) (z : Expr) : Reduces (add x z) (add y z) :=
   Relation.ReflTransGen.lift (fun x => add x z) (fun _ _ => Step.left z) _ _ h
 theorem right {x y : Expr} (h : Reduces x y) (z : Expr) : Reduces (add z x) (add z y) :=
   Relation.ReflTransGen.lift (add z) (fun _ _ => Step.right z) _ _ h
 theorem underDouble {x y : Expr} (h : Reduces x y) : Reduces (double x) (double y) :=
   Relation.ReflTransGen.lift Expr.double (fun _ _ => Step.underDouble) _ _ h
 theorem converts {x y : Expr} (h : Reduces x y) : Converts x y := by
   induction h with
   | refl => exact .refl _
   | tail h s ih => exact .trans ih (.step s)
end Reduces

theorem add_reduces (x y : Expr) : Reduces (add x y) (addNF x y) := by
  induction x with
  | zero => exact Relation.ReflTransGen.single (.addZero _)
  | succ x ih => exact (Relation.ReflTransGen.single (.addSucc _ _)).trans ih.succ
  | _ => exact .refl

theorem reduces_normalize (x : Expr) : Reduces x (normalize x) := by
  induction x with
  | var => exact .refl
  | zero => exact .refl
  | succ x ih => exact ih.succ
  | add x y ix iy => exact ((ix.left y).trans (iy.right _)).trans (add_reduces _ _)
  | double x ih =>
    exact ih.underDouble.trans ((Relation.ReflTransGen.single (.double _)).trans (add_reduces _ _))

theorem conversion_iff (x y : Expr) : Converts x y ↔ normalize x = normalize y := by
  constructor
  · exact converts_normalize
  · intro h
    exact .trans (reduces_normalize x).converts (h ▸ (reduces_normalize y).converts.symm)

theorem confluence {x y z : Expr} (hy : Reduces x y) (hz : Reduces x z) :
    ∃ w, Reduces y w ∧ Reduces z w := by
  refine ⟨normalize y, reduces_normalize y, ?_⟩
  have h := converts_normalize (Converts.trans hy.converts.symm hz.converts)
  rw [h]
  exact reduces_normalize z

theorem converts_subst {x y : Expr} (h : Converts x y) (σ : Nat → Expr) :
    Converts (subst σ x) (subst σ y) := by
  induction h with
  | refl => exact .refl _
  | step h => exact .step (step_subst h σ)
  | symm _ ih => exact .symm ih
  | trans _ _ ih ij => exact .trans ih ij

/-- Syntactic irreducibility for this directed presentation. -/
def Normal (x : Expr) : Prop := ∀ y, ¬ Step x y

theorem normal_succ {x : Expr} (h : Normal x) : Normal (succ x) := by
  intro y hs
  cases hs with
  | succ hs => exact h _ hs

theorem normal_add {x y : Expr} (hx : Normal x) (hy : Normal y)
    (hz : x ≠ zero) (hs : ∀ z, x ≠ succ z) : Normal (add x y) := by
  intro z h
  cases h with
  | addZero => exact hz rfl
  | addSucc a b => exact hs a rfl
  | left z h => exact hx _ h
  | right z h => exact hy _ h

theorem addNF_normal {x y : Expr} (hx : Normal x) (hy : Normal y) : Normal (addNF x y) := by
  induction x with
  | zero => exact hy
  | succ x ih =>
    apply normal_succ
    apply ih
    intro z h
    exact hx _ (.succ h)
  | var i => exact normal_add hx hy (by intro h; cases h) (by intro z h; cases h)
  | add x z => exact normal_add hx hy (by intro h; cases h) (by intro z h; cases h)
  | double x => exact normal_add hx hy (by intro h; cases h) (by intro z h; cases h)

theorem normalize_normal (x : Expr) : Normal (normalize x) := by
  induction x with
  | var i => intro y h; cases h
  | zero => intro y h; cases h
  | succ x ih => exact normal_succ ih
  | add x y ih ij => exact addNF_normal ih ij
  | double x ih => exact addNF_normal ih ih

/-- Every rewrite sequence terminates, including open expressions and contextual steps. -/
theorem terminating : WellFounded (fun y x => Step x y) :=
  Subrelation.wf (fun h => step_decreases h) (measure weight).wf

/-- A finite normalization certificate names the common normal form. -/
structure Certificate where
  common : Expr
  deriving DecidableEq, Repr

/-- This bounded checker recomputes both normal forms. It does not trust the producer. -/
def check (x y : Expr) (c : Certificate) : Bool :=
  decide (normalize x = c.common ∧ normalize y = c.common)

def produce (x y : Expr) : Option Certificate :=
  if normalize x = normalize y then some ⟨normalize x⟩ else none

theorem check_sound (x y : Expr) (c : Certificate) (h : check x y c = true) :
    Converts x y := by
  have hc : normalize x = c.common ∧ normalize y = c.common := of_decide_eq_true h
  exact (conversion_iff x y).mpr (hc.1.trans hc.2.symm)

theorem produce_checked {x y : Expr} {c : Certificate} (h : produce x y = some c) :
    check x y c = true := by
  unfold produce at h
  split_ifs at h with he
  · cases h
    simp [check, he]

theorem produce_complete (x y : Expr) (h : Converts x y) :
    ∃ c, produce x y = some c := by
  exact ⟨⟨normalize x⟩, by simp [produce, converts_normalize h]⟩

/-- Elaborate admitted conversion to an explicit equality transport in the independent family. -/
def elaborate {x y : Expr} (ρ : Nat → Nat) (c : Certificate) (h : check x y c = true)
    (v : Fin (meaning ρ x + 1)) : Fin (meaning ρ y + 1) :=
  Fin.cast (congrArg (· + 1) (converts_meaning (check_sound x y c h) ρ)) v

@[simp] theorem elaborate_value {x y : Expr} (ρ : Nat → Nat) (c : Certificate)
    (h : check x y c = true) (v : Fin (meaning ρ x + 1)) :
    (elaborate ρ c h v).val = v.val := rfl

end CertifiedIndexConversion
