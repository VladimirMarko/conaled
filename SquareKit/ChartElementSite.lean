import SquareKit.ElementSiteLocalEquivalence
import SquareKit.SheafFamilyCover
import Mathlib.CategoryTheory.InducedCategory
import Mathlib.CategoryTheory.Sites.DenseSubsite.InducedTopology

/-! The site generated by a family of sheaf charts, retaining all element-site maps.
Its inclusion is cover dense exactly when the family is jointly locally surjective. -/
noncomputable section
set_option autoImplicit false
set_option warningAsError true
namespace SquareKit.ChartElementSite
open CategoryTheory Opposite
universe u
variable {C : Type u} [Category.{u} C] {J : GrothendieckTopology C}
variable {I : Type u} {X : Sheaf J (Type u)} {Y : I → Sheaf J (Type u)}
variable (f : ∀ i, Y i ⟶ X)

/-- Send a chart section to its image section. -/
def objectMap (a : Σ i, ElementSite.Site (Y i).obj) : ElementSite.Site X.obj :=
  (ElementSite.mapSite (f a.1).hom).obj a.2

/-- Chart sections with every map between their images, including cross-chart maps. -/
abbrev Site := InducedCategory (ElementSite.Site X.obj) (objectMap f)
/-- The fully faithful inclusion of chart sections in the base element site. -/
abbrev inclusion : Site f ⥤ ElementSite.Site X.obj := inducedFunctor (objectMap f)
/-- The topology induced from the base element site. -/
def topology : GrothendieckTopology (Site f) :=
  (inclusion f).inducedTopology (ElementSite.topology X.obj J)

/-- Factorization through a chart is exactly local lifting through the chart family. -/
theorem down_coverByImage (x : ElementSite.Site X.obj) :
    ElementSite.down X.obj (Sieve.coverByImage (inclusion f) x) =
      SheafFamilyCover.imageSieve f x.unop.val := by
  ext V k
  constructor
  · rintro ⟨y, hy, ⟨a, l, g, h⟩⟩
    have hg : SheafFamilyCover.imageSieve f x.unop.val g.unop.hom.unop :=
      ⟨a.1, a.2.unop.val, g.unop.map_val.symm⟩
    have hl := (SheafFamilyCover.imageSieve f x.unop.val).downward_closed hg
      l.unop.hom.unop
    have hh := congrArg (fun t => t.unop.hom.unop) h
    change l.unop.hom.unop ≫ g.unop.hom.unop = k at hh
    rwa [hh] at hl
  · rintro ⟨i, y, hy⟩
    let a : Site f := ⟨i, ElementSite.point (Y i).obj V y⟩
    let g : (inclusion f).obj a ⟶ x :=
      (Functor.Elements.homMk k.op hy.symm).op
    exact ⟨_, g.unop.map_val, Presieve.in_coverByImage (inclusion f) g⟩

/-- The density hypothesis is equivalent to joint local surjectivity of the charts. -/
theorem cover_dense_iff :
    (inclusion f).IsCoverDense (ElementSite.topology X.obj J) ↔
      SheafFamilyCover.JointlyLocallySurjective f := by
  constructor
  · intro h U x
    have hs := h.is_cover (ElementSite.point X.obj U x)
    change ElementSite.down X.obj (Sieve.coverByImage (inclusion f)
      (ElementSite.point X.obj U x)) ∈ J U at hs
    rwa [down_coverByImage] at hs
  · intro h
    constructor
    intro x
    change ElementSite.down X.obj _ ∈ J _
    rw [down_coverByImage]
    exact h x.unop.val

/-- Jointly covering charts generate a cover-dense subsite. -/
theorem cover_dense (h : SheafFamilyCover.JointlyLocallySurjective f) :
    (inclusion f).IsCoverDense (ElementSite.topology X.obj J) :=
  (cover_dense_iff f).2 h

/-- A chart sieve covers exactly when its image covers in the base element site. -/
theorem covering_iff (h : SheafFamilyCover.JointlyLocallySurjective f)
    {a : Site f} (S : Sieve a) :
    S ∈ topology f a ↔
      S.functorPushforward (inclusion f) ∈ ElementSite.topology X.obj J _ := by
  have := cover_dense f h
  exact (inclusion f).mem_inducedTopology_iff_of_isCoverDense _ S

end SquareKit.ChartElementSite
