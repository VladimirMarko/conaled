import SquareKit.SmoothDualCover
import SquareKit.SmoothLocallyConstantGroup

/-! Infinitesimal rigidity of sheafified constant labels. The proof uses lifted
covering sieves and all-target dual factorization, not a pointwise replacement
of the smooth site. -/
noncomputable section
namespace SquareKit.SmoothOpenSite
open CategoryTheory Opposite SmoothPresentationSite SmoothGeometricKL

variable {K : Type} {F : Sheaf topology Type}
variable (η : (Functor.const Siteᵒᵖ).obj K ⟶ F.obj)

/-- A constant label on a full dualized parameter stage remains the same
under every evaluation of its infinitesimal coordinate. -/
theorem label_parameter_evaluation {A B : Code} (h : dual A ⟶ B)
    (g : F.obj.obj (atStage (dual A))) (k : K)
    (hk : η.app (atStage (dual B)) k =
      F.obj.map (stageMap (dualMap (inl A ≫ h))) g) :
    F.obj.map (stageMap h) g = η.app (atStage B) k := by
  calc
    F.obj.map (stageMap h) g = F.obj.map (stageMap (parameterEvaluation h))
        (F.obj.map (stageMap (dualMap (inl A ≫ h))) g) := by
      rw [← types_comp_apply, ← F.obj.map_comp]
      exact congrArg (fun f : dual A ⟶ B => F.obj.map (stageMap f) g)
        (parameter_factorization h).symm
    _ = F.obj.map (stageMap (parameterEvaluation h)) (η.app (atStage (dual B)) k) :=
      congrArg _ hk.symm
    _ = η.app (atStage B) k :=
      (NatTrans.naturality_apply η (stageMap (parameterEvaluation h)) k).symm

/-- Any sheaf locally generated by constant labels is invariant under the
represented first-order extension. No global constant-label hypothesis is used. -/
theorem locallyConstant_dual_zero [Presheaf.IsLocallySurjective topology η]
    (A : Code) (g : F.obj.obj (atStage (dual A))) :
    F.obj.map (stageMap (inl A)) (F.obj.map (stageMap (dualZero A)) g) = g := by
  let R := Presheaf.imageSieve η g
  let S := dualParameterSieve A (𝟙 (op (dual A))) R
  have hS : S ∈ topology (op A) :=
    dualParameterSieve_cover R (Presheaf.imageSieve_mem topology η g) A _
  have hT := topology.pullback_stable (inl A).op hS
  apply (((isSheaf_iff_isSheaf_of_type _ _).mp F.property) _ hT).isSeparatedFor.ext
  intro B f hf
  obtain ⟨k, hk⟩ := hf
  change η.app (atStage (dual B.unop)) k =
    F.obj.map (stageMap (dualMap (inl A ≫ f.unop))) g at hk
  have h₁ := label_parameter_evaluation η f.unop g k hk
  have hb : inl A ≫ (dualZero A ≫ (inl A ≫ f.unop)) = inl A ≫ f.unop := by
    rw [← Category.assoc, inl_dualZero, Category.id_comp]
  have h₂ := label_parameter_evaluation η (dualZero A ≫ (inl A ≫ f.unop)) g k
    (by rw [hb]; exact hk)
  change F.obj.map (stageMap f.unop)
    (F.obj.map (stageMap (inl A)) (F.obj.map (stageMap (dualZero A)) g)) =
      F.obj.map (stageMap f.unop) g
  rw [← types_comp_apply, ← F.obj.map_comp, ← types_comp_apply, ← F.obj.map_comp]
  exact h₂.trans h₁.symm

/-- Zero restriction is inverse to infinitesimal pullback on all sections
of a sheafified constant group, retaining locally varying labels. -/
def constantGroupDualEquiv (G : Type) [Group G] (A : Code) :
    (locallyConstantGroupSheaf G).obj.obj (atStage A) ≃
      (locallyConstantGroupSheaf G).obj.obj (atStage (dual A)) where
  toFun := (locallyConstantGroupSheaf G).obj.map (stageMap (inl A))
  invFun := (locallyConstantGroupSheaf G).obj.map (stageMap (dualZero A))
  left_inv g := by
    rw [← types_comp_apply, ← Functor.map_comp]
    change (locallyConstantGroupSheaf G).obj.map (stageMap (inl A ≫ dualZero A)) g = g
    rw [inl_dualZero]
    exact congrArg (fun k => k g) ((locallyConstantGroupSheaf G).obj.map_id (atStage A))
  right_inv g := by
    let η := Functor.whiskerRight (constantLabel G) (forget GrpCat.{0})
    have hi : Presheaf.IsLocallySurjective topology η :=
      (Presheaf.isLocallySurjective_iff_whisker_forget topology (constantLabel G)).mp
        (constantLabel_locallySurjective G)
    exact @locallyConstant_dual_zero G (locallyConstantGroupSheaf G) η hi A g

end SquareKit.SmoothOpenSite
