import SquareKit.SheafImage
import Examples.PresheafInternal

/-! Experimental finite-site evidence for local existential images.
The two local lifts disagree on the overlap, so no compatible family is lost.
-/
namespace Examples.SheafImage
open CategoryTheory Opposite SquareKit.SheafImage

inductive Diamond where | W | U | V | X
  deriving DecidableEq
open Diamond

inductive Arrow : Diamond → Diamond → Type where
  | id (a) : Arrow a a
  | wu : Arrow W U
  | wv : Arrow W V
  | ux : Arrow U X
  | vx : Arrow V X
  | wx : Arrow W X

instance {a b} : Subsingleton (Arrow a b) := ⟨by
  intro f g; cases f <;> cases g <;> rfl⟩

def compose : Arrow a b → Arrow b c → Arrow a c
  | .id _, g => g
  | f, .id _ => f
  | .wu, .ux => .wx
  | .wv, .vx => .wx

instance : SmallCategory Diamond where
  Hom := Arrow
  id := Arrow.id
  comp := compose
  id_comp := by intros; apply Subsingleton.elim
  comp_id := by intros; apply Subsingleton.elim
  assoc := by intros; apply Subsingleton.elim

/-- A sieve covers when it contains every arrow from W, U, or V.
At those three objects this forces the identity; at X it allows the proper cover.
-/
def topology : GrothendieckTopology Diamond where
  sieves a := {S | ∀ (b) (f : b ⟶ a), b ≠ X → S f}
  top_mem' := by intros a b f h; trivial
  pullback_stable' := by intros a b S f h c g hc; exact h c (g ≫ f) hc
  transitive' := by
    intro a S hS R hR b f hb
    have h := hR (hS b f hb) b (𝟙 b) hb
    simpa using h

/-- The sieve generated by the two inclusions into X. -/
def cover : Sieve X where
  arrows := fun {a} _ => a ≠ X
  downward_closed := by
    intro a b f hf g
    cases g <;> simp_all

theorem cover_mem : cover ∈ topology X := by intro b f hb; exact hb

theorem cover_ne_top : cover ≠ ⊤ := by
  intro h
  have : cover (𝟙 X) := h ▸ (show (⊤ : Sieve X) (𝟙 X) from trivial)
  exact this rfl

theorem covering_elsewhere {a : Diamond} (ha : a ≠ X) (S : Sieve a) :
    S ∈ topology a ↔ S = ⊤ := by
  constructor
  · intro h
    apply top_unique
    intro b f _
    exact h b f (by
      intro hb; subst b; cases f; exact ha rfl)
  · rintro rfl; exact topology.top_mem _

def sections : Diamond → Type
  | W => Bool
  | U | V => Unit
  | X => Empty

def restriction : Arrow a b → sections b → sections a
  | .id _, x => x
  | .wu, _ => false
  | .wv, _ => true
  | .ux, x => nomatch x
  | .vx, x => nomatch x
  | .wx, x => nomatch x

theorem restriction_comp (f : Arrow a b) (g : Arrow b c) (x : sections c) :
    restriction (compose f g) x = restriction f (restriction g x) := by
  cases f <;> cases g <;> first | rfl | exact Empty.elim x

def data : Diamondᵒᵖ ⥤ Type where
  obj a := sections a.unop
  map f := ↾restriction f.unop
  map_id _ := rfl
  map_comp f g := by
    apply ConcreteCategory.hom_ext
    intro x
    exact restriction_comp g.unop f.unop x

theorem incompatible (u : data.obj (op U)) (v : data.obj (op V)) :
    data.map (show W ⟶ U from Arrow.wu).op u ≠ data.map (show W ⟶ V from Arrow.wv).op v := by change false ≠ true; decide

theorem no_sections : IsEmpty (data.obj (op X)) := ⟨fun x => Empty.elim x⟩

/-- Every family on a cover of X would contain the two incompatible lifts. -/
theorem no_compatible (S : Sieve X) (hS : S ∈ topology X)
    (x : Presieve.FamilyOfElements data S.arrows) : ¬ x.Compatible := by
  intro hx
  exact incompatible _ _ (hx Arrow.wu Arrow.wv
    (hS U Arrow.ux (by decide)) (hS V Arrow.vx (by decide)) rfl)

theorem data_isSheaf : Presieve.IsSheaf topology data := by
  intro a S hS
  by_cases ha : a = X
  · subst a
    intro x hx
    exact (no_compatible S hS x hx).elim
  · rw [(covering_elsewhere ha S).mp hS]
    exact Presieve.isSheafFor_top data

abbrev E : Sheaf topology (Type) :=
  ⟨data, (isSheaf_iff_isSheaf_of_type _ _).mpr data_isSheaf⟩

def terminalData : Diamondᵒᵖ ⥤ Type := (Functor.const _).obj Unit

theorem terminal_isSheaf : Presieve.IsSheaf topology terminalData := by
  intro a S hS x hx
  refine ⟨(), ?_, ?_⟩
  · intro b f hf; exact @Subsingleton.elim Unit _ _ _
  · intro b hb; exact @Subsingleton.elim Unit _ _ _

abbrev terminal : Sheaf topology Type :=
  ⟨terminalData, (isSheaf_iff_isSheaf_of_type _ _).mpr terminal_isSheaf⟩

def toTerminal : E ⟶ terminal := ⟨{ app _ := ↾fun _ => () }⟩

/-- Local witnesses exist at all three proper subobjects, including W. -/
theorem locally_witnessed : (localImage ⊤ toTerminal).obj (op X) () := by
  apply (mem_localImage _ _ _).mpr
  intro a f ha
  apply (witness_arrow _ _ _ _).mpr
  cases a with
  | W => exact ⟨false, trivial, rfl⟩
  | U => exact ⟨(), trivial, rfl⟩
  | V => exact ⟨(), trivial, rfl⟩
  | X => exact (ha rfl).elim

theorem no_pointwise_witness :
    ¬ ((⊤ : Subfunctor E.obj).image toTerminal.hom).obj (op X) () := by
  rintro ⟨a, _, _⟩
  exact Empty.elim a

theorem localImage_top : localImage ⊤ toTerminal = ⊤ := by
  apply top_unique
  intro a b hb
  rcases a with ⟨a⟩
  cases b
  cases a with
  | X => exact locally_witnessed
  | W => exact (Subfunctor.le_sheafify _ _ _) ⟨false, trivial, rfl⟩
  | U => exact (Subfunctor.le_sheafify _ _ _) ⟨(), trivial, rfl⟩
  | V => exact (Subfunctor.le_sheafify _ _ _) ⟨(), trivial, rfl⟩

/-- A section of Mathlib's image over X, despite the empty evaluated domain. -/
def imageSection : (Sheaf.image toTerminal).obj.obj (op X) :=
  imageEquiv toTerminal (op X) ⟨(), locally_witnessed⟩

theorem imageSection_inclusion :
    (Sheaf.imageι toTerminal).hom.app (op X) imageSection = () :=
  imageEquiv_inclusion _ _ _

/-- The proper cover is generated by U and V; W factors through either. -/
theorem cover_generated {a : Diamond} (f : a ⟶ X) :
    cover f ↔ (∃ g : a ⟶ U, g ≫ Arrow.ux = f) ∨
      (∃ g : a ⟶ V, g ≫ Arrow.vx = f) := by
  cases f with
  | id =>
    constructor
    · intro h; exact (h rfl).elim
    · rintro (⟨g, _⟩ | ⟨g, _⟩) <;> cases g
  | ux => exact ⟨fun _ => Or.inl ⟨𝟙 U, rfl⟩, fun _ => by intro h; cases h⟩
  | vx => exact ⟨fun _ => Or.inr ⟨𝟙 V, rfl⟩, fun _ => by intro h; cases h⟩
  | wx => exact ⟨fun _ => Or.inl ⟨Arrow.wu, rfl⟩, fun _ => by intro h; cases h⟩

theorem covering_X (S : Sieve X) : S ∈ topology X ↔ S = cover ∨ S = ⊤ := by
  constructor
  · intro h
    by_cases hid : S (𝟙 X)
    · right
      apply top_unique
      intro a f _
      simpa using S.downward_closed hid f
    · left
      apply le_antisymm
      · intro a f hf ha
        subst a
        cases f
        exact hid hf
      · intro a f hf; exact h a f hf
  · rintro (rfl | rfl)
    · exact cover_mem
    · exact topology.top_mem X

/-- Uniqueness of maps establishes that this is the terminal sheaf. -/
def terminalIsTerminal : Limits.IsTerminal terminal :=
  Limits.IsTerminal.ofUniqueHom
    (fun F => ⟨{ app _ := ↾fun _ => () }⟩)
    (by intro F f; ext a x; exact @Subsingleton.elim Unit _ _ _)

open SquareKit.Internal
abbrev FunctionSymbol (_ _ : Unit) := PEmpty

def underlyingModel : Presheaf.Model (J := Diamond) FunctionSymbol where
  carrier _ := data
  arrow f := nomatch f

def emptyEnv (a : Diamondᵒᵖ) : Env (underlyingModel.fiber a) [] :=
  fun {_} i => nomatch i

/-- The singleton context is naturally the underlying presheaf E. -/
def singletonIso : underlyingModel.context [()] ≅ data where
  hom := { app _ := ↾fun ρ => ρ .zero }
  inv := { app a := ↾fun x => Env.extend x (emptyEnv a)
           naturality := by
             intro a b f
             ext x s i
             cases i with
             | zero => rfl
             | succ i => nomatch i }
  hom_inv_id := by
    ext a ρ s i
    cases i with
    | zero => rfl
    | succ i => nomatch i
  inv_hom_id := rfl

/-- The empty context is naturally the terminal presheaf. -/
def emptyIso : underlyingModel.context [] ≅ terminalData where
  hom := { app _ := ↾fun _ => () }
  inv := { app a := ↾fun _ => emptyEnv a
           naturality := by
             intro a b f
             ext x s i
             nomatch i }
  hom_inv_id := by
    ext a ρ s i
    nomatch i
  inv_hom_id := rfl

/-- This identifies the existential context projection with E → 1. -/
theorem projection_comparison :
    underlyingModel.projection (s := ()) (Γ := []) ≫ emptyIso.hom =
      singletonIso.hom ≫ toTerminal.hom := rfl

def existsSection : Formula FunctionSymbol [] :=
  .ex (.eq (.var (Var.zero (s := ()) )) (.var .zero))

theorem existsSection_image : underlyingModel.formula existsSection =
    (⊤ : Subfunctor (underlyingModel.context [()])).image underlyingModel.projection := by
  change (underlyingModel.equality _ _).image _ = _
  congr 1
  ext a ρ
  exact iff_true_intro rfl

/-- Transporting the formula predicate along the empty-context isomorphism
recovers the pointwise image of the very same sheaf map. -/
theorem formula_image_comparison :
    (underlyingModel.formula existsSection).image emptyIso.hom =
      (⊤ : Subfunctor E.obj).image toTerminal.hom := by
  rw [existsSection_image, ← Subfunctor.image_comp, projection_comparison,
    Subfunctor.image_comp, Subfunctor.image_top, Subfunctor.range_eq_top]

theorem presheaf_exists_false :
    ¬ (underlyingModel.formula existsSection).obj (op X) (emptyEnv (op X)) := by
  intro h
  apply no_pointwise_witness
  rw [← formula_image_comparison]
  exact ⟨emptyEnv (op X), h, rfl⟩

/-- The existing evaluation theorem still reports objectwise existence. -/
theorem evaluated_exists_false :
    ¬ existsSection.eval (underlyingModel.fiber (op X)) (emptyEnv (op X)) := by
  intro h
  exact presheaf_exists_false ((underlyingModel.evaluation _ _ _).mpr h)

/-- Sheaf closure of the transported formula has a witness at X. -/
theorem sheaf_exists_true :
    ((underlyingModel.formula existsSection).image emptyIso.hom).sheafify topology |>.obj
      (op X) () := by
  rw [formula_image_comparison]
  exact locally_witnessed

/-- The missing closure assumption really fails for the pointwise image. -/
theorem pointwise_not_sheaf :
    ¬ Presieve.IsSheaf topology
      ((⊤ : Subfunctor E.obj).image toTerminal.hom).toFunctor := by
  intro h
  have inclusion := (adjunction ⊤ toTerminal _ h).mpr
    ((Subfunctor.image_le_iff _ _ _).mp le_rfl)
  exact no_pointwise_witness (inclusion (op X) locally_witnessed)

-- These specializations check the closed-target adjunction and its reindexing
-- obligation on the nontrivial site, without a site-specific image proof.
example : Presieve.IsSheaf topology
    ((localImage ⊤ toTerminal).preimage toTerminal.hom).toFunctor :=
  preimage_isSheaf _ _ (localImage_isSheaf _ _)

example (Q : Subfunctor E.obj) : localImage Q toTerminal ≤ localImage ⊤ toTerminal :=
  monotone toTerminal le_top

example : (localImage ⊤ toTerminal).obj (op U) () :=
  restrict ⊤ toTerminal (show U ⟶ X from Arrow.ux).op locally_witnessed

-- Ordinary graph calls and the opt-in presheaf syntax coexist with local images.
example (n : Nat) : ∃ m, m = n + 1 ∧ 2 * (n + 1) = 2 * m :=
  (Graph.inSet (fun x => x + 1) (fun x => 2 * x) n _).mpr rfl

end Examples.SheafImage
