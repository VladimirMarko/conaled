import SquareKit.SheafFamilyCover

/-! Proper joint covers, empty families, refinement, and base change. -/
noncomputable section
set_option autoImplicit false
set_option warningAsError true
set_option backward.isDefEq.respectTransparency false
namespace Examples.SheafFamilyCover
open CategoryTheory Limits Opposite SquareKit.SheafFamilyCover

abbrev Site := Discrete PUnit.{1}
abbrev topology : GrothendieckTopology Site := ⊥

def constant (T : Type) : Sheaf topology Type :=
  ⟨(Functor.const Siteᵒᵖ).obj T, Presheaf.isSheaf_bot _⟩

def inclusion (b : Bool) : constant PUnit ⟶ constant Bool :=
  ⟨{ app := fun _ => ↾fun _ => b }⟩

/-- The two points jointly cover, by independent local lifts. -/
theorem twoPoints_joint : JointlyLocallySurjective inclusion := by
  intro U b
  rw [GrothendieckTopology.bot_covering]
  ext V k
  constructor
  · intro; trivial
  · intro
    exact ⟨b, PUnit.unit, rfl⟩

/-- Neither of the two members is itself a cover. -/
theorem member_not_surjective (b : Bool) :
    ¬ Presheaf.IsLocallySurjective topology (inclusion b).hom := by
  intro h
  have ht := Presheaf.imageSieve_mem topology (inclusion b).hom
    (U := op (Discrete.mk PUnit.unit)) (!b)
  rw [GrothendieckTopology.bot_covering] at ht
  have hm : Presheaf.imageSieve (inclusion b).hom (!b)
      (𝟙 (Discrete.mk PUnit.unit)) := by rw [ht]; trivial
  obtain ⟨y, hy⟩ := hm
  change b = !b at hy
  cases b <;> cases hy

/-- The new comparison applies to the actual categorical sheaf coproduct. -/
theorem aggregate_surjective :
    Presheaf.IsLocallySurjective topology (Sigma.desc inclusion).hom :=
  (jointlyLocallySurjective_iff_sigmaDesc inclusion).mp twoPoints_joint

/-- A joint aggregate cover need not belong to the sieve generated by its members. -/
theorem aggregate_not_in_family_sieve :
    ¬ Sieve.ofArrows (fun _ : Bool => constant PUnit) inclusion (Sigma.desc inclusion) := by
  intro h
  obtain ⟨b, k, hk⟩ := (Sieve.mem_ofArrows_iff _ _ _).mp h
  let := aggregate_surjective
  exact member_not_surjective b (Presheaf.isLocallySurjective_of_isLocallySurjective_fac
    topology (congrArg (fun t => t.hom) hk.symm))

theorem family_sieve_proper :
    Sieve.ofArrows (fun _ : Bool => constant PUnit) inclusion ≠ ⊤ := by
  intro h
  apply aggregate_not_in_family_sieve
  rw [h]
  trivial

example : JointlyLocallySurjective (fun _ : PUnit => 𝟙 (constant Bool)) :=
  (singleton_iff _).mpr inferInstance

example (b : Bool) : ¬ JointlyLocallySurjective (fun _ : PUnit => inclusion b) := by
  rw [singleton_iff]
  exact member_not_surjective b

/-- The empty family does cover an empty target. -/
def emptyTargetFamily : ∀ _ : Empty, constant PUnit ⟶ constant Empty := fun i => nomatch i

example : JointlyLocallySurjective emptyTargetFamily := by
  rw [empty_iff]
  intro U x
  exact x.elim

/-- It cannot cover the nonempty two-point target on this site. -/
def emptyFamily : ∀ _ : Empty, constant PUnit ⟶ constant Bool := fun i => nomatch i

theorem empty_not_cover : ¬ JointlyLocallySurjective emptyFamily := by
  rw [empty_iff]
  intro h
  have he := h (U := Discrete.mk PUnit.unit) false
  rw [GrothendieckTopology.bot_covering] at he
  have hm : (⊥ : Sieve (Discrete.mk PUnit.unit)) (𝟙 _) := by rw [he]; trivial
  exact hm

example : ¬ Presheaf.IsLocallySurjective topology (Sigma.desc emptyFamily).hom := by
  rw [← jointlyLocallySurjective_iff_sigmaDesc]
  exact empty_not_cover

/-- A nonidentity permutation of the family retains joint coverage by refinement. -/
example : JointlyLocallySurjective (fun b => inclusion (!b)) := by
  apply of_refinement _ inclusion Bool.not (fun _ => 𝟙 _) _ twoPoints_joint
  intro b
  simp

def negation : constant Bool ⟶ constant Bool :=
  ⟨{ app := fun _ => ↾Bool.not }⟩

example : JointlyLocallySurjective (pullbackMaps inclusion negation) :=
  jointlyLocallySurjective_pullbackMaps inclusion twoPoints_joint negation

example : JointlyLocallySurjective (pullbackMaps (pullbackMaps inclusion negation) negation) :=
  jointlyLocallySurjective_pullbackMaps _ (jointlyLocallySurjective_pullbackMaps inclusion twoPoints_joint negation) negation

example : Presheaf.IsLocallySurjective topology
    (Sigma.desc (pullbackMaps inclusion negation)).hom :=
  (jointlyLocallySurjective_iff_sigmaDesc _).mp (jointlyLocallySurjective_pullbackMaps inclusion twoPoints_joint negation)

/-- Empty covering sieves are allowed in the general theorem. -/
def topPoint : Sheaf (⊤ : GrothendieckTopology Site) Type :=
  Sheaf.terminal _ Types.isTerminalPUnit

def topEmptyFamily : ∀ _ : Empty, topPoint ⟶ topPoint := fun i => nomatch i

example : JointlyLocallySurjective topEmptyFamily := by
  rw [empty_iff]
  intro U x
  trivial

example : Presheaf.IsLocallySurjective (⊤ : GrothendieckTopology Site)
    (Sigma.desc topEmptyFamily).hom :=
  (jointlyLocallySurjective_iff_sigmaDesc _).mp (by
    rw [empty_iff]; intro U x; trivial)

/-- Unlike the pointwise empty presheaf, this actual empty sheaf coproduct
has a section: sheafification matters even in the empty-index case. -/
theorem empty_coproduct_has_section :
    Nonempty ((∐ (fun _ : Empty => topPoint)).obj.obj (op (Discrete.mk PUnit.unit))) :=
  ⟨(Sheaf.isTerminalOfBotCover _ _ (by trivial)).from PUnit PUnit.unit⟩

end Examples.SheafFamilyCover
