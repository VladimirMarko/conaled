Resources.RotationCertificate.DelimiterPreludeDraft.binaryYes_iff_exists_delimited_certificate
  (input : Resources.BinaryCounter.Bits) :
  Resources.RotationCertificate.BinaryYes input ↔
    ∃ cert,
      Resources.RotationCertificate.DelimiterPreludeDraft.verifyDelimited
          (Resources.RotationCertificate.DelimiterPreludeDraft.literalPair input cert) =
        true
Resources.RotationCertificate.DelimiterPreludeDraft.binaryYes_iff_exists_small_delimited_certificate
  (input : Resources.BinaryCounter.Bits) :
  Resources.RotationCertificate.BinaryYes input ↔
    ∃ cert,
      List.length cert ≤ List.length input ^ 2 ∧
        List.length (Resources.RotationCertificate.DelimiterPreludeDraft.literalPair input cert) ≤
            List.length input ^ 2 + List.length input + 1 ∧
          Resources.RotationCertificate.DelimiterPreludeDraft.verifyDelimited
              (Resources.RotationCertificate.DelimiterPreludeDraft.literalPair input cert) =
            true
