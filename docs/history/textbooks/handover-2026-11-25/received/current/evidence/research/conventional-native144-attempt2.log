  (d : Resources.TuringSimulation.PolynomialBooleanDecider f) [DecidableEq d.Alphabet] (raw : List Bool) :
  ∃ finish,
    Turing.TM0.step d.machine finish = none ∧
      finish.Tape.head = d.bit (f raw) ∧
        ∃ target,
          ∀ i ≤ target.steps,
            (Resources.TuringSimulation.PrintMove.Trace.visitedInterval d.printMoveMachine
                  (Resources.TuringSimulation.PrintMove.init
                    (Resources.TuringSimulation.PrintMove.Control.normal d.start) (List.map (⇑d.bit) raw))
                  0 raw.length i).card ≤
              max raw.length 1 + (2 * Polynomial.eval raw.length d.time + 1)
