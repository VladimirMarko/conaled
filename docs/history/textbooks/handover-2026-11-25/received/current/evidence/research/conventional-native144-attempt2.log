  Resources.TuringSimulation.PrintMove.Trace.cfgAt M start run.steps = endpoint ∧
    ∀ i ≤ run.steps, (Resources.TuringSimulation.PrintMove.Trace.visitedInterval M start origin N i).card ≤ max N 1 + B
Resources.TuringSimulation.PrintMove.Trace.printMove_nth_at_other_global_coordinate.{u_1} {Γ : Type u_1} [Inhabited Γ]
  (T : Turing.Tape Γ) (a : Γ) (d : Turing.Dir) (x p : ℤ) (hne : x ≠ p) :
  (Turing.Tape.move d (Turing.Tape.write a T)).nth
      (x - (p + Resources.TuringSimulation.PrintMove.Trace.directionOffset d)) =
    T.nth (x - p)
Resources.TuringSimulation.PrintMove.Trace.paid_run_interval.{u_1, u_2} {Γ : Type u_1} {Q : Type u_2} [Inhabited Γ]
  [Inhabited Q] [DecidableEq Γ] (M : Turing.TM0.Machine Γ Q) (bit : Bool ↪ Γ) (start finish : Turing.TM0.Cfg Γ Q)
  (answer : Bool) (B N : ℕ) (origin : ℤ)
  (source : StateTransition.EvalsToInTime (Turing.TM0.step M) start (some finish) B)
  (stopped : Turing.TM0.step M finish = none) (output : finish.Tape.head = bit answer) :
  ∃ target,
    target.steps = Resources.TuringSimulation.PrintMove.simulationTime M start source.steps + 1 ∧
      ∀ i ≤ target.steps,
        (Resources.TuringSimulation.PrintMove.Trace.visitedInterval
              (Resources.TuringSimulation.PrintMove.adapter M (bit true))
              (Resources.TuringSimulation.PrintMove.normalCfg start) origin N i).card ≤
          max N 1 + (2 * B + 1)
