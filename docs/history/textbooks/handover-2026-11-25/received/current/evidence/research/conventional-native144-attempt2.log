Resources.TuringSimulation.PolynomialBooleanDecider.printMove_run {f : List Bool → Bool}
  (d : Resources.TuringSimulation.PolynomialBooleanDecider f) [DecidableEq d.Alphabet] (raw : List Bool) :
  ∃ finish source,
    Turing.TM0.step d.machine finish = none ∧
      finish.Tape.head = d.bit (f raw) ∧
        ∃ target,
          target.steps =
              Resources.TuringSimulation.PrintMove.simulationTime d.machine (Turing.TM0.init (List.map (⇑d.bit) raw))
                  source.steps +
                1 ∧
            target.steps ≤ 2 * source.steps + 1 ∧
              Resources.TuringSimulation.PrintMove.step d.printMoveMachine
                  (Resources.TuringSimulation.PrintMove.decidedCfg (f raw) finish.Tape) =
                none
