Resources.TuringSimulation.PrintMove.step_delta.{u_1, u_2} {Γ : Type u_1} {Q : Type u_2} [Inhabited Γ] [Inhabited Q]
  [DecidableEq Γ] (M : Turing.TM0.Machine Γ Q) (trueLetter : Γ)
  (q : { q // Resources.TuringSimulation.PrintMove.Nonterminal q }) (T : Turing.Tape Γ) :
  Resources.TuringSimulation.PrintMove.step (Resources.TuringSimulation.PrintMove.adapter M trueLetter)
      { q := ↑q, Tape := T } =
    some
      { q := (Resources.TuringSimulation.PrintMove.delta M trueLetter q T.head).next,
        Tape :=
          Turing.Tape.move (Resources.TuringSimulation.PrintMove.delta M trueLetter q T.head).direction
            (Turing.Tape.write (Resources.TuringSimulation.PrintMove.delta M trueLetter q T.head).letter T) }
