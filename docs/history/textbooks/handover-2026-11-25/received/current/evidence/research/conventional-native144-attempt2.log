Resources.TuringSimulation.PolynomialBooleanDecider.classical_printMove_run {f : List Bool → Bool}
  (d : Resources.TuringSimulation.PolynomialBooleanDecider f) (raw : List Bool) :
  ∃ finish,
    Turing.TM0.step d.machine finish = none ∧
      finish.Tape.head = d.bit (f raw) ∧
        Nonempty
          (StateTransition.EvalsToInTime (Resources.TuringSimulation.PrintMove.step d.classicalPrintMoveMachine)
            (Resources.TuringSimulation.PrintMove.init (Resources.TuringSimulation.PrintMove.Control.normal d.start)
              (List.map (⇑d.bit) raw))
            (some (Resources.TuringSimulation.PrintMove.decidedCfg (f raw) finish.Tape))
            (Polynomial.eval raw.length d.printMoveTime))
