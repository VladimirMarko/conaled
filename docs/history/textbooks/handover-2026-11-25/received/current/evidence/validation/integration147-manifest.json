      },
      "imports_added": [
        "Applications.Resources.TuringSimulation.MarkedInput",
        "Applications.Resources.TuringSimulation.FiniteStackToTape",
        "Applications.Resources.TuringSimulation.SingletonOutput"
      ],
      "body_blocks": [
