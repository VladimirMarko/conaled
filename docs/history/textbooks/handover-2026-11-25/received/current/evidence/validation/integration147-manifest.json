  "outputs": [
    {
      "owner": "Applications/Resources/TuringSimulation/OrdinaryPackage.lean",
      "output": {
        "path": "/workspace/scratch/ae71b485b114/work/integration147-drafts/Applications/Resources/TuringSimulation/OrdinaryPackage.lean",
