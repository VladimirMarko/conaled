Resources.TuringSimulation.ConventionalPolynomial.PolynomialDecider (Input : Type) (f : List Input → Bool) : Type 1
Resources.TuringSimulation.ConventionalPolynomial.PolynomialDecider.machine_eq_none_iff {Input : Type}
  {f : List Input → Bool} (self : Resources.TuringSimulation.ConventionalPolynomial.PolynomialDecider Input f)
  (q : self.Control) (a : self.Alphabet) : self.machine q a = none ↔ q = self.accept ∨ q = self.reject
Resources.TuringSimulation.ConventionalPolynomial.PolynomialDecider.run {Input : Type} {f : List Input → Bool}
  (self : Resources.TuringSimulation.ConventionalPolynomial.PolynomialDecider Input f) (raw : List Input) :
  ∃ finish,
    Nonempty
        (StateTransition.EvalsToInTime (Resources.TuringSimulation.PrintMove.step self.machine)
          (Resources.TuringSimulation.PrintMove.init self.start (List.map (⇑self.letter) raw)) (some finish)
          (raw.length ^ self.exponent + self.exponent)) ∧
