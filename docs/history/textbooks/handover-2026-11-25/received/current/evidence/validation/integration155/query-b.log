Resources.RotationCertificate.FrontEndStreamMachine.ordinary_run_and_eval {K Λ R : Type} {Γ : K → Type} [DecidableEq K]
  [Fintype K] [Fintype Λ] [Fintype R] [(k : K) → Fintype (Γ k)]
  (caller : Λ → Resources.RotationCertificate.FrontEndStreamMachine.Statement Γ Λ R) (initial : R)
