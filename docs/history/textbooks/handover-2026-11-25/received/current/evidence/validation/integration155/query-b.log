Resources.TuringSimulation.VisitedSpace.halted_run_adds_no_cells.{u_1, u_2} {Γ : Type u_1} {Q : Type u_2} [Inhabited Γ]
  [Inhabited Q] (M : Turing.TM0.Machine Γ Q) (start finish : Turing.TM0.Cfg Γ Q) (B : ℕ)
