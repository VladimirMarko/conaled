Resources.TuringSimulation.VisitedSpace.space_le_of_run.{u_1, u_2} {Γ : Type u_1} {Q : Type u_2} [Inhabited Γ]
  [Inhabited Q] (M : Turing.TM0.Machine Γ Q) (start : Turing.TM0.Cfg Γ Q) (endpoint : Option (Turing.TM0.Cfg Γ Q))
  (B : ℕ) (run : StateTransition.EvalsToInTime (Turing.TM0.step M) start endpoint B) (origin : ℤ) (N : ℕ) :
  Resources.TuringSimulation.VisitedSpace.cfgAt M start run.steps = endpoint ∧
    ∀ i ≤ run.steps,
      (Resources.TuringSimulation.VisitedSpace.visitedCells M start origin i).card ≤ B + 1 ∧
        (Resources.TuringSimulation.VisitedSpace.inputVisitedCells M start origin N i).card ≤ max N 1 + B ∧
          (Resources.TuringSimulation.VisitedSpace.visitedInterval M start origin N i).card ≤ max N 1 + B
