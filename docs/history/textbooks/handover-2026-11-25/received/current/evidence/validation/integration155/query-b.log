@Examples.RotationCertificateFrontEndStreamMachine.every_indexed_cleanup_prefix_retains_all_nonactive_words : ∀
  {K Λ R : Type} {Γ : K → Type} [inst : DecidableEq K]
  (caller : Λ → Resources.RotationCertificate.FrontEndStreamMachine.Statement Γ Λ R) (i j : Fin 16) (t : ℕ)
  (D : Resources.RotationCertificate.FrontEndStreamMachine.LocalData)
  (regs : Resources.RotationCertificate.FrontEndStreamMachine.Registers R) (ctx : (k : K) → List (Γ k)),
  ↑i ≤ ↑j →
    t ≤ Resources.RotationCertificate.FrontEndStreamMachine.slotLength j D →
      Examples.RotationCertificateFrontEndStreamMachine.Runs
        (Resources.RotationCertificate.FrontEndStreamMachine.step caller)
        (Resources.RotationCertificate.FrontEndStreamMachine.cfg
          (some (Resources.RotationCertificate.FrontEndStreamMachine.clearLabel i)) regs D ctx)
        ((∑ k,
            if ↑i ≤ ↑k ∧ ↑k < ↑j then Resources.RotationCertificate.FrontEndStreamMachine.slotLength k D + 1 else 0) +
          t)
        (Resources.RotationCertificate.FrontEndStreamMachine.cfg
          (some (Resources.RotationCertificate.FrontEndStreamMachine.clearLabel j))
          (if t = 0 then
            if i = j then regs else Resources.RotationCertificate.FrontEndStreamMachine.occupancyRegisters false regs
          else Resources.RotationCertificate.FrontEndStreamMachine.occupancyRegisters true regs)
          (Resources.RotationCertificate.FrontEndStreamMachine.dropData j t
            (Resources.RotationCertificate.FrontEndStreamMachine.boundaryData i j D))
          ctx)
