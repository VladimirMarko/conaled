  (d : Resources.TuringSimulation.PolynomialBooleanDecider f) [DecidableEq d.Alphabet] :
  Resources.TuringSimulation.PrintMove.Machine d.Alphabet (Resources.TuringSimulation.PrintMove.Control d.Control)
Resources.TuringSimulation.PolynomialBooleanDecider.printMove_run {f : List Bool → Bool}
  (d : Resources.TuringSimulation.PolynomialBooleanDecider f) [DecidableEq d.Alphabet] (raw : List Bool) :
  ∃ finish source,
    Turing.TM0.step d.machine finish = none ∧
      finish.Tape.head = d.bit (f raw) ∧
        ∃ target,
          target.steps =
              Resources.TuringSimulation.PrintMove.simulationTime d.machine (Turing.TM0.init (List.map (⇑d.bit) raw))
                  source.steps +
                1 ∧
            target.steps ≤ 2 * source.steps + 1 ∧
              Resources.TuringSimulation.PrintMove.step d.printMoveMachine
                  (Resources.TuringSimulation.PrintMove.decidedCfg (f raw) finish.Tape) =
                none
Resources.TuringSimulation.PolynomialBooleanDecider.printMove_run_with_space {f : List Bool → Bool}
  (d : Resources.TuringSimulation.PolynomialBooleanDecider f) [DecidableEq d.Alphabet] (raw : List Bool) :
  ∃ finish,
    Turing.TM0.step d.machine finish = none ∧
      finish.Tape.head = d.bit (f raw) ∧
        ∃ target,
          ∀ i ≤ target.steps,
            (Resources.TuringSimulation.PrintMove.Trace.visitedInterval d.printMoveMachine
                  (Resources.TuringSimulation.PrintMove.init
                    (Resources.TuringSimulation.PrintMove.Control.normal d.start) (List.map (⇑d.bit) raw))
                  0 raw.length i).card ≤
              max raw.length 1 + (2 * Polynomial.eval raw.length d.time + 1)
Resources.TuringSimulation.PolynomialBooleanDecider.classicalPrintMoveMachine {f : List Bool → Bool}
  (d : Resources.TuringSimulation.PolynomialBooleanDecider f) :
  Resources.TuringSimulation.PrintMove.Machine d.Alphabet (Resources.TuringSimulation.PrintMove.Control d.Control)
Resources.TuringSimulation.PolynomialBooleanDecider.classical_printMove_run {f : List Bool → Bool}
  (d : Resources.TuringSimulation.PolynomialBooleanDecider f) (raw : List Bool) :
  ∃ finish,
    Turing.TM0.step d.machine finish = none ∧
      finish.Tape.head = d.bit (f raw) ∧
        Nonempty
          (StateTransition.EvalsToInTime (Resources.TuringSimulation.PrintMove.step d.classicalPrintMoveMachine)
            (Resources.TuringSimulation.PrintMove.init (Resources.TuringSimulation.PrintMove.Control.normal d.start)
              (List.map (⇑d.bit) raw))
            (some (Resources.TuringSimulation.PrintMove.decidedCfg (f raw) finish.Tape))
            (Polynomial.eval raw.length d.printMoveTime))
