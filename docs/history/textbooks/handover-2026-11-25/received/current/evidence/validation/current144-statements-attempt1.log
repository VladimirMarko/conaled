  (origin x : ℤ) (n : ℕ)
  (hcfg : Resources.TuringSimulation.VisitedSpace.cfgAt M (Turing.TM0.init input) n = some finish)
  (hx : x ∉ Resources.TuringSimulation.VisitedSpace.inputVisitedCells M (Turing.TM0.init input) origin input.length n) :
