  (emit : Turing.TM2to1.Γ' K Γ → Turing.TM2to1.Γ' K Γ) (right left : List (Γ k)) (nonempty : left ≠ []) :
  (flip bind (Turing.TM0.step (Resources.TuringSimulation.MarkedInput.machine k M emit)))^[right.length + 2]
      (some
        { q := Resources.TuringSimulation.MarkedInput.Control.scan,
          Tape := Resources.TuringSimulation.MarkedInput.scanTape k left right }) =
    some
      { q := Resources.TuringSimulation.MarkedInput.Control.run default,
        Tape :=
          Resources.TuringSimulation.TapeReflection.tape
            (Turing.Tape.mk₁ (Turing.TM2to1.trInit k (left.reverse ++ right))) }
Resources.TuringSimulation.MarkedInput.prelude_exact.{u_1, u_2, u_3} {K : Type u_1} {Γ : K → Type u_2} [DecidableEq K]
  {Q : Type u_3} [Inhabited Q] (k : K) (M : Turing.TM0.Machine (Turing.TM2to1.Γ' K Γ) Q)
  (emit : Turing.TM2to1.Γ' K Γ → Turing.TM2to1.Γ' K Γ) (raw : List (Γ k)) :
  (flip bind
          (Turing.TM0.step
            (Resources.TuringSimulation.MarkedInput.machine k M
              emit)))^[Resources.TuringSimulation.MarkedInput.preludeSteps raw]
      (some (Turing.TM0.init (Resources.TuringSimulation.MarkedInput.input k raw))) =
    some
      { q := Resources.TuringSimulation.MarkedInput.Control.run default,
        Tape := Resources.TuringSimulation.TapeReflection.tape (Turing.Tape.mk₁ (Turing.TM2to1.trInit k raw)) }
Resources.TuringSimulation.MarkedInput.preludeRun.{u_1, u_2, u_3} {K : Type u_1} {Γ : K → Type u_2} [DecidableEq K]
  {Q : Type u_3} [Inhabited Q] (k : K) (M : Turing.TM0.Machine (Turing.TM2to1.Γ' K Γ) Q)
  (emit : Turing.TM2to1.Γ' K Γ → Turing.TM2to1.Γ' K Γ) (raw : List (Γ k)) :
  StateTransition.EvalsTo (Turing.TM0.step (Resources.TuringSimulation.MarkedInput.machine k M emit))
    (Turing.TM0.init (Resources.TuringSimulation.MarkedInput.input k raw))
    (some
      { q := Resources.TuringSimulation.MarkedInput.Control.run default,
        Tape := Resources.TuringSimulation.TapeReflection.tape (Turing.Tape.mk₁ (Turing.TM2to1.trInit k raw)) })
Resources.TuringSimulation.MarkedInput.preludeRun_steps.{u_1, u_2, u_3} {K : Type u_1} {Γ : K → Type u_2}
  [DecidableEq K] {Q : Type u_3} [Inhabited Q] (k : K) (M : Turing.TM0.Machine (Turing.TM2to1.Γ' K Γ) Q)
  (emit : Turing.TM2to1.Γ' K Γ → Turing.TM2to1.Γ' K Γ) (raw : List (Γ k)) :
  (Resources.TuringSimulation.MarkedInput.preludeRun k M emit raw).steps =
    Resources.TuringSimulation.MarkedInput.preludeSteps raw
Resources.TuringSimulation.MarkedInput.emit_singleton_step.{u_1, u_2, u_3} {K : Type u_1} {Γ : K → Type u_2}
  {Q : Type u_3} [Inhabited Q] (k : K) (M : Turing.TM0.Machine (Turing.TM2to1.Γ' K Γ) Q)
  (emit : Turing.TM2to1.Γ' K Γ → Turing.TM2to1.Γ' K Γ) (q : Q) (a : Turing.TM2to1.Γ' K Γ) (stopped : M q a = none) :
  Turing.TM0.step (Resources.TuringSimulation.MarkedInput.machine k M emit)
      { q := Resources.TuringSimulation.MarkedInput.Control.run q, Tape := Turing.Tape.mk₁ [a] } =
    some { q := Resources.TuringSimulation.MarkedInput.Control.done, Tape := Turing.Tape.mk₁ [emit a] }
Resources.TuringSimulation.MarkedInput.done_step.{u_1, u_2, u_3} {K : Type u_1} {Γ : K → Type u_2} {Q : Type u_3}
  [Inhabited Q] (k : K) (M : Turing.TM0.Machine (Turing.TM2to1.Γ' K Γ) Q)
  (emit : Turing.TM2to1.Γ' K Γ → Turing.TM2to1.Γ' K Γ) (T : Turing.Tape (Turing.TM2to1.Γ' K Γ)) :
  Turing.TM0.step (Resources.TuringSimulation.MarkedInput.machine k M emit)
      { q := Resources.TuringSimulation.MarkedInput.Control.done, Tape := T } =
    none
Resources.TuringSimulation.MarkedInput.runConfiguration.{u_1, u_2, u_3} {K : Type u_1} {Γ : K → Type u_2} {Q : Type u_3}
  (c : Turing.TM0.Cfg (Turing.TM2to1.Γ' K Γ) Q) :
  Turing.TM0.Cfg (Turing.TM2to1.Γ' K Γ) (Resources.TuringSimulation.MarkedInput.Control Q)
Resources.TuringSimulation.MarkedInput.run_step.{u_1, u_2, u_3} {K : Type u_1} {Γ : K → Type u_2} {Q : Type u_3}
  [Inhabited Q] (k : K) (M : Turing.TM0.Machine (Turing.TM2to1.Γ' K Γ) Q)
  (emit : Turing.TM2to1.Γ' K Γ → Turing.TM2to1.Γ' K Γ) (a b : Turing.TM0.Cfg (Turing.TM2to1.Γ' K Γ) Q)
  (live : Turing.TM0.step M a = some b) :
  Turing.TM0.step (Resources.TuringSimulation.MarkedInput.machine k M emit)
      (Resources.TuringSimulation.MarkedInput.runConfiguration a) =
    some (Resources.TuringSimulation.MarkedInput.runConfiguration b)
Resources.TuringSimulation.MarkedInput.run_iterate.{u_1, u_2, u_3} {K : Type u_1} {Γ : K → Type u_2} {Q : Type u_3}
  [Inhabited Q] (k : K) (M : Turing.TM0.Machine (Turing.TM2to1.Γ' K Γ) Q)
  (emit : Turing.TM2to1.Γ' K Γ → Turing.TM2to1.Γ' K Γ) (n : ℕ) (a b : Turing.TM0.Cfg (Turing.TM2to1.Γ' K Γ) Q)
  (live : (flip bind (Turing.TM0.step M))^[n] (some a) = some b) :
  (flip bind (Turing.TM0.step (Resources.TuringSimulation.MarkedInput.machine k M emit)))^[n]
      (some (Resources.TuringSimulation.MarkedInput.runConfiguration a)) =
    some (Resources.TuringSimulation.MarkedInput.runConfiguration b)
Resources.TuringSimulation.MarkedInput.liveRun.{u_1, u_2, u_3} {K : Type u_1} {Γ : K → Type u_2} {Q : Type u_3}
  [Inhabited Q] (k : K) (M : Turing.TM0.Machine (Turing.TM2to1.Γ' K Γ) Q)
  (emit : Turing.TM2to1.Γ' K Γ → Turing.TM2to1.Γ' K Γ) (a b : Turing.TM0.Cfg (Turing.TM2to1.Γ' K Γ) Q)
  (before : StateTransition.EvalsTo (Turing.TM0.step M) a (some b)) :
  StateTransition.EvalsTo (Turing.TM0.step (Resources.TuringSimulation.MarkedInput.machine k M emit))
    (Resources.TuringSimulation.MarkedInput.runConfiguration a)
    (some (Resources.TuringSimulation.MarkedInput.runConfiguration b))
Resources.TuringSimulation.MarkedInput.liveRun_steps.{u_1, u_2, u_3} {K : Type u_1} {Γ : K → Type u_2} {Q : Type u_3}
  [Inhabited Q] (k : K) (M : Turing.TM0.Machine (Turing.TM2to1.Γ' K Γ) Q)
  (emit : Turing.TM2to1.Γ' K Γ → Turing.TM2to1.Γ' K Γ) (a b : Turing.TM0.Cfg (Turing.TM2to1.Γ' K Γ) Q)
  (before : StateTransition.EvalsTo (Turing.TM0.step M) a (some b)) :
  (Resources.TuringSimulation.MarkedInput.liveRun k M emit a b before).steps = before.steps
Resources.TuringSimulation.MarkedInput.normalizedRun.{u_1, u_2, u_3} {K : Type u_1} {Γ : K → Type u_2} [DecidableEq K]
  {Q : Type u_3} [Inhabited Q] (k : K) (M : Turing.TM0.Machine (Turing.TM2to1.Γ' K Γ) Q)
  (emit : Turing.TM2to1.Γ' K Γ → Turing.TM2to1.Γ' K Γ) (raw : List (Γ k)) (q : Q) (a : Turing.TM2to1.Γ' K Γ)
  (before :
    StateTransition.EvalsTo (Turing.TM0.step M) (Turing.TM0.init (Turing.TM2to1.trInit k raw))
      (some { q := q, Tape := Turing.Tape.mk₁ [a] }))
  (stopped : M q a = none) :
  StateTransition.EvalsTo (Turing.TM0.step (Resources.TuringSimulation.MarkedInput.machine k M emit))
    (Turing.TM0.init (Resources.TuringSimulation.MarkedInput.input k raw))
    (some { q := Resources.TuringSimulation.MarkedInput.Control.done, Tape := Turing.Tape.mk₁ [emit a] })
Resources.TuringSimulation.MarkedInput.normalizedRun_steps.{u_1, u_2, u_3} {K : Type u_1} {Γ : K → Type u_2}
  [DecidableEq K] {Q : Type u_3} [Inhabited Q] (k : K) (M : Turing.TM0.Machine (Turing.TM2to1.Γ' K Γ) Q)
  (emit : Turing.TM2to1.Γ' K Γ → Turing.TM2to1.Γ' K Γ) (raw : List (Γ k)) (q : Q) (a : Turing.TM2to1.Γ' K Γ)
  (before :
    StateTransition.EvalsTo (Turing.TM0.step M) (Turing.TM0.init (Turing.TM2to1.trInit k raw))
      (some { q := q, Tape := Turing.Tape.mk₁ [a] }))
  (stopped : M q a = none) :
  (Resources.TuringSimulation.MarkedInput.normalizedRun k M emit raw q a before stopped).steps =
    1 + (before.steps + Resources.TuringSimulation.MarkedInput.preludeSteps raw)
Resources.TuringSimulation.MarkedInput.normalizedRunInTime.{u_1, u_2, u_3} {K : Type u_1} {Γ : K → Type u_2}
  [DecidableEq K] {Q : Type u_3} [Inhabited Q] (k : K) (M : Turing.TM0.Machine (Turing.TM2to1.Γ' K Γ) Q)
  (emit : Turing.TM2to1.Γ' K Γ → Turing.TM2to1.Γ' K Γ) (raw : List (Γ k)) (q : Q) (a : Turing.TM2to1.Γ' K Γ) (B : ℕ)
  (before :
    StateTransition.EvalsToInTime (Turing.TM0.step M) (Turing.TM0.init (Turing.TM2to1.trInit k raw))
      (some { q := q, Tape := Turing.Tape.mk₁ [a] }) B)
  (stopped : M q a = none) :
  StateTransition.EvalsToInTime (Turing.TM0.step (Resources.TuringSimulation.MarkedInput.machine k M emit))
    (Turing.TM0.init (Resources.TuringSimulation.MarkedInput.input k raw))
    (some { q := Resources.TuringSimulation.MarkedInput.Control.done, Tape := Turing.Tape.mk₁ [emit a] })
    (Resources.TuringSimulation.MarkedInput.preludeSteps raw + B + 1)
Resources.TuringSimulation.MarkedInput.normalizedOuterNone.{u_1, u_2, u_3} {K : Type u_1} {Γ : K → Type u_2}
  [DecidableEq K] {Q : Type u_3} [Inhabited Q] (k : K) (M : Turing.TM0.Machine (Turing.TM2to1.Γ' K Γ) Q)
  (emit : Turing.TM2to1.Γ' K Γ → Turing.TM2to1.Γ' K Γ) (raw : List (Γ k)) (q : Q) (a : Turing.TM2to1.Γ' K Γ) (B : ℕ)
  (before :
    StateTransition.EvalsToInTime (Turing.TM0.step M) (Turing.TM0.init (Turing.TM2to1.trInit k raw))
      (some { q := q, Tape := Turing.Tape.mk₁ [a] }) B)
  (stopped : M q a = none) :
  StateTransition.EvalsToInTime (Turing.TM0.step (Resources.TuringSimulation.MarkedInput.machine k M emit))
    (Turing.TM0.init (Resources.TuringSimulation.MarkedInput.input k raw)) none
    (Resources.TuringSimulation.MarkedInput.preludeSteps raw + B + 2)
Resources.TuringSimulation.MarkedInput.normalized_eval.{u_1, u_2, u_3} {K : Type u_1} {Γ : K → Type u_2} [DecidableEq K]
  {Q : Type u_3} [Inhabited Q] (k : K) (M : Turing.TM0.Machine (Turing.TM2to1.Γ' K Γ) Q)
  (emit : Turing.TM2to1.Γ' K Γ → Turing.TM2to1.Γ' K Γ) (raw : List (Γ k)) (q : Q) (a : Turing.TM2to1.Γ' K Γ)
  (before :
    StateTransition.EvalsTo (Turing.TM0.step M) (Turing.TM0.init (Turing.TM2to1.trInit k raw))
      (some { q := q, Tape := Turing.Tape.mk₁ [a] }))
  (stopped : M q a = none) :
  Turing.TM0.eval (Resources.TuringSimulation.MarkedInput.machine k M emit)
      (Resources.TuringSimulation.MarkedInput.input k raw) =
    Part.some (Turing.ListBlank.mk [emit a])
Resources.TuringSimulation.SingletonOutput.related_singleton_tape.{u_1, u_2, u_3, u_4} {K : Type u_1} {Γ : K → Type u_2}
  {Λ : Type u_3} {σ : Type u_4} (source : Turing.TM2.Cfg Γ Λ σ)
  (target : Turing.TM1.Cfg (Turing.TM2to1.Γ' K Γ) (Turing.TM2to1.Λ' K Γ Λ σ) σ) (row : (k : K) → Option (Γ k))
  (related : Turing.TM2to1.TrCfg source target) (slots : ∀ (k : K), source.stk k = (row k).toList) :
  target.Tape = Turing.Tape.mk₁ [(true, row)]
Resources.TuringSimulation.SingletonOutput.reflection_singleton.{u_5} {A : Type u_5} [Inhabited A] (a : A) :
  Resources.TuringSimulation.TapeReflection.tape (Turing.Tape.mk₁ [a]) = Turing.Tape.mk₁ [a]
Resources.TuringSimulation.SingletonOutput.haltRow (tm : Turing.FinTM2) (a : tm.Γ tm.k₁) (k : tm.K) : Option (tm.Γ k)
Resources.TuringSimulation.SingletonOutput.haltList_singleton_slots (tm : Turing.FinTM2) (a : tm.Γ tm.k₁) (k : tm.K) :
  (Turing.haltList tm [a]).stk k = (Resources.TuringSimulation.SingletonOutput.haltRow tm a k).toList
Resources.TuringSimulation.SingletonOutput.haltList_singleton_tape (tm : Turing.FinTM2) (a : tm.Γ tm.k₁)
  (target : Turing.TM1.Cfg (Turing.TM2to1.Γ' tm.K tm.Γ) (Turing.TM2to1.Λ' tm.K tm.Γ tm.Λ tm.σ) tm.σ)
  (related : Turing.TM2to1.TrCfg (Turing.haltList tm [a]) target) :
  target.Tape = Turing.Tape.mk₁ [(true, Resources.TuringSimulation.SingletonOutput.haltRow tm a)]
Resources.TuringSimulation.SingletonOutput.package_halt_supported (tm : Turing.FinTM2) (v : tm.σ) :
  (none, v) ∈ Resources.TuringSimulation.StackToTape.Package.controlSupport tm
Resources.TuringSimulation.SingletonOutput.related_package_halt_stopped (tm : Turing.FinTM2) (out : List (tm.Γ tm.k₁))
  (target : Turing.TM1.Cfg (Turing.TM2to1.Γ' tm.K tm.Γ) (Turing.TM2to1.Λ' tm.K tm.Γ tm.Λ tm.σ) tm.σ)
  (related : Turing.TM2to1.TrCfg (Turing.haltList tm out) target)
  (a : Resources.TuringSimulation.StackToTape.Package.Alphabet tm) :
  Resources.TuringSimulation.StackToTape.Package.closedMachine tm
      (Resources.TuringSimulation.StackToTape.Package.mapCfg tm (Turing.TM1to0.trCfg (Turing.TM2to1.tr tm.m) target)).q
      a =
    none
Resources.TuringSimulation.PolynomialBooleanDecider (f : List Bool → Bool) : Type 1
Resources.TuringSimulation.PolynomialBooleanDecider.false_ne_blank {f : List Bool → Bool}
  (d : Resources.TuringSimulation.PolynomialBooleanDecider f) : d.bit false ≠ d.blank
Resources.TuringSimulation.PolynomialBooleanDecider.true_ne_false {f : List Bool → Bool}
  (d : Resources.TuringSimulation.PolynomialBooleanDecider f) : d.bit true ≠ d.bit false
Resources.TuringSimulation.PolynomialBooleanDecider.run_and_outer_none {f : List Bool → Bool}
  (d : Resources.TuringSimulation.PolynomialBooleanDecider f) (raw : List Bool) :
  ∃ finish,
    Nonempty
        (StateTransition.EvalsToInTime (Turing.TM0.step d.machine) (Turing.TM0.init (List.map (⇑d.bit) raw))
          (some finish) (Polynomial.eval raw.length d.time)) ∧
      Turing.TM0.step d.machine finish = none ∧
        finish.Tape.head = d.bit (f raw) ∧
          Nonempty
            (StateTransition.EvalsToInTime (Turing.TM0.step d.machine) (Turing.TM0.init (List.map (⇑d.bit) raw)) none
              (Polynomial.eval raw.length d.time + 1))
Resources.TuringSimulation.VisitedSpace.directionOffset : Turing.Dir → ℤ
Resources.TuringSimulation.VisitedSpace.commandOffset.{u_1, u_2} {Γ : Type u_1} {Q : Type u_2} :
  Option (Q × Turing.TM0.Stmt Γ) → ℤ
Resources.TuringSimulation.VisitedSpace.commandOffset_bounds.{u_1, u_2} {Γ : Type u_1} {Q : Type u_2}
  (a : Option (Q × Turing.TM0.Stmt Γ)) :
  -1 ≤ Resources.TuringSimulation.VisitedSpace.commandOffset a ∧
    Resources.TuringSimulation.VisitedSpace.commandOffset a ≤ 1
Resources.TuringSimulation.VisitedSpace.cfgAt.{u_1, u_2} {Γ : Type u_1} {Q : Type u_2} [Inhabited Γ] [Inhabited Q]
  (M : Turing.TM0.Machine Γ Q) (start : Turing.TM0.Cfg Γ Q) (n : ℕ) : Option (Turing.TM0.Cfg Γ Q)
Resources.TuringSimulation.VisitedSpace.cfgAt_zero.{u_1, u_2} {Γ : Type u_1} {Q : Type u_2} [Inhabited Γ] [Inhabited Q]
  (M : Turing.TM0.Machine Γ Q) (start : Turing.TM0.Cfg Γ Q) :
  Resources.TuringSimulation.VisitedSpace.cfgAt M start 0 = some start
Resources.TuringSimulation.VisitedSpace.cfgAt_succ.{u_1, u_2} {Γ : Type u_1} {Q : Type u_2} [Inhabited Γ] [Inhabited Q]
  (M : Turing.TM0.Machine Γ Q) (start : Turing.TM0.Cfg Γ Q) (n : ℕ) :
  Resources.TuringSimulation.VisitedSpace.cfgAt M start (n + 1) =
    (Resources.TuringSimulation.VisitedSpace.cfgAt M start n).bind (Turing.TM0.step M)
Resources.TuringSimulation.VisitedSpace.commandAt.{u_1, u_2} {Γ : Type u_1} {Q : Type u_2} [Inhabited Γ] [Inhabited Q]
  (M : Turing.TM0.Machine Γ Q) (start : Turing.TM0.Cfg Γ Q) (n : ℕ) : Option (Q × Turing.TM0.Stmt Γ)
Resources.TuringSimulation.VisitedSpace.commandAt_of_live.{u_1, u_2} {Γ : Type u_1} {Q : Type u_2} [Inhabited Γ]
  [Inhabited Q] (M : Turing.TM0.Machine Γ Q) (start c : Turing.TM0.Cfg Γ Q) (n : ℕ)
  (h : Resources.TuringSimulation.VisitedSpace.cfgAt M start n = some c) :
  Resources.TuringSimulation.VisitedSpace.commandAt M start n = M c.q c.Tape.head
Resources.TuringSimulation.VisitedSpace.commandAt_of_none.{u_1, u_2} {Γ : Type u_1} {Q : Type u_2} [Inhabited Γ]
  [Inhabited Q] (M : Turing.TM0.Machine Γ Q) (start : Turing.TM0.Cfg Γ Q) (n : ℕ)
  (h : Resources.TuringSimulation.VisitedSpace.cfgAt M start n = none) :
  Resources.TuringSimulation.VisitedSpace.commandAt M start n = none
Resources.TuringSimulation.VisitedSpace.headPosition.{u_1, u_2} {Γ : Type u_1} {Q : Type u_2} [Inhabited Γ]
  [Inhabited Q] (M : Turing.TM0.Machine Γ Q) (start : Turing.TM0.Cfg Γ Q) (origin : ℤ) : ℕ → ℤ
Resources.TuringSimulation.VisitedSpace.headPosition_zero.{u_1, u_2} {Γ : Type u_1} {Q : Type u_2} [Inhabited Γ]
  [Inhabited Q] (M : Turing.TM0.Machine Γ Q) (start : Turing.TM0.Cfg Γ Q) (origin : ℤ) :
  Resources.TuringSimulation.VisitedSpace.headPosition M start origin 0 = origin
Resources.TuringSimulation.VisitedSpace.headPosition_succ.{u_1, u_2} {Γ : Type u_1} {Q : Type u_2} [Inhabited Γ]
  [Inhabited Q] (M : Turing.TM0.Machine Γ Q) (start : Turing.TM0.Cfg Γ Q) (origin : ℤ) (n : ℕ) :
  Resources.TuringSimulation.VisitedSpace.headPosition M start origin (n + 1) =
    Resources.TuringSimulation.VisitedSpace.headPosition M start origin n +
      Resources.TuringSimulation.VisitedSpace.commandOffset
        (Resources.TuringSimulation.VisitedSpace.commandAt M start n)
Resources.TuringSimulation.VisitedSpace.headPosition_step_bounds.{u_1, u_2} {Γ : Type u_1} {Q : Type u_2} [Inhabited Γ]
  [Inhabited Q] (M : Turing.TM0.Machine Γ Q) (start : Turing.TM0.Cfg Γ Q) (origin : ℤ) (n : ℕ) :
  Resources.TuringSimulation.VisitedSpace.headPosition M start origin n - 1 ≤
      Resources.TuringSimulation.VisitedSpace.headPosition M start origin (n + 1) ∧
    Resources.TuringSimulation.VisitedSpace.headPosition M start origin (n + 1) ≤
      Resources.TuringSimulation.VisitedSpace.headPosition M start origin n + 1
Resources.TuringSimulation.VisitedSpace.headPosition_bounds.{u_1, u_2} {Γ : Type u_1} {Q : Type u_2} [Inhabited Γ]
  [Inhabited Q] (M : Turing.TM0.Machine Γ Q) (start : Turing.TM0.Cfg Γ Q) (origin : ℤ) (n : ℕ) :
  origin - ↑n ≤ Resources.TuringSimulation.VisitedSpace.headPosition M start origin n ∧
    Resources.TuringSimulation.VisitedSpace.headPosition M start origin n ≤ origin + ↑n
Resources.TuringSimulation.VisitedSpace.visitedCells.{u_1, u_2} {Γ : Type u_1} {Q : Type u_2} [Inhabited Γ]
  [Inhabited Q] (M : Turing.TM0.Machine Γ Q) (start : Turing.TM0.Cfg Γ Q) (origin : ℤ) (T : ℕ) : Finset ℤ
Resources.TuringSimulation.VisitedSpace.mem_visitedCells.{u_1, u_2} {Γ : Type u_1} {Q : Type u_2} [Inhabited Γ]
  [Inhabited Q] (M : Turing.TM0.Machine Γ Q) (start : Turing.TM0.Cfg Γ Q) (origin : ℤ) (T : ℕ) (x : ℤ) :
  x ∈ Resources.TuringSimulation.VisitedSpace.visitedCells M start origin T ↔
    ∃ i ≤ T,
      (Resources.TuringSimulation.VisitedSpace.cfgAt M start i).isSome = true ∧
        Resources.TuringSimulation.VisitedSpace.headPosition M start origin i = x
Resources.TuringSimulation.VisitedSpace.live_head_mem_visitedCells.{u_1, u_2} {Γ : Type u_1} {Q : Type u_2}
  [Inhabited Γ] [Inhabited Q] (M : Turing.TM0.Machine Γ Q) (start c : Turing.TM0.Cfg Γ Q) (origin : ℤ) (i T : ℕ)
  (hi : i ≤ T) (hc : Resources.TuringSimulation.VisitedSpace.cfgAt M start i = some c) :
  Resources.TuringSimulation.VisitedSpace.headPosition M start origin i ∈
    Resources.TuringSimulation.VisitedSpace.visitedCells M start origin T
