Examples.RotationCertificateFrontEndStreamTapeMachine.Ordinary.fixed_program_all_pairs
  (input cert : Resources.BinaryCounter.Bits) :
  ∃ finish,
    Nonempty
        (StateTransition.EvalsToInTime
          (Turing.TM0.step
            (Resources.RotationCertificate.FrontEndStreamMachine.ordinaryMachine
              Examples.RotationCertificateFrontEndStreamTapeMachine.Ordinary.haltCaller true))
          (Turing.TM0.init
            (Examples.RotationCertificateFrontEndStreamTapeMachine.Ordinary.fixedInput
              (Resources.RotationCertificate.BitPairFraming.frame input cert)))
          (some finish)
          (Polynomial.eval (List.length input + List.length cert)
            (Resources.RotationCertificate.FrontEndStreamMachine.ordinaryPairTimePolynomial
              (Resources.RotationCertificate.FrontEndStreamMachine.tapeActionBound
                Examples.RotationCertificateFrontEndStreamTapeMachine.Ordinary.haltCaller)))) ∧
      finish.Tape =
          Turing.Tape.mk₁
            [Examples.RotationCertificateFrontEndStreamTapeMachine.Ordinary.fixedBit
                (Resources.RotationCertificate.verifyBitsRun input cert).1] ∧
        Turing.TM0.step
            (Resources.RotationCertificate.FrontEndStreamMachine.ordinaryMachine
              Examples.RotationCertificateFrontEndStreamTapeMachine.Ordinary.haltCaller true)
            finish =
          none
