Examples.RotationCertificateFrontEndStreamTapeMachine.CertificateTime.empty_instance_has_an_actual_finite_primitive_witness
  {K Λ R : Type} {Γ : K → Type} [DecidableEq K] [Fintype K] [Fintype Λ] [Fintype R] [(k : K) → Fintype (Γ k)]
  (caller : Λ → Resources.RotationCertificate.FrontEndStreamMachine.Statement Γ Λ R) (initial : R) :
  let tm := Resources.RotationCertificate.FrontEndStreamMachine.machine caller initial;
  have this := Resources.TuringSimulation.StackToTape.Package.controlInhabited tm;
  ∃ cert target,
    List.length cert ≤ 400 ∧
      List.length
            (Resources.RotationCertificate.BitPairFraming.frame
              (Resources.RotationCertificate.wordBits
                (Resources.RotationCertificate.inputCode ↑RotationDistanceExample.empty ↑RotationDistanceExample.empty
                  []))
              cert) ≤
          441 ∧
        Turing.TM2to1.TrCfg (Turing.haltList tm [true]) target ∧
          Nonempty
            (StateTransition.EvalsToInTime
              (Turing.TM0.step (Resources.TuringSimulation.StackToTape.Package.closedMachine tm))
              (Turing.TM0.init
                (Turing.TM2to1.trInit tm.k₀
                  (Resources.RotationCertificate.BitPairFraming.frame
                    (Resources.RotationCertificate.wordBits
                      (Resources.RotationCertificate.inputCode ↑RotationDistanceExample.empty
                        ↑RotationDistanceExample.empty []))
                    cert)))
              (some
                (Resources.TuringSimulation.StackToTape.Package.mapCfg tm
                  (Turing.TM1to0.trCfg
                    (Turing.TM2to1.tr (Resources.RotationCertificate.FrontEndStreamMachine.program caller)) target)))
              (Resources.RotationCertificate.FrontEndStreamMachine.encodedPrimitiveTimeBound
                (Resources.RotationCertificate.FrontEndStreamMachine.tapeActionBound caller) 441))
