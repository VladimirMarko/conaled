Resources.RotationCertificate.FrontEndStreamMachine.related_controller_halt_observation {K Λ R : Type} {Γ : K → Type}
  [DecidableEq K] [Fintype K] [Fintype Λ] [Fintype R] [(k : K) → Fintype (Γ k)]
  (caller : Λ → Resources.RotationCertificate.FrontEndStreamMachine.Statement Γ Λ R) (initial : R) (answer : Bool)
  (target :
    Turing.TM1.Cfg
      (Turing.TM2to1.Γ' (Resources.RotationCertificate.FrontEndStreamMachine.StackId K)
        (Resources.RotationCertificate.FrontEndStreamMachine.alphabet Γ))
      (Turing.TM2to1.Λ' (Resources.RotationCertificate.FrontEndStreamMachine.StackId K)
        (Resources.RotationCertificate.FrontEndStreamMachine.alphabet Γ)
        (Resources.RotationCertificate.FrontEndStreamMachine.Label Λ)
        (Resources.RotationCertificate.FrontEndStreamMachine.Registers R))
      (Resources.RotationCertificate.FrontEndStreamMachine.Registers R))
  (related :
    Turing.TM2to1.TrCfg
      (Turing.haltList (Resources.RotationCertificate.FrontEndStreamMachine.machine caller initial) [answer]) target) :
  target.l = none ∧
    target.var = Resources.RotationCertificate.FrontEndStreamMachine.initialRegisters initial ∧
      target.Tape.head.1 = true ∧
        target.Tape.head.2 (Resources.RotationCertificate.FrontEndStreamMachine.machine caller initial).k₀ = none ∧
          target.Tape.head.2 (Resources.RotationCertificate.FrontEndStreamMachine.machine caller initial).k₁ =
            some answer
Resources.RotationCertificate.FrontEndStreamMachine.related_finite_primitive_halt_head {K Λ R : Type} {Γ : K → Type}
  [DecidableEq K] [Fintype K] [Fintype Λ] [Fintype R] [(k : K) → Fintype (Γ k)]
  (caller : Λ → Resources.RotationCertificate.FrontEndStreamMachine.Statement Γ Λ R) (initial : R) (answer : Bool)
  (target :
    Turing.TM1.Cfg
      (Turing.TM2to1.Γ' (Resources.RotationCertificate.FrontEndStreamMachine.StackId K)
        (Resources.RotationCertificate.FrontEndStreamMachine.alphabet Γ))
      (Turing.TM2to1.Λ' (Resources.RotationCertificate.FrontEndStreamMachine.StackId K)
        (Resources.RotationCertificate.FrontEndStreamMachine.alphabet Γ)
        (Resources.RotationCertificate.FrontEndStreamMachine.Label Λ)
        (Resources.RotationCertificate.FrontEndStreamMachine.Registers R))
      (Resources.RotationCertificate.FrontEndStreamMachine.Registers R))
  (related :
    Turing.TM2to1.TrCfg
      (Turing.haltList (Resources.RotationCertificate.FrontEndStreamMachine.machine caller initial) [answer]) target) :
  let tm := Resources.RotationCertificate.FrontEndStreamMachine.machine caller initial;
  have finish :=
    Resources.TuringSimulation.StackToTape.Package.mapCfg tm
      (Turing.TM1to0.trCfg (Turing.TM2to1.tr (Resources.RotationCertificate.FrontEndStreamMachine.program caller))
        target);
  finish.Tape.head.1 = true ∧ finish.Tape.head.2 tm.k₀ = none ∧ finish.Tape.head.2 tm.k₁ = some answer
Resources.RotationCertificate.FrontEndStreamMachine.finite_encoded_primitive_run_observed {K Λ R : Type} {Γ : K → Type}
  [DecidableEq K] [Fintype K] [Fintype Λ] [Fintype R] [(k : K) → Fintype (Γ k)]
  (caller : Λ → Resources.RotationCertificate.FrontEndStreamMachine.Statement Γ Λ R) (initial : R)
  (raw : Resources.BinaryCounter.Bits) :
  let tm := Resources.RotationCertificate.FrontEndStreamMachine.machine caller initial;
  have this := Resources.TuringSimulation.StackToTape.Package.controlInhabited tm;
  ∃ target,
    Turing.TM2to1.TrCfg (Turing.haltList tm [Resources.RotationCertificate.BitPairFraming.verifyFramed raw]) target ∧
      have finish :=
        Resources.TuringSimulation.StackToTape.Package.mapCfg tm
          (Turing.TM1to0.trCfg (Turing.TM2to1.tr (Resources.RotationCertificate.FrontEndStreamMachine.program caller))
            target);
      finish.Tape.head.1 = true ∧
        finish.Tape.head.2 tm.k₀ = none ∧
          finish.Tape.head.2 tm.k₁ = some (Resources.RotationCertificate.BitPairFraming.verifyFramed raw) ∧
            Nonempty
              (StateTransition.EvalsToInTime
                (Turing.TM0.step (Resources.TuringSimulation.StackToTape.Package.closedMachine tm))
                (Turing.TM0.init (Turing.TM2to1.trInit tm.k₀ raw)) (some finish)
                (Resources.RotationCertificate.FrontEndStreamMachine.encodedPrimitiveTimeBound
                  (Resources.RotationCertificate.FrontEndStreamMachine.tapeActionBound caller) (List.length raw)))
