Resources.RotationCertificate.FrontEndStreamMachine.encodedPrimitiveTimeBound_frame_le (A : ℕ)
  (input cert : Resources.BinaryCounter.Bits) :
  Resources.RotationCertificate.FrontEndStreamMachine.encodedPrimitiveTimeBound A
      (List.length (Resources.RotationCertificate.BitPairFraming.frame input cert)) ≤
    Resources.RotationCertificate.FrontEndStreamMachine.encodedPrimitiveTimeBound A
      (2 * (List.length input + List.length cert + 1))
Resources.RotationCertificate.FrontEndStreamMachine.binaryYes_small_finite_primitive_run {K Λ R : Type} {Γ : K → Type}
  [DecidableEq K] [Fintype K] [Fintype Λ] [Fintype R] [(k : K) → Fintype (Γ k)]
  (caller : Λ → Resources.RotationCertificate.FrontEndStreamMachine.Statement Γ Λ R) (initial : R)
  (input : Resources.BinaryCounter.Bits) (yes : Resources.RotationCertificate.BinaryYes input) :
  let tm := Resources.RotationCertificate.FrontEndStreamMachine.machine caller initial;
  have this := Resources.TuringSimulation.StackToTape.Package.controlInhabited tm;
  ∃ cert target,
    List.length cert ≤ List.length input ^ 2 ∧
      List.length (Resources.RotationCertificate.BitPairFraming.frame input cert) ≤ (List.length input + 1) ^ 2 ∧
        Turing.TM2to1.TrCfg (Turing.haltList tm [true]) target ∧
          Nonempty
            (StateTransition.EvalsToInTime
              (Turing.TM0.step (Resources.TuringSimulation.StackToTape.Package.closedMachine tm))
              (Turing.TM0.init
                (Turing.TM2to1.trInit tm.k₀ (Resources.RotationCertificate.BitPairFraming.frame input cert)))
              (some
                (Resources.TuringSimulation.StackToTape.Package.mapCfg tm
                  (Turing.TM1to0.trCfg
                    (Turing.TM2to1.tr (Resources.RotationCertificate.FrontEndStreamMachine.program caller)) target)))
              (Resources.RotationCertificate.FrontEndStreamMachine.encodedPrimitiveTimeBound
                (Resources.RotationCertificate.FrontEndStreamMachine.tapeActionBound caller)
                ((List.length input + 1) ^ 2)))
