      (Resources.TuringSimulation.VisitedSpace.visitedCells M start origin i).card ≤ B + 1 ∧
        (Resources.TuringSimulation.VisitedSpace.inputVisitedCells M start origin N i).card ≤ max N 1 + B ∧
          (Resources.TuringSimulation.VisitedSpace.visitedInterval M start origin N i).card ≤ max N 1 + B
