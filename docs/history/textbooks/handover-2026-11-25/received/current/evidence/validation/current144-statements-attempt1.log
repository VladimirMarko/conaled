Resources.TuringSimulation.VisitedSpace.init_nonblank_mem_interval_of_run.{u_1, u_2} {Γ : Type u_1} {Q : Type u_2}
  [Inhabited Γ] [Inhabited Q] (M : Turing.TM0.Machine Γ Q) (input : List Γ) (endpoint : Option (Turing.TM0.Cfg Γ Q))
  (B : ℕ) (run : StateTransition.EvalsToInTime (Turing.TM0.step M) (Turing.TM0.init input) endpoint B) (origin : ℤ)
  (i : ℕ) :
  i ≤ run.steps →
    ∀ (finish : Turing.TM0.Cfg Γ Q),
      Resources.TuringSimulation.VisitedSpace.cfgAt M (Turing.TM0.init input) i = some finish →
        ∀ (x : ℤ),
          finish.Tape.nth
                (x - Resources.TuringSimulation.VisitedSpace.headPosition M (Turing.TM0.init input) origin i) ≠
              default →
            x ∈ Resources.TuringSimulation.VisitedSpace.visitedInterval M (Turing.TM0.init input) origin input.length i
Resources.RotationCertificate.CertificateCorrespondence.binaryYes_iff_encoded_distance
  (input : Resources.BinaryCounter.Bits) :
  Resources.RotationCertificate.BinaryYes input ↔
    ∃ n s t bs,
      input = Resources.RotationCertificate.wordBits (Resources.RotationCertificate.inputCode (↑s) (↑t) bs) ∧
        s.distance t ≤ Resources.BinaryCounter.value bs
Resources.RotationCertificate.CertificateCorrespondence.binaryYes_code_iff {n : ℕ} (s t : Trees.Rotations.Shape n)
  (bs : Resources.BinaryCounter.Bits) :
  Resources.RotationCertificate.BinaryYes
      (Resources.RotationCertificate.wordBits (Resources.RotationCertificate.inputCode (↑s) (↑t) bs)) ↔
    s.distance t ≤ Resources.BinaryCounter.value bs
Resources.RotationCertificate.CertificateCorrespondence.encoded_instance_length {n : ℕ} (s t : Trees.Rotations.Shape n)
  (bs : Resources.BinaryCounter.Bits) :
  List.length (Resources.RotationCertificate.wordBits (Resources.RotationCertificate.inputCode (↑s) (↑t) bs)) =
    16 * n + 4 * List.length bs + 20
Resources.RotationCertificate.CertificateCorrespondence.verifyFramed_code_iff_trace (source target : BinaryTree Unit)
  (bs cert : Resources.BinaryCounter.Bits) :
  Resources.RotationCertificate.BitPairFraming.verifyFramed
        (Resources.RotationCertificate.BitPairFraming.frame
          (Resources.RotationCertificate.wordBits (Resources.RotationCertificate.inputCode source target bs)) cert) =
      true ↔
    ∃ moves,
      cert = Resources.RotationCertificate.wordBits (Resources.RotationCertificate.certCode moves) ∧
        Trees.Rotations.applyMoves? moves source = some target ∧ moves.length ≤ Resources.BinaryCounter.value bs
Resources.RotationCertificate.CertificateCorrespondence.binaryYes_iff_exists_small_framed_certificate
  (input : Resources.BinaryCounter.Bits) :
  Resources.RotationCertificate.BinaryYes input ↔
    ∃ cert,
      List.length cert ≤ List.length input ^ 2 ∧
        List.length (Resources.RotationCertificate.BitPairFraming.frame input cert) ≤ (List.length input + 1) ^ 2 ∧
          Resources.RotationCertificate.BitPairFraming.verifyFramed
              (Resources.RotationCertificate.BitPairFraming.frame input cert) =
            true
Resources.RotationCertificate.CertificateCorrespondence.distance_le_iff_exists_small_framed_certificate {n : ℕ}
  (s t : Trees.Rotations.Shape n) (bs : Resources.BinaryCounter.Bits) :
  s.distance t ≤ Resources.BinaryCounter.value bs ↔
    ∃ cert,
      List.length cert ≤
          List.length (Resources.RotationCertificate.wordBits (Resources.RotationCertificate.inputCode (↑s) (↑t) bs)) ^
            2 ∧
        List.length
              (Resources.RotationCertificate.BitPairFraming.frame
                (Resources.RotationCertificate.wordBits (Resources.RotationCertificate.inputCode (↑s) (↑t) bs)) cert) ≤
            (List.length
                  (Resources.RotationCertificate.wordBits (Resources.RotationCertificate.inputCode (↑s) (↑t) bs)) +
                1) ^
              2 ∧
          Resources.RotationCertificate.BitPairFraming.verifyFramed
              (Resources.RotationCertificate.BitPairFraming.frame
                (Resources.RotationCertificate.wordBits (Resources.RotationCertificate.inputCode (↑s) (↑t) bs)) cert) =
            true
Resources.RotationCertificate.CertificateCorrespondence.not_binaryYes_nil : ¬Resources.RotationCertificate.BinaryYes []
Resources.RotationCertificate.CertificateCorrespondence.binaryYes_empty_shapes (s t : Trees.Rotations.Shape 0)
  (bs : Resources.BinaryCounter.Bits) :
  Resources.RotationCertificate.BinaryYes
    (Resources.RotationCertificate.wordBits (Resources.RotationCertificate.inputCode (↑s) (↑t) bs))
Resources.RotationCertificate.CertificateCorrespondence.binaryYes_singleton_shapes (s t : Trees.Rotations.Shape 1)
  (bs : Resources.BinaryCounter.Bits) :
  Resources.RotationCertificate.BinaryYes
    (Resources.RotationCertificate.wordBits (Resources.RotationCertificate.inputCode (↑s) (↑t) bs))
Examples.RotationCertificateCorrespondence.empty_zero_width_case :
  List.length
        (Resources.RotationCertificate.wordBits
          (Resources.RotationCertificate.inputCode ↑RotationDistanceExample.empty ↑RotationDistanceExample.empty [])) =
      20 ∧
    [].length = 0 ∧
      List.length
            (Resources.RotationCertificate.BitPairFraming.frame
              (Resources.RotationCertificate.wordBits
                (Resources.RotationCertificate.inputCode ↑RotationDistanceExample.empty ↑RotationDistanceExample.empty
                  []))
              []) =
          41 ∧
        Resources.RotationCertificate.BitPairFraming.verifyFramed
            (Resources.RotationCertificate.BitPairFraming.frame
              (Resources.RotationCertificate.wordBits
                (Resources.RotationCertificate.inputCode ↑RotationDistanceExample.empty ↑RotationDistanceExample.empty
                  []))
              []) =
          true
Examples.RotationCertificateCorrespondence.empty_width_two_case :
  Resources.BinaryCounter.value [false, false] = 0 ∧
    List.length
          (Resources.RotationCertificate.wordBits
            (Resources.RotationCertificate.inputCode ↑RotationDistanceExample.empty ↑RotationDistanceExample.empty
              [false, false])) =
        28 ∧
      [].length = 0 ∧
        List.length
              (Resources.RotationCertificate.BitPairFraming.frame
                (Resources.RotationCertificate.wordBits
                  (Resources.RotationCertificate.inputCode ↑RotationDistanceExample.empty ↑RotationDistanceExample.empty
                    [false, false]))
                []) =
            57 ∧
          Resources.RotationCertificate.BitPairFraming.verifyFramed
              (Resources.RotationCertificate.BitPairFraming.frame
                (Resources.RotationCertificate.wordBits
                  (Resources.RotationCertificate.inputCode ↑RotationDistanceExample.empty ↑RotationDistanceExample.empty
                    [false, false]))
                []) =
            true
Examples.RotationCertificateCorrespondence.two_node_zero_threshold_not_in_language :
  ¬Resources.RotationCertificate.BinaryYes
      (Resources.RotationCertificate.wordBits
        (Resources.RotationCertificate.inputCode ↑RotationDistanceExample.leftTwo ↑RotationDistanceExample.rightTwo []))
Examples.RotationCertificateCorrespondence.two_node_zero_threshold_rejects_every_certificate
  (cert : Resources.BinaryCounter.Bits) :
  Resources.RotationCertificate.BitPairFraming.verifyFramed
      (Resources.RotationCertificate.BitPairFraming.frame
        (Resources.RotationCertificate.wordBits
          (Resources.RotationCertificate.inputCode ↑RotationDistanceExample.leftTwo ↑RotationDistanceExample.rightTwo
            []))
        cert) =
    false
Examples.RotationCertificateCorrespondence.two_node_zero_threshold_case :
  List.length
        (Resources.RotationCertificate.wordBits
          (Resources.RotationCertificate.inputCode ↑RotationDistanceExample.leftTwo ↑RotationDistanceExample.rightTwo
            [])) =
      52 ∧
    List.length
          (Resources.RotationCertificate.wordBits
            (Resources.RotationCertificate.certCode [RotationDistanceExample.rootRight])) =
        8 ∧
      List.length
            (Resources.RotationCertificate.BitPairFraming.frame
              (Resources.RotationCertificate.wordBits
                (Resources.RotationCertificate.inputCode ↑RotationDistanceExample.leftTwo
                  ↑RotationDistanceExample.rightTwo []))
              (Resources.RotationCertificate.wordBits
