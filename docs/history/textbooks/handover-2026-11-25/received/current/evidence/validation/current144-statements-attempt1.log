      Polynomial.eval 0 (Resources.RotationCertificate.FrontEndStreamMachine.encodedPrimitiveTimePolynomial 1) = 756 ∧
        Polynomial.eval 1 (Resources.RotationCertificate.FrontEndStreamMachine.encodedPrimitiveTimePolynomial 1) = 1269
