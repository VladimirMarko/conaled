  "source": "import Init\n\ntheorem smoke_zero_add (n : Nat) : 0 + n = n := by\n  induction n with\n  | zero => rfl\n  | succ n ih => exact congrArg Nat.succ ih\n\ntheorem smoke_map_length {\u03b1 \u03b2 : Type} (f : \u03b1 \u2192 \u03b2) (xs : List \u03b1) :\n    (xs.map f).length = xs.length := by\n  induction xs with\n  | nil => rfl\n  | cons a xs ih => exact congrArg Nat.succ ih\n\n#print axioms smoke_zero_add\n#print axioms smoke_map_length\n",
