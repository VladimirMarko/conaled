+++ b/Examples/PermutationMinimum.lean
@@ -0,0 +1,127 @@
+import Applications.Probability.PermutationMinimum
+import Examples.PermutationMinimumBoundary
+import Mathlib.Tactic
+
+/-!
+# Subset minima under one global random ranking
+
+One uniformly sampled permutation of three key indices determines every
+priority in this example. The two subsets `{0, 1}` and `{1, 2}` share index
+one and the same sampled ranking. Each subset gives that index probability
+`1/2` of being first, while the intersection has probability `1/3`.
+
+These claims use the public minimum law and its event-intersection bridge.
+They do not replace the shared environment by independently chosen subset
+orders. A second specialization uses injective, nonmonotone integer priorities
+with a negative value and unequal gaps: numeric priority values need not be
+ordinal positions, and the priority target need not be finite.
+
+The examples supply no treap construction or sorting execution. Those clients
+still need deterministic minimum/root/comparison bridges and their actual
+conditional sampling and resource observations.
+-/
+
+set_option autoImplicit false
+set_option warningAsError true
+
+namespace Examples.PermutationMinimum
+
+open MeasureTheory ProbabilityTheory
+open Applications.Probability.PermutationMinimum
+open scoped ENNReal
+
+local instance : MeasurableSpace (Equiv.Perm (Fin 3)) := ⊤
+local instance : MeasurableSingletonClass (Equiv.Perm (Fin 3)) :=
+  ⟨fun _ => trivial⟩
+
+/-- One common random permutation, mapping key indices to priority labels. -/
+noncomputable def law : Measure (Equiv.Perm (Fin 3)) := uniformOn Set.univ
+
+local instance : IsProbabilityMeasure law := by
+  unfold law
+  infer_instance
+
+def firstSubset : Finset (Fin 3) := {0, 1}
+def secondSubset : Finset (Fin 3) := {1, 2}
+
+theorem first_minimum_mass :
+    law (minimumEvent id firstSubset 1) = 1 / 2 := by
+  simpa [law, firstSubset, one_div] using
+    (uniformOn_minimumEvent (id : Fin 3 → Fin 3) Function.injective_id
+      firstSubset 1 (by simp [firstSubset]))
+
+theorem second_minimum_mass :
+    law (minimumEvent id secondSubset 1) = 1 / 2 := by
+  simpa [law, secondSubset, one_div] using
+    (uniformOn_minimumEvent (id : Fin 3 → Fin 3) Function.injective_id
+      secondSubset 1 (by simp [secondSubset]))
+
+/-- The two observations ask about the same minimum on the union. -/
+theorem overlap_event :
+    minimumEvent id firstSubset 1 ∩ minimumEvent id secondSubset 1 =
+      minimumEvent id Finset.univ 1 := by
+  rw [minimumEvent_inter id firstSubset secondSubset 1
+    (by simp [firstSubset]) (by simp [secondSubset])]
+  have hcover : firstSubset ∪ secondSubset = Finset.univ := by
+    ext a
+    fin_cases a <;> simp [firstSubset, secondSubset]
+  rw [hcover]
+
+theorem full_minimum_mass (a : Fin 3) :
+    law (minimumEvent id Finset.univ a) = 1 / 3 := by
+  simpa [law, one_div] using
+    (uniformOn_minimumEvent (id : Fin 3 → Fin 3) Function.injective_id
+      Finset.univ a (Finset.mem_univ a))
+
+theorem overlap_mass :
+    law (minimumEvent id firstSubset 1 ∩ minimumEvent id secondSubset 1) =
+      1 / 3 := by
+  rw [overlap_event]
+  exact full_minimum_mass 1
+
+theorem marginal_product :
+    law (minimumEvent id firstSubset 1) *
+      law (minimumEvent id secondSubset 1) = 1 / 4 := by
+  rw [first_minimum_mass, second_minimum_mass]
+  simpa only [one_div, show (2 : ℝ≥0∞) * 2 = 4 by norm_num] using
+    (ENNReal.mul_inv (a := (2 : ℝ≥0∞)) (b := 2)
+      (Or.inl (by norm_num)) (Or.inr (by norm_num))).symm
+
+/-- Uniform marginals on overlapping subsets do not assert their independence. -/
+theorem overlap_mass_ne_product :
+    law (minimumEvent id firstSubset 1 ∩ minimumEvent id secondSubset 1) ≠
+      law (minimumEvent id firstSubset 1) *
+        law (minimumEvent id secondSubset 1) := by
+  rw [overlap_mass, marginal_product]
+  norm_num [← ENNReal.coe_div]
+
+theorem singleton_minimum_mass (a : Fin 3) :
+    law (minimumEvent id {a} a) = 1 := by
+  simpa only [law, Finset.card_singleton, Nat.cast_one, inv_one] using
+    (uniformOn_minimumEvent (id : Fin 3 → Fin 3) Function.injective_id
+      {a} a (Finset.mem_singleton_self a))
+
+/-- Distinct integer labels with a negative value and unequal ordered gaps. -/
+def spacedPriority (a : Fin 3) : Int :=
+  if a.val = 0 then -7 else if a.val = 1 then 100 else 4
+
+theorem spacedPriority_values :
+    spacedPriority 0 = -7 ∧ spacedPriority 1 = 100 ∧ spacedPriority 2 = 4 := by
+  decide
+
+theorem spacedPriority_injective : Function.Injective spacedPriority := by
+  decide
+
+theorem spacedPriority_not_monotone : ¬ Monotone spacedPriority := by
+  intro h
+  have h12 := h (show (1 : Fin 3) ≤ 2 by decide)
+  norm_num [spacedPriority] at h12
+
+/-- Only injectivity and the target's linear order matter for the minimum law. -/
+theorem spaced_minimum_mass :
+    law (minimumEvent spacedPriority secondSubset 2) = 1 / 2 := by
+  simpa [law, secondSubset, one_div] using
+    (uniformOn_minimumEvent spacedPriority spacedPriority_injective
+      secondSubset 2 (by simp [secondSubset]))
+
+end Examples.PermutationMinimum
diff --git a/Examples/PermutationMinimumBoundary.lean b/Examples/PermutationMinimumBoundary.lean
new file mode 100644
index 0000000000000000000000000000000000000000..2e7ca462be60d0e3c484573950b194cce532d26c
--- /dev/null
+++ b/Examples/PermutationMinimumBoundary.lean
@@ -0,0 +1,113 @@
+import Applications.Probability.PermutationMinimum
+import Mathlib.Tactic.FinCases
+
+/-!
+# Empty, outsider and tied-priority boundaries for uniform permutation minima
+
+The raw outsider comparison is connected to a genuine full-set minimum, so its
+probability uses the public uniform-permutation theorem. Empty and tied events
+exercise the event definition without asserting that the theorem applies when
+membership or injectivity is absent.
+-/
+
+set_option autoImplicit false
+set_option warningAsError true
+
+open MeasureTheory ProbabilityTheory
+open Applications.Probability.PermutationMinimum
+open scoped ENNReal
+
+namespace Examples.PermutationMinimumBoundary
+
+local instance : MeasurableSpace (Equiv.Perm Empty) := ⊤
+local instance : MeasurableSpace (Equiv.Perm (Fin 2)) := ⊤
+
+/-- The empty index universe still has its identity permutation as a sample. -/
+theorem empty_index_normalized :
+    uniformOn (Set.univ : Set (Equiv.Perm Empty)) Set.univ = 1 := by
+  exact uniformOn_self Set.finite_univ ⟨Equiv.refl Empty, Set.mem_univ _⟩
+
+/-- An empty subset has no minimum member, even when an index is available. -/
+theorem empty_subset_event :
+    minimumEvent (id : Fin 2 → Fin 2) ∅ 0 = ∅ :=
+  minimumEvent_empty _ _
+
+theorem empty_subset_mass :
+    uniformOn Set.univ (minimumEvent (id : Fin 2 → Fin 2) ∅ 0) = 0 := by
+  rw [empty_subset_event]
+  exact measure_empty
+
+/-- Candidate 0 is outside the singleton subset {1}. -/
+theorem outsider_event_empty :
+    minimumEvent (id : Fin 2 → Fin 2) {1} 0 = ∅ :=
+  minimumEvent_of_not_mem _ _ _ (by decide)
+
+theorem outsider_mass :
+    uniformOn Set.univ (minimumEvent (id : Fin 2 → Fin 2) {1} 0) = 0 := by
+  rw [outsider_event_empty]
+  exact measure_empty
+
+/-- Dropping membership leaves only the comparison of two assigned priorities. -/
+def outsiderComparison : Set (Equiv.Perm (Fin 2)) :=
+  {π | π 0 ≤ π 1}
+
+/-- That comparison is the event that 0 is the minimum of the full pair. -/
+theorem outsiderComparison_eq_full_minimum :
+    outsiderComparison =
+      minimumEvent (id : Fin 2 → Fin 2) Finset.univ 0 := by
+  ext π
+  change (π 0 ≤ π 1) ↔
+    ((0 : Fin 2) ∈ (Finset.univ : Finset (Fin 2)) ∧
+      ∀ b ∈ (Finset.univ : Finset (Fin 2)), π 0 ≤ π b)
+  constructor
+  · intro h
+    refine ⟨Finset.mem_univ _, ?_⟩
+    intro b _
+    fin_cases b
+    · exact le_rfl
+    · exact h
+  · intro h
+    exact h.2 1 (Finset.mem_univ _)
+
+/-- The mass comes from the public minimum law on the full two-member set. -/
+theorem outsiderComparison_mass :
+    uniformOn Set.univ outsiderComparison = (2 : ℝ≥0∞)⁻¹ := by
+  rw [outsiderComparison_eq_full_minimum]
+  simpa using
+    (uniformOn_minimumEvent (id : Fin 2 → Fin 2) Function.injective_id
+      (Finset.univ : Finset (Fin 2)) 0 (Finset.mem_univ _))
+
+/-- The outsider comparison does not have the singleton reciprocal mass one. -/
+theorem outsiderComparison_ne_singleton_inverse :
+    uniformOn Set.univ outsiderComparison ≠
+      (({1} : Finset (Fin 2)).card : ℝ≥0∞)⁻¹ := by
+  rw [outsiderComparison_mass, Finset.card_singleton, Nat.cast_one, inv_one]
+  exact ne_of_lt ENNReal.one_half_lt_one
+
+/-- Both keys receive the same priority, regardless of the sampled permutation. -/
+def tiedPriority : Fin 2 → ℕ := fun _ => 0
+
+theorem tiedPriority_not_injective : ¬ Function.Injective tiedPriority := by
+  intro h
+  have h01 : (0 : Fin 2) = 1 := h rfl
+  exact (by decide : (0 : Fin 2) ≠ 1) h01
+
+/-- Every member is a non-strict minimum on every sample when priorities tie. -/
+theorem tied_event_univ (a : Fin 2) :
+    minimumEvent tiedPriority Finset.univ a = Set.univ := by
+  ext π
+  simp [minimumEvent, tiedPriority]
+
+theorem tied_mass (a : Fin 2) :
+    uniformOn Set.univ (minimumEvent tiedPriority Finset.univ a) = 1 := by
+  rw [tied_event_univ]
+  exact uniformOn_self Set.finite_univ ⟨Equiv.refl (Fin 2), Set.mem_univ _⟩
+
+/-- Without injectivity, the reciprocal-cardinality conclusion fails. -/
+theorem tied_mass_ne_half (a : Fin 2) :
+    uniformOn Set.univ (minimumEvent tiedPriority Finset.univ a) ≠
+      (2 : ℝ≥0∞)⁻¹ := by
+  rw [tied_mass]
+  exact ne_of_gt ENNReal.one_half_lt_one
+
+end Examples.PermutationMinimumBoundary
