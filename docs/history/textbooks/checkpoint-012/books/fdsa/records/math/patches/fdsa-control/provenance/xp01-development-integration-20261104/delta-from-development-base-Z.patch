+theorem run_cost_le_map_of_invariant [AddZero C] [AddMonoid D] [Preorder D]
+    [AddLeftMono D] [AddRightMono D]
+    (step : ι → σ → σ × C) (charge : ι → σ → D) (potential : σ → D)
+    (h : C →+ D) (P : σ → Prop)
+    (closed : ∀ i s, P s → P (step i s).1)
+    (hstep : ∀ i s, P s →
