+import Mathlib.Algebra.Order.Archimedean.Real.Basic
+import Mathlib.Algebra.Order.Floor.Semiring
+import Mathlib.Tactic.Linarith
+
+/-! Rounded affine child sizes and the sharp one-step estimate in FDSA §3.5.
+
+The child sizes use Mathlib's natural ceiling, which is integer ceiling followed
+by conversion to Nat. Negative arguments therefore truncate to zero. The source
+offsets and constant toll are arbitrary reals. The induction intercept is also
+unrestricted; no nonnegativity assumption on the scalar function is introduced.
+
+These statements reconstruct (3.16)--(3.18) and the exact rounded recurrence
+step. The slope condition is non-strict, correcting the printed strict sign.
+The full induction and the existence/natural-valued corollaries are separate
+remaining obligations. Source: FDSA, July 27, 2026, printed pp. 41--43;
+Manuel Eberl's Selection.thy at f86f290225eebcc52c1ae7dba2e098f405f51c21.
+-/
+set_option autoImplicit false
+set_option warningAsError true
+
+namespace Resources.RoundedRecurrence
+
+/-- The natural ceiling has the required upper bound after replacing a signed
+offset by its nonnegative part. The nonpositive-argument branch is explicit. -/
+theorem ceil_affine_lt_add_one (a b : ℝ) (n : Nat) (ha : 0 ≤ a) :
+    (⌈a * (n : ℝ) + b⌉₊ : ℝ) < a * (n : ℝ) + max 0 b + 1 := by
+  by_cases nonpositive : a * (n : ℝ) + b ≤ 0
+  · have truncated : ⌈a * (n : ℝ) + b⌉₊ = 0 := Nat.ceil_eq_zero.mpr nonpositive
+    rw [truncated, Nat.cast_zero]
+    have product_nonneg := mul_nonneg ha (Nat.cast_nonneg n : (0 : ℝ) ≤ (n : ℝ))
+    linarith only [product_nonneg, le_max_left (0 : ℝ) b]
+  · have argument_nonneg : 0 ≤ a * (n : ℝ) + b := (lt_of_not_ge nonpositive).le
+    exact (Nat.ceil_lt_add_one argument_nonneg).trans_le (by
+      linarith only [le_max_right (0 : ℝ) b])
+
+/-- The signed-offset form of either sufficient descent condition in (3.16). -/
+theorem ceil_affine_lt_of_threshold (a b : ℝ) (N n : Nat)
+    (ha : 0 ≤ a) (ha_lt_one : a < 1)
+    (threshold : (max 0 b + 1) / (1 - a) ≤ (N : ℝ)) (large : N < n) :
+    ⌈a * (n : ℝ) + b⌉₊ < n := by
+  have gap : 0 < 1 - a := sub_pos.mpr ha_lt_one
+  have at_cutoff : max 0 b + 1 ≤ (N : ℝ) * (1 - a) :=
+    (div_le_iff₀ gap).mp threshold
+  have after_cutoff : (N : ℝ) * (1 - a) < (n : ℝ) * (1 - a) :=
+    mul_lt_mul_of_pos_right ((Nat.cast_lt (α := ℝ)).mpr large) gap
+  have rounded := ceil_affine_lt_add_one a b n ha
+  apply (Nat.cast_lt (α := ℝ)).mp
+  nlinarith only [at_cutoff, after_cutoff, rounded]
+
+/-- The combined strict cutoff in (3.18) implies both earlier (3.16) thresholds.
+The two offsets may be negative. -/
+theorem thresholds_of_combined_cutoff (a b c d : ℝ) (N : Nat)
+    (ha : 0 < a) (hc : 0 < c) (contract : a + c < 1)
+    (threshold : (max 0 b + max 0 d + 2) / (1 - a - c) < (N : ℝ)) :
+    (max 0 b + 1) / (1 - a) ≤ (N : ℝ) ∧
+      (max 0 d + 1) / (1 - c) ≤ (N : ℝ) := by
+  have gap : 0 < 1 - a - c := by linarith only [contract]
+  have left_gap : 0 < 1 - a := by linarith only [contract, hc]
+  have right_gap : 0 < 1 - c := by linarith only [contract, ha]
+  have combined : max 0 b + max 0 d + 2 < (N : ℝ) * (1 - a - c) :=
+    (div_lt_iff₀ gap).mp threshold
+  constructor
+  · apply (div_le_iff₀ left_gap).mpr
+    nlinarith only [combined, le_max_left (0 : ℝ) d,
+      mul_nonneg hc.le (Nat.cast_nonneg N : (0 : ℝ) ≤ (N : ℝ))]
+  · apply (div_le_iff₀ right_gap).mpr
+    nlinarith only [combined, le_max_left (0 : ℝ) b,
+      mul_nonneg ha.le (Nat.cast_nonneg N : (0 : ℝ) ≤ (N : ℝ))]
+
+/-- Both exact natural-ceiling children decrease beyond the combined cutoff. -/
+theorem ceil_children_lt (a b c d : ℝ) (N n : Nat)
+    (ha : 0 < a) (hc : 0 < c) (contract : a + c < 1)
+    (threshold : (max 0 b + max 0 d + 2) / (1 - a - c) < (N : ℝ))
+    (large : N < n) :
+    ⌈a * (n : ℝ) + b⌉₊ < n ∧ ⌈c * (n : ℝ) + d⌉₊ < n := by
+  have thresholds := thresholds_of_combined_cutoff a b c d N ha hc contract threshold
+  exact ⟨ceil_affine_lt_of_threshold a b N n ha.le
+    (by linarith only [contract, hc]) thresholds.1 large,
+    ceil_affine_lt_of_threshold c d N n hc.le
+      (by linarith only [contract, ha]) thresholds.2 large⟩
+
+/-- The denominator in the source's second slope constraint is positive. -/
+theorem cutoff_denominator_pos (a b c d : ℝ) (N : Nat) (contract : a + c < 1)
+    (threshold : (max 0 b + max 0 d + 2) / (1 - a - c) < (N : ℝ)) :
+    0 < (1 - a - c) * (N : ℝ) - max 0 b - max 0 d - 2 := by
+  have gap : 0 < 1 - a - c := by linarith only [contract]
+  have combined := (div_lt_iff₀ gap).mp threshold
+  nlinarith only [combined]
+
+/-- Non-strict (3.17) suffices. Nonnegativity of C3 follows from C1 ≥ 0 and
+the positive contraction gap, rather than from a restriction on C4 or f. -/
+theorem slope_nonneg_and_margin (a c C1 C3 : ℝ) (contract : a + c < 1)
+    (toll_nonneg : 0 ≤ C1) (slope : C1 / (1 - a - c) ≤ C3) :
+    0 ≤ C3 ∧ 0 ≤ C3 * (1 - a - c) - C1 := by
+  have gap : 0 < 1 - a - c := by linarith only [contract]
+  have quotient_nonneg : 0 ≤ C1 / (1 - a - c) := div_nonneg toll_nonneg gap.le
+  exact ⟨quotient_nonneg.trans slope, sub_nonneg.mpr ((div_le_iff₀ gap).mp slope)⟩
+
+/-- The sharp absorption calculation from (3.18), with a possibly negative
+intercept C4 and arbitrary constant toll C2. -/
+theorem sharp_affine_absorption (a b c d C1 C2 C3 C4 : ℝ) (N n : Nat)
+    (contract : a + c < 1) (toll_nonneg : 0 ≤ C1)
+    (threshold : (max 0 b + max 0 d + 2) / (1 - a - c) < (N : ℝ))
+    (slope : C1 / (1 - a - c) ≤ C3)
+    (absorb : (C1 * (N : ℝ) + C2 + C4) /
+      ((1 - a - c) * (N : ℝ) - max 0 b - max 0 d - 2) ≤ C3)
+    (large : N ≤ n) :
+    (C3 * (a * (n : ℝ) + max 0 b + 1) + C4) +
+      (C3 * (c * (n : ℝ) + max 0 d + 1) + C4) + C1 * (n : ℝ) + C2 ≤
+        C3 * (n : ℝ) + C4 := by
+  have denominator_pos := cutoff_denominator_pos a b c d N contract threshold
+  have at_cutoff := (div_le_iff₀ denominator_pos).mp absorb
+  have margin := (slope_nonneg_and_margin a c C1 C3 contract toll_nonneg slope).2
+  have after_cutoff := mul_le_mul_of_nonneg_left
+    ((Nat.cast_le (α := ℝ)).mpr large) margin
+  nlinarith only [at_cutoff, after_cutoff]
+
+/-- One exact rounded recurrence step consumes the two genuine child bounds.
+No positivity of f, b, d, C2 or C4 is assumed. Strong induction and construction
+of the fixed constants are separate from this local implication. -/
+theorem recurrence_step_le (f : Nat → ℝ) (a b c d C1 C2 C3 C4 : ℝ) (N n : Nat)
+    (ha : 0 ≤ a) (hc : 0 ≤ c) (contract : a + c < 1) (toll_nonneg : 0 ≤ C1)
+    (threshold : (max 0 b + max 0 d + 2) / (1 - a - c) < (N : ℝ))
+    (slope : C1 / (1 - a - c) ≤ C3)
+    (absorb : (C1 * (N : ℝ) + C2 + C4) /
+      ((1 - a - c) * (N : ℝ) - max 0 b - max 0 d - 2) ≤ C3)
+    (large : N ≤ n)
+    (recurrence : f n = f ⌈a * (n : ℝ) + b⌉₊ + f ⌈c * (n : ℝ) + d⌉₊ +
+      C1 * (n : ℝ) + C2)
+    (left_bound : f ⌈a * (n : ℝ) + b⌉₊ ≤ C3 * (⌈a * (n : ℝ) + b⌉₊ : ℝ) + C4)
+    (right_bound : f ⌈c * (n : ℝ) + d⌉₊ ≤ C3 * (⌈c * (n : ℝ) + d⌉₊ : ℝ) + C4) :
+    f n ≤ C3 * (n : ℝ) + C4 := by
+  have nonneg := (slope_nonneg_and_margin a c C1 C3 contract toll_nonneg slope).1
+  have left_size := mul_le_mul_of_nonneg_left (ceil_affine_lt_add_one a b n ha).le nonneg
+  have right_size := mul_le_mul_of_nonneg_left (ceil_affine_lt_add_one c d n hc).le nonneg
+  have absorption := sharp_affine_absorption a b c d C1 C2 C3 C4 N n
+    contract toll_nonneg threshold slope absorb large
+  nlinarith only [recurrence, left_bound, right_bound, left_size, right_size, absorption]
+
+end Resources.RoundedRecurrence
