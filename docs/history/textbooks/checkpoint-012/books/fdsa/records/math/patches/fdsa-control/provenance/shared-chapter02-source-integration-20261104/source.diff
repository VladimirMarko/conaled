+/-- The natural ceiling log has at most twice the real binary log once `n ≥ 2`.
+The lower bound on `n` supplies the unit of slack needed for ceiling. -/
+theorem clog_two_cast_le_two_logb (n : Nat) (hn : 2 ≤ n) :
+    (Nat.clog 2 n : ℝ) ≤ 2 * Real.logb 2 n := by
+  have hn' : (2 : ℝ) ≤ n := by exact_mod_cast hn
+  have hlog : 1 ≤ Real.logb 2 n := by
+    calc
+      1 = Real.logb 2 (2 : ℝ) := (Real.logb_self_eq_one (by norm_num)).symm
+      _ ≤ Real.logb 2 n := Real.logb_le_logb_of_le (by norm_num) (by norm_num) hn'
+  have hceil : (Nat.clog 2 n : ℝ) < Real.logb 2 n + 1 := by
+    rw [← Real.natCeil_logb_natCast 2 n]
+    simp only [Nat.cast_ofNat]
+    exact Nat.ceil_lt_add_one (by linarith)
+  linarith
+
+/-- A proved ceiling-log count bound yields the ordinary real `O(n log₂ n)`
+statement. This numerical bridge makes no claim about compiled execution. -/
+theorem isBigO_of_clog_two_bound (f : Nat → Nat) (C N : Nat)
+    (bound : ∀ n, N ≤ n → f n ≤ C * (n * Nat.clog 2 n)) :
+    Asymptotics.IsBigO Filter.atTop (fun n => (f n : ℝ))
+      (fun n => (n : ℝ) * Real.logb 2 n) := by
+  apply Asymptotics.isBigO_iff.mpr
+  refine ⟨2 * (C : ℝ), Filter.eventually_atTop.mpr ⟨max N 2, fun n hn => ?_⟩⟩
+  have hN : N ≤ n := (Nat.le_max_left _ _).trans hn
+  have htwo : 2 ≤ n := (Nat.le_max_right _ _).trans hn
+  have hlog : 0 ≤ Real.logb 2 n :=
+    Real.logb_nonneg (by norm_num) (by exact_mod_cast (show 1 ≤ n by omega))
+  have hb : (f n : ℝ) ≤ (C : ℝ) * ((n : ℝ) * (Nat.clog 2 n : ℝ)) := by
+    exact_mod_cast bound n hN
+  have hc := mul_le_mul_of_nonneg_left
+    (mul_le_mul_of_nonneg_left (clog_two_cast_le_two_logb n htwo)
+      (Nat.cast_nonneg n)) (Nat.cast_nonneg C)
+  rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (Nat.cast_nonneg _),
+    abs_of_nonneg (mul_nonneg (Nat.cast_nonneg n) hlog)]
+  calc
+    (f n : ℝ) ≤ (C : ℝ) * ((n : ℝ) * (Nat.clog 2 n : ℝ)) := hb
+    _ ≤ (C : ℝ) * ((n : ℝ) * (2 * Real.logb 2 n)) := hc
+    _ = 2 * (C : ℝ) * ((n : ℝ) * Real.logb 2 n) := by ring
+
 end Resources
diff --git a/Applications/Resources/ListBuildCosts.lean b/Applications/Resources/ListBuildCosts.lean
new file mode 100644
index 0000000..6f3c157
--- /dev/null
+++ b/Applications/Resources/ListBuildCosts.lean
@@ -0,0 +1,169 @@
+import Applications.Resources.ListReversal
+import Applications.Resources.Workload
+
+/-!
+Two ordinary-list alternatives discussed before the difference-list scanner
+in FDSA, Chapter 2, p. 22. Repeated append incurs the terminal-inclusive append
+count from `ListReversal`; prepending and then reversing uses the existing
+accumulator-reversal execution twice. Both compute the input in its original
+order. The append-only subobservation, full recursive loop, and one-unit outer
+wrapper remain explicit. No compiled-library or machine-time claim is made.
+-/
+set_option autoImplicit false
+set_option warningAsError true
+
+namespace Resources.ListBuildCosts
+universe u
+variable {α : Type u}
+
+/-- Append one incoming element to the already constructed ordinary prefix. -/
+def appendStep (a : α) (acc : List α) : Measured (List α) Nat :=
+  ListReversal.appendRun acc [a]
+
+/-- Observe only the append invocations; the supplied seed is already constructed. -/
+def appendSubRun (items acc : List α) : Measured (List α) Nat :=
+  run appendStep items acc
+
+@[simp] theorem appendSubRun_nil (acc : List α) :
+    appendSubRun [] acc = (acc, 0) := rfl
+
+theorem appendSubRun_cons (a : α) (items acc : List α) :
+    appendSubRun (a :: items) acc =
+      ((appendSubRun items (acc ++ [a])).1,
+        acc.length + 1 + (appendSubRun items (acc ++ [a])).2) := by
+  simp only [appendSubRun, run_cons, appendStep, ListReversal.appendRun_exact]
+
+theorem appendSubRun_value (items acc : List α) :
+    (appendSubRun items acc).1 = acc ++ items := by
+  induction items generalizing acc with
+  | nil => simp
+  | cons a items ih =>
+      simp only [appendSubRun_cons, ih, List.append_assoc, List.singleton_append]
+
+/-- Each next append traverses the prefix returned by the preceding append. -/
+theorem appendSubRun_double_cost (items acc : List α) :
+    2 * (appendSubRun items acc).2 =
+      2 * items.length * acc.length + items.length * (items.length + 1) := by
+  induction items generalizing acc with
+  | nil => simp
+  | cons a items ih =>
+      have h := ih (acc ++ [a])
+      simp only [List.length_append, List.length_singleton] at h
+      simp only [appendSubRun_cons, List.length_cons]
+      nlinarith
+
+/-- Natural division is derived from the execution's division-free exact equality. -/
+theorem appendSubRun_cost (items acc : List α) :
+    (appendSubRun items acc).2 =
+      items.length * acc.length + items.length * (items.length + 1) / 2 := by
+  have h := appendSubRun_double_cost items acc
+  simp only [Nat.mul_assoc] at h
+  omega
+
+theorem appendSubRun_empty_cost (items : List α) :
+    (appendSubRun items []).2 = items.length * (items.length + 1) / 2 := by
+  simpa using appendSubRun_cost items []
+
+/-- The full loop adds one entry at each recursive call, including the terminal call. -/
+def appendLoopRun : List α → List α → Measured (List α) Nat
+  | [], acc => CallCount.tick (pure acc)
+  | a :: items, acc =>
+      CallCount.tick (bind (ListReversal.appendRun acc [a]) (appendLoopRun items))
+
+@[simp] theorem appendLoopRun_nil (acc : List α) :
+    appendLoopRun [] acc = (acc, 1) := rfl
+
+theorem appendLoopRun_cons (a : α) (items acc : List α) :
+    appendLoopRun (a :: items) acc =
+      ((appendLoopRun items (acc ++ [a])).1,
+        acc.length + 1 + (appendLoopRun items (acc ++ [a])).2 + 1) := by
+  simp only [appendLoopRun, ListReversal.appendRun_exact, bind, CallCount.tick]
+
+theorem appendLoopRun_value (items acc : List α) :
+    (appendLoopRun items acc).1 = acc ++ items := by
+  induction items generalizing acc with
+  | nil => simp
+  | cons a items ih =>
+      simp only [appendLoopRun_cons, ih, List.append_assoc, List.singleton_append]
+
+theorem appendLoopRun_cost (items acc : List α) :
+    (appendLoopRun items acc).2 =
+      (appendSubRun items acc).2 + items.length + 1 := by
+  induction items generalizing acc with
+  | nil => rfl
+  | cons a items ih =>
+      have h := ih (acc ++ [a])
+      simp only [appendLoopRun_cons, appendSubRun_cons, List.length_cons]
+      omega
+
+/-- One wrapper entry supplies the empty seed and executes the full append loop. -/
+def appendBuildRun (items : List α) : Measured (List α) Nat :=
+  CallCount.tick (appendLoopRun items [])
+
+theorem appendBuildRun_value (items : List α) : (appendBuildRun items).1 = items := by
+  simp only [appendBuildRun, CallCount.tick_value, appendLoopRun_value, List.nil_append]
+
+theorem appendBuildRun_cost (items : List α) :
+    (appendBuildRun items).2 = items.length * (items.length + 1) / 2 + items.length + 2 := by
+  rw [appendBuildRun, CallCount.tick_cost, appendLoopRun_cost, appendSubRun_empty_cost]
+
+theorem appendBuildRun_double_cost (items : List α) :
+    2 * (appendBuildRun items).2 = items.length * items.length + 3 * items.length + 4 := by
+  have h := appendSubRun_double_cost items []
+  simp only [List.length_nil, Nat.mul_zero, Nat.zero_add] at h
+  rw [appendBuildRun, CallCount.tick_cost, appendLoopRun_cost]
+  nlinarith
+
+theorem appendBuildRun_exact (items : List α) :
+    appendBuildRun items =
+      (items, items.length * (items.length + 1) / 2 + items.length + 2) := by
+  apply Prod.ext
+  · exact appendBuildRun_value items
+  · exact appendBuildRun_cost items
+
+/-- Prepend each input element, then feed that actual reversed value to reversal. -/
+def consReverseBuildRun (items : List α) : Measured (List α) Nat :=
+  CallCount.tick (bind (SymmetricCosts.reverseRun items [])
+    (fun reversed => SymmetricCosts.reverseRun reversed []))
+
+theorem consReverseBuildRun_value (items : List α) :
+    (consReverseBuildRun items).1 = items := by
+  simp [consReverseBuildRun, bind, SymmetricCosts.reverseRun_value]
+
+theorem consReverseBuildRun_cost (items : List α) :
+    (consReverseBuildRun items).2 = 2 * items.length + 3 := by
+  simp only [consReverseBuildRun, CallCount.tick_cost, bind,
+    SymmetricCosts.reverseRun_work, SymmetricCosts.reverseRun_value,
+    List.append_nil, List.length_reverse]
+  omega
+
+theorem consReverseBuildRun_exact (items : List α) :
+    consReverseBuildRun items = (items, 2 * items.length + 3) := by
+  apply Prod.ext
+  · exact consReverseBuildRun_value items
+  · exact consReverseBuildRun_cost items
+
+/-- Ordered values agree; their observations have been established independently. -/
+theorem realizations_agree (items : List α) :
+    (appendBuildRun items).1 = (consReverseBuildRun items).1 := by
+  rw [appendBuildRun_value, consReverseBuildRun_value]
+
+/-- A quadratic lower bound, in a subtraction-free form valid even on empty input. -/
+theorem appendBuildRun_quadratic_lower (items : List α) :
+    items.length * items.length ≤ 2 * (appendBuildRun items).2 := by
+  rw [appendBuildRun_double_cost]
+  omega
+
+theorem appendBuildRun_quadratic_upper (items : List α) (hn : 1 ≤ items.length) :
+    (appendBuildRun items).2 ≤ 4 * items.length * items.length := by
+  have hs : items.length ≤ items.length * items.length := by
+    simpa only [Nat.mul_one] using Nat.mul_le_mul_left items.length hn
+  have hc := appendBuildRun_double_cost items
+  nlinarith
+
+theorem consReverseBuildRun_linear_upper (items : List α) (hn : 1 ≤ items.length) :
+    (consReverseBuildRun items).2 ≤ 5 * items.length := by
+  rw [consReverseBuildRun_cost]
+  omega
+
+end Resources.ListBuildCosts
diff --git a/Applications/Resources/NaturalRunComparisons.lean b/Applications/Resources/NaturalRunComparisons.lean
new file mode 100644
index 0000000..1ac499d
--- /dev/null
+++ b/Applications/Resources/NaturalRunComparisons.lean
@@ -0,0 +1,330 @@
+import Applications.Sorting.NaturalRuns
+import Applications.Resources.CallCount
+
+/-!
+The natural-run comparison recurrences from FDSA, Chapter 2, pp. 23–25,
+and an execution that computes the actual scanner values while observing them.
+Only tested adjacent pairs are charged. Builder creation/application, list
+construction, scanner entries and key-evaluation work belong to other models.
+In particular, these comparison counts assert no machine-runtime bound.
+-/
+set_option autoImplicit false
+set_option warningAsError true
+
+namespace Resources.NaturalRunComparisons
+open Applications.Sorting
+
+universe u v
+variable {α : Type u} {κ : Type v}
+
+mutual
+  /-- The source's `Cruns` specification; its zero cases are uncharged. -/
+  def runsCountBy (lt : α → α → Bool) : List α → Nat
+    | [] => 0
+    | [_] => 0
+    | a :: b :: xs =>
+        1 + (if lt b a then descCountBy lt b xs else ascCountBy lt b xs)
+  termination_by xs => xs.length
+  decreasing_by all_goals simp_wf
+
+  /-- `Casc` does not inspect the already supplied builder. -/
+  def ascCountBy (lt : α → α → Bool) (a : α) : List α → Nat
+    | [] => 0
+    | b :: bs =>
+        1 + (if lt b a then runsCountBy lt (b :: bs) else ascCountBy lt b bs)
+  termination_by ys => ys.length + 1
+  decreasing_by all_goals simp_wf
+
+  /-- `Cdesc` does not inspect the already supplied descending accumulator. -/
+  def descCountBy (lt : α → α → Bool) (a : α) : List α → Nat
+    | [] => 0
+    | b :: bs =>
+        1 + (if lt b a then descCountBy lt b bs else runsCountBy lt (b :: bs))
+  termination_by ys => ys.length + 1
+  decreasing_by all_goals simp_wf
+end
+
+@[simp] theorem runsCountBy_nil (lt : α → α → Bool) : runsCountBy lt [] = 0 := by
+  rw [runsCountBy]
+
+@[simp] theorem runsCountBy_singleton (lt : α → α → Bool) (a : α) :
+    runsCountBy lt [a] = 0 := by
+  rw [runsCountBy]
+
+theorem runsCountBy_cons_cons (lt : α → α → Bool) (a b : α) (xs : List α) :
+    runsCountBy lt (a :: b :: xs) =
+      1 + (if lt b a then descCountBy lt b xs else ascCountBy lt b xs) := by
+  rw [runsCountBy]
+
+@[simp] theorem ascCountBy_nil (lt : α → α → Bool) (a : α) :
+    ascCountBy lt a [] = 0 := by
+  rw [ascCountBy]
+
+theorem ascCountBy_cons (lt : α → α → Bool) (a b : α) (bs : List α) :
+    ascCountBy lt a (b :: bs) =
+      1 + (if lt b a then runsCountBy lt (b :: bs) else ascCountBy lt b bs) := by
+  rw [ascCountBy]
+
+@[simp] theorem descCountBy_nil (lt : α → α → Bool) (a : α) :
+    descCountBy lt a [] = 0 := by
+  rw [descCountBy]
+
+theorem descCountBy_cons (lt : α → α → Bool) (a b : α) (bs : List α) :
+    descCountBy lt a (b :: bs) =
+      1 + (if lt b a then descCountBy lt b bs else runsCountBy lt (b :: bs)) := by
+  rw [descCountBy]
+
+mutual
+  /-- Execute the comparison and exactly its selected recursive successor. -/
+  def runsRunBy (lt : α → α → Bool) : List α → Measured (List (List α)) Nat
+    | [] => pure []
+    | [a] => pure [[a]]
+    | a :: b :: xs =>
+        bind (CallCount.tick (pure (lt b a))) (fun descending =>
+          if descending then descRunBy lt b [a] xs
+          else ascRunBy lt b (Batteries.DList.singleton a) xs)
+  termination_by xs => xs.length
+  decreasing_by all_goals simp_wf
+
+  /-- The real builder supplies the emitted list; its application is uncharged here. -/
+  def ascRunBy (lt : α → α → Bool) (a : α) (d : Batteries.DList α) :
+      List α → Measured (List (List α)) Nat
+    | [] => pure [d.apply [a]]
+    | b :: bs =>
+        bind (CallCount.tick (pure (lt b a))) (fun descending =>
+          if descending then
+            bind (runsRunBy lt (b :: bs)) (fun rest => pure (d.apply [a] :: rest))
+          else ascRunBy lt b (d.push a) bs)
+  termination_by ys => ys.length + 1
+  decreasing_by all_goals simp_wf
+
+  /-- The actual descending prefix is extended or emitted by the selected branch. -/
+  def descRunBy (lt : α → α → Bool) (a : α) (acc : List α) :
+      List α → Measured (List (List α)) Nat
+    | [] => pure [a :: acc]
+    | b :: bs =>
+        bind (CallCount.tick (pure (lt b a))) (fun descending =>
+          if descending then descRunBy lt b (a :: acc) bs
+          else bind (runsRunBy lt (b :: bs)) (fun rest => pure ((a :: acc) :: rest)))
+  termination_by ys => ys.length + 1
+  decreasing_by all_goals simp_wf
+end
+
+@[simp] theorem runsRunBy_nil (lt : α → α → Bool) : runsRunBy lt [] = ([], 0) := by
+  simp only [runsRunBy, pure]
+
+@[simp] theorem runsRunBy_singleton (lt : α → α → Bool) (a : α) :
+    runsRunBy lt [a] = ([[a]], 0) := by
+  simp only [runsRunBy, pure]
+
+theorem runsRunBy_cons_cons (lt : α → α → Bool) (a b : α) (xs : List α) :
+    runsRunBy lt (a :: b :: xs) =
+      bind (CallCount.tick (pure (lt b a))) (fun descending =>
+        if descending then descRunBy lt b [a] xs
+        else ascRunBy lt b (Batteries.DList.singleton a) xs) := by
+  rw [runsRunBy]
+
+@[simp] theorem ascRunBy_nil (lt : α → α → Bool) (a : α) (d : Batteries.DList α) :
+    ascRunBy lt a d [] = ([d.apply [a]], 0) := by
+  simp only [ascRunBy, pure]
+
+theorem ascRunBy_cons (lt : α → α → Bool) (a b : α) (d : Batteries.DList α)
+    (bs : List α) :
+    ascRunBy lt a d (b :: bs) =
+      bind (CallCount.tick (pure (lt b a))) (fun descending =>
+        if descending then
+          bind (runsRunBy lt (b :: bs)) (fun rest => pure (d.apply [a] :: rest))
+        else ascRunBy lt b (d.push a) bs) := by
+  rw [ascRunBy]
+
+@[simp] theorem descRunBy_nil (lt : α → α → Bool) (a : α) (acc : List α) :
+    descRunBy lt a acc [] = ([a :: acc], 0) := by
+  simp only [descRunBy, pure]
+
+theorem descRunBy_cons (lt : α → α → Bool) (a b : α) (acc bs : List α) :
+    descRunBy lt a acc (b :: bs) =
+      bind (CallCount.tick (pure (lt b a))) (fun descending =>
+        if descending then descRunBy lt b (a :: acc) bs
+        else bind (runsRunBy lt (b :: bs)) (fun rest => pure ((a :: acc) :: rest))) := by
+  rw [descRunBy]
+
+mutual
+  /-- Joint refinement calculates both components from the actual measured branches. -/
+  theorem runsRunBy_spec (lt : α → α → Bool) (xs : List α) :
+      runsRunBy lt xs = (runsBy lt xs, runsCountBy lt xs) := by
+    match xs with
+    | [] => simp only [runsRunBy_nil, runsBy_nil, runsCountBy_nil]
+    | [a] => simp only [runsRunBy_singleton, runsBy_singleton, runsCountBy_singleton]
+    | a :: b :: bs =>
+      rw [runsRunBy_cons_cons, runsBy_cons_cons, runsCountBy_cons_cons]
+      cases h : lt b a with
+      | false =>
+        have hs := ascRunBy_spec lt b (Batteries.DList.singleton a) bs
+        simp only [CallCount.tick, pure, bind, Bool.false_eq_true, ↓reduceIte, hs]
+      | true =>
+        have hs := descRunBy_spec lt b [a] bs
+        simp only [CallCount.tick, pure, bind, ↓reduceIte, hs]
+  termination_by xs.length
+  decreasing_by all_goals simp_wf
+
+  theorem ascRunBy_spec (lt : α → α → Bool) (a : α) (d : Batteries.DList α)
+      (ys : List α) : ascRunBy lt a d ys = (ascBy lt a d ys, ascCountBy lt a ys) := by
+    match ys with
+    | [] => simp only [ascRunBy_nil, ascBy_nil, ascCountBy_nil]
+    | b :: bs =>
+      rw [ascRunBy_cons, ascBy_cons, ascCountBy_cons]
+      cases h : lt b a with
+      | false =>
+        have hs := ascRunBy_spec lt b (d.push a) bs
+        simp only [CallCount.tick, pure, bind, Bool.false_eq_true, ↓reduceIte, hs]
+      | true =>
+        have hs := runsRunBy_spec lt (b :: bs)
+        simp only [CallCount.tick, pure, bind, ↓reduceIte, hs, Nat.add_zero]
+  termination_by ys.length + 1
+  decreasing_by all_goals simp_wf
+
+  theorem descRunBy_spec (lt : α → α → Bool) (a : α) (acc ys : List α) :
+      descRunBy lt a acc ys = (descBy lt a acc ys, descCountBy lt a ys) := by
+    match ys with
+    | [] => simp only [descRunBy_nil, descBy_nil, descCountBy_nil]
+    | b :: bs =>
+      rw [descRunBy_cons, descBy_cons, descCountBy_cons]
+      cases h : lt b a with
+      | false =>
+        have hs := runsRunBy_spec lt (b :: bs)
+        simp only [CallCount.tick, pure, bind, Bool.false_eq_true, ↓reduceIte, hs,
+          Nat.add_zero]
+      | true =>
+        have hs := descRunBy_spec lt b (a :: acc) bs
+        simp only [CallCount.tick, pure, bind, ↓reduceIte, hs]
+  termination_by ys.length + 1
+  decreasing_by all_goals simp_wf
+end
+
+theorem runsRunBy_value (lt : α → α → Bool) (xs : List α) :
+    (runsRunBy lt xs).1 = runsBy lt xs := congrArg Prod.fst (runsRunBy_spec lt xs)
+
+theorem ascRunBy_value (lt : α → α → Bool) (a : α) (d : Batteries.DList α) (ys : List α) :
+    (ascRunBy lt a d ys).1 = ascBy lt a d ys := congrArg Prod.fst (ascRunBy_spec lt a d ys)
+
+theorem descRunBy_value (lt : α → α → Bool) (a : α) (acc ys : List α) :
+    (descRunBy lt a acc ys).1 = descBy lt a acc ys :=
+  congrArg Prod.fst (descRunBy_spec lt a acc ys)
+
+/-- Cost agreement follows from the measured branch calculation, not from value erasure. -/
+theorem runsRunBy_cost (lt : α → α → Bool) (xs : List α) :
+    (runsRunBy lt xs).2 = runsCountBy lt xs := congrArg Prod.snd (runsRunBy_spec lt xs)
+
+theorem ascRunBy_cost (lt : α → α → Bool) (a : α) (d : Batteries.DList α) (ys : List α) :
+    (ascRunBy lt a d ys).2 = ascCountBy lt a ys := congrArg Prod.snd (ascRunBy_spec lt a d ys)
+
+theorem descRunBy_cost (lt : α → α → Bool) (a : α) (acc ys : List α) :
+    (descRunBy lt a acc ys).2 = descCountBy lt a ys :=
+  congrArg Prod.snd (descRunBy_spec lt a acc ys)
+
+mutual
+  /-- Every adjacent input boundary is tested once, including a run restart. -/
+  theorem runsCountBy_exact (lt : α → α → Bool) (xs : List α) :
+      runsCountBy lt xs = xs.length - 1 := by
+    match xs with
+    | [] => simp
+    | [_] => simp
+    | a :: b :: bs =>
+      rw [runsCountBy_cons_cons]
+      split
+      · rw [descCountBy_exact lt b bs]
+        simp only [List.length_cons]
+        omega
+      · rw [ascCountBy_exact lt b bs]
+        simp only [List.length_cons]
+        omega
+  termination_by xs.length
+  decreasing_by all_goals simp_wf
+
+  theorem ascCountBy_exact (lt : α → α → Bool) (a : α) (ys : List α) :
+      ascCountBy lt a ys = ys.length := by
+    match ys with
+    | [] => simp
+    | b :: bs =>
+      rw [ascCountBy_cons]
+      split
+      · rw [runsCountBy_exact lt (b :: bs)]
+        simp only [List.length_cons]
+        omega
+      · rw [ascCountBy_exact lt b bs]
+        simp only [List.length_cons]
+        omega
+  termination_by ys.length + 1
+  decreasing_by all_goals simp_wf
+
+  theorem descCountBy_exact (lt : α → α → Bool) (a : α) (ys : List α) :
+      descCountBy lt a ys = ys.length := by
+    match ys with
+    | [] => simp
+    | b :: bs =>
+      rw [descCountBy_cons]
+      split
+      · rw [descCountBy_exact lt b bs]
+        simp only [List.length_cons]
+        omega
+      · rw [runsCountBy_exact lt (b :: bs)]
+        simp only [List.length_cons]
+        omega
+  termination_by ys.length + 1
+  decreasing_by all_goals simp_wf
+end
+
+theorem runsCountBy_le (lt : α → α → Bool) (xs : List α) :
+    runsCountBy lt xs ≤ xs.length - 1 := le_of_eq (runsCountBy_exact lt xs)
+
+theorem ascCountBy_le (lt : α → α → Bool) (a : α) (ys : List α) :
+    ascCountBy lt a ys ≤ ys.length := le_of_eq (ascCountBy_exact lt a ys)
+
+theorem descCountBy_le (lt : α → α → Bool) (a : α) (ys : List α) :
+    descCountBy lt a ys ≤ ys.length := le_of_eq (descCountBy_exact lt a ys)
+
+theorem runsRunBy_cost_exact (lt : α → α → Bool) (xs : List α) :
+    (runsRunBy lt xs).2 = xs.length - 1 :=
+  (runsRunBy_cost lt xs).trans (runsCountBy_exact lt xs)
+
+theorem ascRunBy_cost_exact (lt : α → α → Bool) (a : α) (d : Batteries.DList α)
+    (ys : List α) : (ascRunBy lt a d ys).2 = ys.length :=
+  (ascRunBy_cost lt a d ys).trans (ascCountBy_exact lt a ys)
+
+theorem descRunBy_cost_exact (lt : α → α → Bool) (a : α) (acc ys : List α) :
+    (descRunBy lt a acc ys).2 = ys.length :=
+  (descRunBy_cost lt a acc ys).trans (descCountBy_exact lt a ys)
+
+/-- The comparison observation does not require a construction history for the raw builder. -/
+abbrev ascSourceRunBy (lt : α → α → Bool) (a : α) (f : List α → List α)
+    (h : DListLaw f) (ys : List α) : Measured (List (List α)) Nat :=
+  ascRunBy lt a (dListOfLaw f h) ys
+
+theorem ascSourceRunBy_value (lt : α → α → Bool) (a : α) (f : List α → List α)
+    (h : DListLaw f) (ys : List α) :
+    (ascSourceRunBy lt a f h ys).1 = ascSourceBy lt a f h ys :=
+  ascRunBy_value lt a (dListOfLaw f h) ys
+
+theorem ascSourceRunBy_cost (lt : α → α → Bool) (a : α) (f : List α → List α)
+    (h : DListLaw f) (ys : List α) : (ascSourceRunBy lt a f h ys).2 = ys.length :=
+  ascRunBy_cost_exact lt a (dListOfLaw f h) ys
+
+/-- The sorted best-case scan still compares each adjacent pair. Merge work is separate. -/
+theorem runsRunBy_of_sorted [LinearOrder κ] (key : α → κ) (xs : List α)
+    (hs : KeySorted key xs) (hne : xs ≠ []) :
+    runsRunBy (fun x y => decide (key x < key y)) xs = ([xs], xs.length - 1) := by
+  apply Prod.ext
+  · rw [runsRunBy_value]
+    exact runsOn_of_sorted key xs hs hne
+  · exact runsRunBy_cost_exact _ xs
+
+theorem runsRunBy_of_strictly_descending [LT κ] [DecidableLT κ]
+    (key : α → κ) (xs : List α) (hs : xs.Pairwise (fun x y => key y < key x))
+    (hne : xs ≠ []) :
+    runsRunBy (fun x y => decide (key x < key y)) xs = ([xs.reverse], xs.length - 1) := by
+  apply Prod.ext
+  · rw [runsRunBy_value]
+    exact runsOn_of_strictly_descending key xs hs hne
+  · exact runsRunBy_cost_exact _ xs
+
+end Resources.NaturalRunComparisons
