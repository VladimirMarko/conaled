+++ b/Applications/Sorting/TopDown.lean
@@ -0,0 +1,145 @@
+import Applications.Sorting.Sort
+
+/-! The floor-left top-down merge sort from FDSA §2.4.
+The two contiguous halves preserve the input order across equal-key blocks.
+This value algorithm is separate from its comparison observation; equality
+with the library's ceil-left merge sort does not identify their work counts.
+-/
+set_option autoImplicit false
+set_option warningAsError true
+
+namespace Applications.Sorting
+universe u v
+variable {α : Type u} {κ : Type v}
+
+/-- Split at floor(length/2); lists of length zero or one are returned directly. -/
+def sortFloorBy (cmp : α → α → Bool) (xs : List α) : List α :=
+  if h : xs.length ≤ 1 then xs
+  else List.merge (sortFloorBy cmp (xs.take (xs.length / 2)))
+    (sortFloorBy cmp (xs.drop (xs.length / 2))) cmp
+termination_by xs.length
+decreasing_by
+  all_goals
+    simp only [List.length_take, List.length_drop]
+    omega
+
+theorem sortFloorBy_of_length_le (cmp : α → α → Bool) (xs : List α)
+    (h : xs.length ≤ 1) : sortFloorBy cmp xs = xs := by
+  rw [sortFloorBy]
+  split
+  · rfl
+  · omega
+
+theorem sortFloorBy_step (cmp : α → α → Bool) (xs : List α)
+    (h : 1 < xs.length) :
+    sortFloorBy cmp xs = List.merge (sortFloorBy cmp (xs.take (xs.length / 2)))
+      (sortFloorBy cmp (xs.drop (xs.length / 2))) cmp := by
+  rw [sortFloorBy]
+  split
+  · omega
+  · rfl
+
+@[simp] theorem sortFloorBy_nil (cmp : α → α → Bool) :
+    sortFloorBy cmp [] = [] := sortFloorBy_of_length_le cmp [] (by simp)
+
+@[simp] theorem sortFloorBy_singleton (cmp : α → α → Bool) (x : α) :
+    sortFloorBy cmp [x] = [x] := sortFloorBy_of_length_le cmp [x] (by simp)
+
+/-- Permutation uses no order laws for the supplied Boolean comparator. -/
+theorem sortFloorBy_perm (cmp : α → α → Bool) (xs : List α) :
+    (sortFloorBy cmp xs).Perm xs := by
+  by_cases h : xs.length ≤ 1
+  · rw [sortFloorBy_of_length_le cmp xs h]
+  · rw [sortFloorBy_step cmp xs (by omega)]
+    exact (List.merge_perm_append cmp).trans
+      (((sortFloorBy_perm cmp _).append (sortFloorBy_perm cmp _)).trans
+        (List.Perm.of_eq (List.take_append_drop _ xs)))
+termination_by xs.length
+decreasing_by
+  all_goals
+    simp only [List.length_take, List.length_drop]
+    omega
+
+theorem sortFloorBy_length (cmp : α → α → Bool) (xs : List α) :
+    (sortFloorBy cmp xs).length = xs.length := (sortFloorBy_perm cmp xs).length_eq
+
+theorem mem_sortFloorBy (cmp : α → α → Bool) (xs : List α) (x : α) :
+    x ∈ sortFloorBy cmp xs ↔ x ∈ xs := (sortFloorBy_perm cmp xs).mem_iff
+
+/-- Only comparisons on actual input members need respect the observed key order. -/
+theorem sortFloorBy_sorted_compatible_on [LE κ] [Std.IsPreorder κ]
+    (key : α → κ) (cmp : α → α → Bool) (xs : List α)
+    (hc : ∀ a ∈ xs, ∀ b ∈ xs, (cmp a b = true → key a ≤ key b) ∧
+      (cmp a b = false → key b ≤ key a)) :
+    KeySorted key (sortFloorBy cmp xs) := by
+  by_cases h : xs.length ≤ 1
+  · rw [sortFloorBy_of_length_le cmp xs h]
+    cases xs with
+    | nil => simp [KeySorted]
+    | cons x xs =>
+      cases xs with
+      | nil => simp [KeySorted]
+      | cons y ys => simp at h
+  · rw [sortFloorBy_step cmp xs (by omega)]
+    apply merge_sorted_compatible_on key cmp
+    · intro a ha b hb
+      apply hc a _ b _
+      · exact List.mem_of_mem_take ((sortFloorBy_perm cmp _).mem_iff.mp ha)
+      · exact List.mem_of_mem_drop ((sortFloorBy_perm cmp _).mem_iff.mp hb)
+    · exact sortFloorBy_sorted_compatible_on key cmp _ (fun a ha b hb =>
+        hc a (List.mem_of_mem_take ha) b (List.mem_of_mem_take hb))
+    · exact sortFloorBy_sorted_compatible_on key cmp _ (fun a ha b hb =>
+        hc a (List.mem_of_mem_drop ha) b (List.mem_of_mem_drop hb))
+termination_by xs.length
+decreasing_by
+  all_goals
+    simp only [List.length_take, List.length_drop]
+    omega
+
+abbrev sortFloorOn [LE κ] [DecidableLE κ] (key : α → κ) (xs : List α) : List α :=
+  sortFloorBy (fun x y => decide (key x ≤ key y)) xs
+
+theorem sortFloorOn_correct [LE κ] [DecidableLE κ] [Std.IsLinearPreorder κ]
+    (key : α → κ) (xs : List α) :
+    KeySorted key (sortFloorOn key xs) ∧ (sortFloorOn key xs).Perm xs := by
+  refine ⟨?_, sortFloorBy_perm _ _⟩
+  apply sortFloorBy_sorted_compatible_on key
+  intro a _ b _
+  exact ⟨of_decide_eq_true, fun h =>
+    (Std.le_total (a := key a) (b := key b)).resolve_left (of_decide_eq_false h)⟩
+
+/-- Contiguous splitting and left-biased equal-key merge preserve each occurrence. -/
+theorem sortFloorOn_stable [LE κ] [DecidableLE κ] [Std.IsLinearPreorder κ]
+    [DecidableEq κ] (key : α → κ) (xs : List α) :
+    Stable key xs (sortFloorOn key xs) := by
+  intro k
+  by_cases h : xs.length ≤ 1
+  · rw [sortFloorOn, sortFloorBy_of_length_le _ xs h]
+  · change (sortFloorBy _ xs).filter _ = _
+    rw [sortFloorBy_step _ xs (by omega)]
+    change (mergeBy key (sortFloorOn key (xs.take (xs.length / 2)))
+      (sortFloorOn key (xs.drop (xs.length / 2)))).filter _ = _
+    rw [mergeBy_filter key _ _ (sortFloorOn_correct key _).1
+      (sortFloorOn_correct key _).1,
+      sortFloorOn_stable key (xs.take (xs.length / 2)) k,
+      sortFloorOn_stable key (xs.drop (xs.length / 2)) k,
+      ← List.filter_append, List.take_append_drop]
+termination_by xs.length
+decreasing_by
+  all_goals
+    simp only [List.length_take, List.length_drop]
+    omega
+
+theorem sortFloorOn_spec [LE κ] [DecidableLE κ] [Std.IsLinearPreorder κ]
+    [DecidableEq κ] (key : α → κ) (xs : List α) :
+    StableSort key xs (sortFloorOn key xs) :=
+  ⟨(sortFloorOn_correct key xs).1, (sortFloorOn_correct key xs).2,
+    sortFloorOn_stable key xs⟩
+
+/-- This equality concerns returned lists, not the different splitting costs. -/
+theorem sortFloorOn_eq_sortOn [LE κ] [DecidableLE κ] [Std.IsLinearOrder κ]
+    [DecidableEq κ] (key : α → κ) (xs : List α) :
+    sortFloorOn key xs = sortOn key xs :=
+  (sortFloorOn_spec key xs).unique (sortOn_spec key xs)
+
+end Applications.Sorting
diff --git a/Applications/Sorting/Uniqueness.lean b/Applications/Sorting/Uniqueness.lean
new file mode 100644
index 0000000..5a0e68e
--- /dev/null
+++ b/Applications/Sorting/Uniqueness.lean
@@ -0,0 +1,44 @@
+import Mathlib.Data.List.Sort
+import Mathlib.Data.Multiset.Defs
+
+/-! Ordinary sorting functions are determined by pairwise order and occurrences.
+The relation needs only antisymmetry once both outputs satisfy the contract.
+This adds function-level consequences of the existing list uniqueness theorem,
+without introducing another sorting operation or specification carrier.
+-/
+set_option autoImplicit false
+set_option warningAsError true
+
+namespace Applications.Sorting
+
+universe u
+variable {α : Type u}
+
+/-- Correctness at this input determines the result, even when the relation
+does not admit a sorting function on every possible input. -/
+theorem sorters_eq_at (r : α → α → Prop) [Std.Antisymm r]
+    (f g : List α → List α) (xs : List α)
+    (hf : (f xs).Pairwise r ∧ (f xs).Perm xs)
+    (hg : (g xs).Pairwise r ∧ (g xs).Perm xs) : f xs = g xs :=
+  List.Perm.eq_of_pairwise' (r := r) hf.1 hg.1 (hf.2.trans hg.2.symm)
+
+/-- Any two functions satisfying ordinary sorting correctness at every input
+are equal as functions. Stability and execution costs are separate observations. -/
+theorem sorters_eq (r : α → α → Prop) [Std.Antisymm r]
+    (f g : List α → List α)
+    (hf : ∀ xs, (f xs).Pairwise r ∧ (f xs).Perm xs)
+    (hg : ∀ xs, (g xs).Pairwise r ∧ (g xs).Perm xs) : f = g :=
+  funext fun xs => sorters_eq_at r f g xs (hf xs) (hg xs)
+
+/-- The source's multiset formulation has exactly the same occurrence meaning.
+Applying the resulting function equality to an input gives its pointwise form. -/
+theorem sorters_eq_of_multiset (r : α → α → Prop) [Std.Antisymm r]
+    (f g : List α → List α)
+    (hf : ∀ xs, (f xs).Pairwise r ∧ (f xs : Multiset α) = (xs : Multiset α))
+    (hg : ∀ xs, (g xs).Pairwise r ∧ (g xs : Multiset α) = (xs : Multiset α)) :
+    f = g :=
+  sorters_eq r f g
+    (fun xs => ⟨(hf xs).1, Multiset.coe_eq_coe.mp (hf xs).2⟩)
+    (fun xs => ⟨(hg xs).1, Multiset.coe_eq_coe.mp (hg xs).2⟩)
+
+end Applications.Sorting
diff --git a/Examples/AlternatingSorting.lean b/Examples/AlternatingSorting.lean
new file mode 100644
index 0000000..cb3a191
--- /dev/null
+++ b/Examples/AlternatingSorting.lean
@@ -0,0 +1,111 @@
+import Applications.Sorting.Alternating
+import Examples.StableSorting
+import Mathlib.Data.Multiset.Basic
+
+/-! Exercise 2.5's actual accumulated pile order, occurrence correctness and
+ordinary sortedness. Reversed alternating piles can reorder equal-key records,
+so the source's ordinary correctness claim is kept separate from stability.
+-/
+set_option autoImplicit false
+set_option warningAsError true
+
+namespace Examples.AlternatingSorting
+open Applications.Sorting
+universe u
+variable {α : Type u}
+
+/-- The printed nonempty-accumulator example, using the actual public step equations. -/
+theorem source_halve_example :
+    halve ([2, 3, 4] : List Nat) ([0], [1]) = ([4, 2, 0], [3, 1]) := by
+  simp only [halve_cons_cons, halve_singleton]
+
+theorem source_halve_lengths :
+    (halve ([2, 3, 4] : List Nat) ([0], [1])).1.length = 3 ∧
+      (halve ([2, 3, 4] : List Nat) ([0], [1])).2.length = 2 := by
+  simpa using halve_lengths ([2, 3, 4] : List Nat) [0] [1]
+
+theorem even_halve_example :
+    halve ([0, 1, 2, 3] : List Nat) ([], []) = ([2, 0], [3, 1]) := by
+  simp only [halve_cons_cons, halve_nil]
+
+theorem even_halve_lengths :
+    (halve ([0, 1, 2, 3] : List Nat) ([], [])).1.length = 2 ∧
+      (halve ([0, 1, 2, 3] : List Nat) ([], [])).2.length = 2 := by
+  simpa using halve_lengths ([0, 1, 2, 3] : List Nat) [] []
+
+/-- Arbitrary original pile contents remain in the combined multiset. -/
+theorem accumulator_multiset (xs left right : List α) :
+    (((halve xs (left, right)).1 ++ (halve xs (left, right)).2 : List α) : Multiset α) =
+      ((xs ++ left ++ right : List α) : Multiset α) :=
+  Quot.sound (halve_perm xs left right)
+
+/-- Only the added lengths are balanced if the initial pile lengths differ. -/
+theorem unbalanced_initial_piles :
+    (halve ([] : List Nat) ([3, 2, 1], [])).1.length = 3 ∧
+      (halve ([] : List Nat) ([3, 2, 1], [])).2.length = 0 := by
+  exact halve_lengths ([] : List Nat) [3, 2, 1] []
+
+theorem empty_halve_payload : halve ([] : List Empty) ([], []) = ([], []) := halve_nil _
+
+theorem singleton_halve_payload (x : α) (left right : List α) :
+    halve [x] (left, right) = (x :: left, right) := halve_singleton _ _ _
+
+/-- Both balanced children of every nontrivial input satisfy the actual recursion measure. -/
+theorem recursive_halves (xs : List α) (hn : 2 ≤ xs.length) :
+    (halve xs ([], [])).2.length ≤ (halve xs ([], [])).1.length ∧
+      (halve xs ([], [])).1.length ≤ (halve xs ([], [])).2.length + 1 ∧
+      (halve xs ([], [])).1.length < xs.length ∧
+      (halve xs ([], [])).2.length < xs.length :=
+  ⟨(halve_empty_balance xs).1, (halve_empty_balance xs).2, halve_strict xs hn⟩
+
+/-- Odd occurrences form the left pile in reverse order. -/
+theorem source_sort_three_equation (cmp : α → α → Bool) (a b c : α) :
+    sortAlternatingBy cmp [a, b, c] =
+      List.merge (sortAlternatingBy cmp [c, a]) (sortAlternatingBy cmp [b]) cmp := by
+  simpa only [halve_cons_cons, halve_singleton] using sortAlternatingBy_cons_cons cmp a b [c]
+
+/-- The independent expected sorted permutation consumes both public correctness fields. -/
+theorem duplicate_source_value :
+    sortAlternatingOn id ([2, 1, 2, 3, 0] : List Nat) = [0, 1, 2, 2, 3] := by
+  have h := sortAlternatingOn_correct id ([2, 1, 2, 3, 0] : List Nat)
+  exact List.Perm.eq_of_pairwise' (r := fun a b : Nat => a ≤ b) h.1 (by decide)
+    (h.2.trans (by decide : ([2, 1, 2, 3, 0] : List Nat).Perm [0, 1, 2, 2, 3]))
+
+theorem source_multiset (cmp : α → α → Bool) (xs : List α) :
+    ((sortAlternatingBy cmp xs : List α) : Multiset α) = (xs : Multiset α) :=
+  Quot.sound (sortAlternatingBy_perm cmp xs)
+
+theorem arbitrary_comparator_occurrences (cmp : α → α → Bool) (xs : List α) :
+    (sortAlternatingBy cmp xs).Perm xs ∧ (sortAlternatingBy cmp xs).length = xs.length :=
+  ⟨sortAlternatingBy_perm cmp xs, sortAlternatingBy_length cmp xs⟩
+
+theorem empty_sort_payload :
+    sortAlternatingOn (Empty.elim : Empty → Nat) [] = [] := sortAlternatingBy_nil _
+
+theorem singleton_sort_payload (x : α) :
+    sortAlternatingOn (fun _ : α => (0 : Nat)) [x] = [x] := sortAlternatingBy_singleton _ _
+
+/-- Reuse the accepted comparator witness whose contract holds only on this input. -/
+theorem local_comparator_sorted :
+    KeySorted Prod.fst
+      (sortAlternatingBy StableSorting.nonnegativeCompare StableSorting.nonnegativeInput) :=
+  sortAlternatingBy_sorted_compatible_on Prod.fst _ _ StableSorting.nonnegative_compatible
+
+/-- A source calculation on arbitrary payloads exposes the reversal of equal-key records. -/
+theorem arbitrary_payload_order (first middle last : α) :
+    sortAlternatingOn Prod.fst ([(1, first), (0, middle), (1, last)] : List (Nat × α)) =
+      [(0, middle), (1, last), (1, first)] := by
+  unfold sortAlternatingOn
+  rw [source_sort_three_equation, sortAlternatingBy_pair, sortAlternatingBy_singleton]
+  simp
+
+/-- Ordinary sortedness and multiplicity preservation do not make this variant stable. -/
+theorem source_variant_not_stable :
+    ¬ Stable Prod.fst ([(1, 0), (0, 1), (1, 2)] : List (Nat × Nat))
+      (sortAlternatingOn Prod.fst [(1, 0), (0, 1), (1, 2)]) := by
+  rw [arbitrary_payload_order]
+  intro h
+  have hf := h 1
+  simp at hf
+
+end Examples.AlternatingSorting
diff --git a/Examples/BottomUpCosts.lean b/Examples/BottomUpCosts.lean
new file mode 100644
index 0000000..cd02cf2
--- /dev/null
+++ b/Examples/BottomUpCosts.lean
@@ -0,0 +1,243 @@
+import Applications.Resources.BottomUpSorting
+import Examples.BottomUpSorting
+
+/-!
+# Connected bottom-up comparison observations
+
+The ragged pass costs two comparisons. Three equal singleton runs cost one
+comparison in either first pass; ordinary repeated merging then costs two more,
+while the reversed pass costs one more. Thus their total counts are three and
+two, despite equal unlabelled results. The tagged versions retain the actual
+different payload orders. None of these observations counts outer traversal,
+construction, allocation or compiled runtime.
+-/
+set_option autoImplicit false
+set_option warningAsError true
+
+namespace Examples.BottomUpCosts
+
+open Applications.Sorting
+open _root_.Resources.BottomUpSorting
+open _root_.Examples.BottomUpSorting (natCompare raggedRuns)
+universe u
+variable {α : Type u}
+
+theorem empty_and_single_run (cmp : α → α → Bool) (xs : List α) :
+    allRun cmp [] = ([], 0) ∧ allRun cmp [xs] = (xs, 0) ∧
+      allRevRun cmp [] = ([], 0) ∧ allRevRun cmp [xs] = (xs, 0) :=
+  ⟨allRun_nil cmp, allRun_singleton cmp xs,
+    allRevRun_nil cmp, allRevRun_singleton cmp xs⟩
+
+/-- A zero-comparison sole run can still be unsorted; the run invariant matters. -/
+theorem unsorted_single_run :
+    allRun natCompare [[2, 1]] = ([2, 1], 0) ∧
+      ¬ KeySorted id (allRun natCompare [[2, 1]]).1 := by
+  refine ⟨allRun_singleton _ _, ?_⟩
+  rw [allRun_value]
+  exact BottomUpSorting.singleton_unsorted_run
+
+/-- Ragged lengths, an empty run, a duplicate and an odd leftover in one actual pass. -/
+theorem ragged_observation :
+    pairsRun natCompare raggedRuns = ([[1, 2, 3], [0, 4], [2, 5]], 2) := by
+  apply Prod.ext
+  · exact (pairsRun_value natCompare raggedRuns).trans BottomUpSorting.ragged_pass_value
+  · change pairsComparisons natCompare raggedRuns = 2
+    simp [raggedRuns, pairsComparisons_step, natCompare,
+      Resources.ListMerge.comparisons_cons_cons,
+      Resources.ListMerge.comparisons_nil_left, Resources.ListMerge.comparisons_nil_right]
+
+theorem nonempty_accumulator_observation :
+    pairsRevRun natCompare [[99], [], [42, 43]] raggedRuns =
+      ([[2, 5], [0, 4], [1, 2, 3], [99], [], [42, 43]], 2) := by
+  rw [pairsRevRun_eq, ragged_observation]
+  rfl
+
+/-- Neither accumulator content nor its sortedness changes the executed pair comparisons. -/
+theorem accumulator_cost_independent (cmp : α → α → Bool)
+    (acc₁ acc₂ xss : List (List α)) :
+    pairsRevComparisons cmp acc₁ xss = pairsRevComparisons cmp acc₂ xss :=
+  (pairsRevComparisons_eq cmp acc₁ xss).trans (pairsRevComparisons_eq cmp acc₂ xss).symm
+
+theorem three_equal_first_pass :
+    pairsRun natCompare [[0], [0], [0]] = ([[0, 0], [0]], 1) := by
+  simp [pairsRun_step, natCompare, Resources.ListMerge.run_cons_cons,
+    Resources.ListMerge.run_nil_left, Resources.bind, Resources.reweight, Resources.pure]
+
+theorem three_equal_reversed_first_pass :
+    pairsRevRun natCompare [] [[0], [0], [0]] = ([[0], [0, 0]], 1) := by
+  rw [pairsRevRun_eq, three_equal_first_pass]
+  rfl
+
+/-- Exactly two runs perform one measured merge and an uncharged singleton dispatch. -/
+theorem all_two_runs (cmp : α → α → Bool) (xs ys : List α) :
+    allRun cmp [xs, ys] = Resources.reweight Prod.fst (Resources.ListMerge.run cmp xs ys) := by
+  rw [allRun_step, pairsRun_step]
+  simp [Resources.bind, Resources.reweight, Resources.pure]
+
+theorem all_reversed_two_runs (cmp : α → α → Bool) (xs ys : List α) :
+    allRevRun cmp [xs, ys] = Resources.reweight Prod.fst (Resources.ListMerge.run cmp xs ys) := by
+  rw [allRevRun_step, pairsRevRun_step]
+  simp [Resources.bind, Resources.reweight]
+
+/-- The first returned run is the left operand of the next ordinary merge. -/
+theorem ordinary_three_run (cmp : α → α → Bool) (a b c : α) :
+    run cmp [a, b, c] =
+      Resources.bind (Resources.reweight Prod.fst (Resources.ListMerge.run cmp [a] [b]))
+        (fun merged => Resources.reweight Prod.fst (Resources.ListMerge.run cmp merged [c])) := by
+  change allRun cmp [[a], [b], [c]] = _
+  rw [allRun_step, pairsRun_step]
+  simp [Resources.bind, Resources.reweight, Resources.pure, all_two_runs]
+
+/-- Reversing the pass makes that same returned run the right operand instead. -/
+theorem reversed_three_run (cmp : α → α → Bool) (a b c : α) :
+    revRun cmp [a, b, c] =
+      Resources.bind (Resources.reweight Prod.fst (Resources.ListMerge.run cmp [a] [b]))
+        (fun merged => Resources.reweight Prod.fst (Resources.ListMerge.run cmp [c] merged)) := by
+  change allRevRun cmp [[a], [b], [c]] = _
+  rw [allRevRun_step, pairsRevRun_step]
+  simp [Resources.bind, Resources.reweight, all_reversed_two_runs]
+
+theorem ordinary_three_equal : run natCompare [0, 0, 0] = ([0, 0, 0], 3) := by
+  simp [ordinary_three_run, natCompare, Resources.ListMerge.run_cons_cons,
+    Resources.ListMerge.run_nil_left, Resources.bind, Resources.reweight]
+
+theorem reversed_three_equal : revRun natCompare [0, 0, 0] = ([0, 0, 0], 2) := by
+  simp [reversed_three_run, natCompare, Resources.ListMerge.run_cons_cons,
+    Resources.ListMerge.run_nil_left, Resources.bind, Resources.reweight]
+
+/-- Equal per-pass counts do not give equal counts after the run order changes. -/
+theorem same_pass_costs_different_totals :
+    pairsComparisons natCompare [[0], [0], [0]] =
+        pairsRevComparisons natCompare [] [[0], [0], [0]] ∧
+      (run natCompare [0, 0, 0]).1 = (revRun natCompare [0, 0, 0]).1 ∧
+      comparisons natCompare [0, 0, 0] ≠ revComparisons natCompare [0, 0, 0] := by
+  refine ⟨(pairsRevComparisons_eq _ _ _).symm, ?_⟩
+  rw [comparisons, revComparisons, ordinary_three_equal, reversed_three_equal]
+  decide
+
+theorem ordinary_tagged_equal (first middle last : α) :
+    run (fun a b : Nat × α => decide (a.1 ≤ b.1))
+        [(0, first), (0, middle), (0, last)] =
+      ([(0, first), (0, middle), (0, last)], 3) := by
+  simp [ordinary_three_run, Resources.ListMerge.run_cons_cons,
+    Resources.ListMerge.run_nil_left, Resources.bind, Resources.reweight]
+
+theorem reversed_tagged_equal (first middle last : α) :
+    revRun (fun a b : Nat × α => decide (a.1 ≤ b.1))
+        [(0, first), (0, middle), (0, last)] =
+      ([(0, last), (0, first), (0, middle)], 2) := by
+  simp [reversed_three_run, Resources.ListMerge.run_cons_cons,
+    Resources.ListMerge.run_nil_left, Resources.bind, Resources.reweight]
+
+/-- Measured erasure retains the existing concrete failure of stability. -/
+theorem measured_tail_not_stable :
+    ¬ Stable Prod.fst ([(0, "first"), (0, "middle"), (0, "last")] : List (Nat × String))
+      (revRun (fun a b => decide (a.1 ≤ b.1))
+        [(0, "first"), (0, "middle"), (0, "last")]).1 := by
+  rw [revRun_value]
+  exact BottomUpSorting.tail_sort_need_not_be_stable
+
+theorem raw_occurrences_and_bounds (cmp : α → α → Bool) (xs : List α) :
+    (run cmp xs).1.Perm xs ∧
+      comparisons cmp xs ≤ xs.length * Nat.clog 2 xs.length ∧
+      (revRun cmp xs).1.Perm xs ∧
+      revComparisons cmp xs ≤ xs.length * Nat.clog 2 xs.length :=
+  ⟨run_perm cmp xs, comparisons_le_clog cmp xs,
+    revRun_perm cmp xs, revComparisons_le_clog cmp xs⟩
+
+/-- Local comparator compatibility suffices for the measured returned values as well. -/
+theorem local_comparator_values :
+    KeySorted Prod.fst
+        (run StableSorting.nonnegativeCompare StableSorting.nonnegativeInput).1 ∧
+      KeySorted Prod.fst
+        (revRun StableSorting.nonnegativeCompare StableSorting.nonnegativeInput).1 := by
+  rw [run_value, revRun_value]
+  exact ⟨BottomUpSorting.local_comparator_ordinary, BottomUpSorting.local_comparator_tail⟩
+
+/-- A uniform odd pass has the source budget although its leftover does not double. -/
+theorem odd_uniform_budget_and_leftover :
+    pairsComparisons natCompare [[1], [2], [3]] ≤ 3 ∧
+      ¬ (∀ xs ∈ mergePairsBy natCompare [[1], [2], [3]], xs.length = 2) := by
+  refine ⟨?_, BottomUpSorting.odd_runs_do_not_all_double⟩
+  have hl : ∀ xs ∈ ([[1], [2], [3]] : List (List Nat)), xs.length = 1 := by
+    intro xs hx
+    simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
+    rcases hx with rfl | rfl | rfl <;> rfl
+  simpa using pairsComparisons_le_uniform natCompare [[1], [2], [3]] 1 hl
+
+/-- `m=0` remains meaningful: structural passes are performed with zero head comparisons. -/
+theorem four_empty_runs_zero (cmp : α → α → Bool) :
+    allComparisons cmp [[], [], [], []] = 0 ∧
+      allRevComparisons cmp [[], [], [], []] = 0 := by
+  have hl : ∀ xs ∈ ([[], [], [], []] : List (List α)), xs.length = 0 := by simp
+  have ho := allComparisons_le_uniform_pow cmp [[], [], [], []] 0 2 hl (by rfl)
+  have hr := allRevComparisons_le_uniform_pow cmp [[], [], [], []] 0 2 hl (by rfl)
+  constructor <;> omega
+
+/-- `k=0` allows an arbitrarily long single run, with zero merge comparisons. -/
+theorem single_run_power_zero (cmp : α → α → Bool) (xs : List α) :
+    allComparisons cmp [xs] ≤ 0 ∧ allRevComparisons cmp [xs] ≤ 0 := by
+  have hl : ∀ ys ∈ [xs], ys.length = xs.length := by simp
+  constructor
+  · simpa only [Nat.mul_zero, Nat.zero_mul] using
+      allComparisons_le_uniform_pow cmp [xs] xs.length 0 hl (by rfl)
+  · simpa only [Nat.mul_zero, Nat.zero_mul] using
+      allRevComparisons_le_uniform_pow cmp [xs] xs.length 0 hl (by rfl)
+
+theorem uniform_four_runs_bound :
+    allComparisons natCompare [[0, 4], [1, 5], [2, 6], [3, 7]] ≤ 16 ∧
+      allRevComparisons natCompare [[0, 4], [1, 5], [2, 6], [3, 7]] ≤ 16 := by
+  have hl : ∀ xs ∈ ([[0, 4], [1, 5], [2, 6], [3, 7]] : List (List Nat)),
+      xs.length = 2 := by
+    intro xs hx
+    simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
+    rcases hx with rfl | rfl | rfl | rfl <;> rfl
+  constructor
+  · exact allComparisons_le_uniform_pow natCompare _ 2 2 hl (by decide)
+  · exact allRevComparisons_le_uniform_pow natCompare _ 2 2 hl (by decide)
+
+/-- Five nonuniform runs use total length seven and ceiling log three. -/
+theorem ragged_general_bound (cmp : Nat → Nat → Bool) :
+    allComparisons cmp raggedRuns ≤ 21 ∧ allRevComparisons cmp raggedRuns ≤ 21 := by
+  have ho := allComparisons_le_clog cmp raggedRuns
+  have hr := allRevComparisons_le_clog cmp raggedRuns
+  have hlog : Nat.clog 2 5 = 3 := by decide
+  change allComparisons cmp raggedRuns ≤ 7 * Nat.clog 2 5 at ho
+  change allRevComparisons cmp raggedRuns ≤ 7 * Nat.clog 2 5 at hr
+  simpa only [hlog] using And.intro ho hr
+
+theorem source_ceiling_zero_one :
+    ⌈Real.logb 2 (0 : ℝ)⌉ = 0 ∧ ⌈Real.logb 2 (1 : ℝ)⌉ = 0 := by
+  simpa only [Nat.cast_zero, Nat.cast_one, Nat.clog_zero_right, Nat.clog_one_right] using
+    And.intro (int_ceil_logb_two_nat 0) (int_ceil_logb_two_nat 1)
+
+theorem source_half_at_five : Nat.clog 2 5 = Nat.clog 2 3 + 1 :=
+  clog_two_source_half 5 (by decide)
+
+theorem sorter_power_zero : comparisons natCompare [9] ≤ 0 ∧ revComparisons natCompare [9] ≤ 0 :=
+  ⟨comparisons_le_of_length_pow natCompare [9] 0 (by decide),
+    revComparisons_le_of_length_pow natCompare [9] 0 (by decide)⟩
+
+theorem empty_payload (cmp : Empty → Empty → Bool) (xs : List Empty) :
+    run cmp xs = ([], 0) ∧ revRun cmp xs = ([], 0) := by
+  cases xs with
+  | nil => exact ⟨run_nil cmp, revRun_nil cmp⟩
+  | cons x _ => exact Empty.elim x
+
+/-- The shared Growth bridge applies to both actual executions, uniformly in input length. -/
+theorem descending_families_isBigO :
+    Asymptotics.IsBigO Filter.atTop
+        (fun n => (comparisons natCompare (List.range n).reverse : ℝ))
+        (fun n => (n : ℝ) * Real.logb 2 n) ∧
+      Asymptotics.IsBigO Filter.atTop
+        (fun n => (revComparisons natCompare (List.range n).reverse : ℝ))
+        (fun n => (n : ℝ) * Real.logb 2 n) := by
+  constructor
+  · apply comparisons_isBigO natCompare (fun n => (List.range n).reverse)
+    intro n
+    simp
+  · apply revComparisons_isBigO natCompare (fun n => (List.range n).reverse)
+    intro n
+    simp
+
+end Examples.BottomUpCosts
