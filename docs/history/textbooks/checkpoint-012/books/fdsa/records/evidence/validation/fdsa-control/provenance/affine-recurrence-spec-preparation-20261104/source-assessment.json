  "requirement_mapping": [
    {
      "scope": "Ordinary all-input theorem",
      "source": [
        "Applications/Resources/AffineRecurrence.lean:31-38"
      ],
      "assessment": "Fixed recurrence data precede one existential pair A,B; n ranges over all naturals, and both constants are nonnegative. No function/child monotonicity, sign of f/K/C/D or final bound is a premise."
    },
    {
      "scope": "Finite prefix and division-free witnesses",
      "source": [
        "Applications/Resources/AffineRecurrence.lean:39-70"
      ],
      "assessment": "Archimedean natural multiples choose cutoff and slope. N=max n0(max 1 M); range(N+1) includes zero. B=max 0 finite_sup_f controls every n<=N; no field, norm, topology, completeness or floor is used."
    },
    {
      "scope": "Strict natural child decrease",
      "source": [
        "Applications/Resources/AffineRecurrence.lean:71-94"
      ],
      "assessment": "Contracted doubled sum and nonnegative casts yield each child<n; Nat.cast_lt reflects back before strong induction. The total f was supplied, not recursively defined by the theorem."
    },
    {
      "scope": "Signed toll and extra intercept absorption",
      "source": [
        "Applications/Resources/AffineRecurrence.lean:95-111"
      ],
      "assessment": "Positive parts of C,D and B>=0, together with n>=1, prove 2(Cn+D+B)<=A(1-rho)n. This exactly absorbs the extra child intercept after doubling the two IH bounds."
    },
    {
      "scope": "Natural quarter recurrence with actual definition-level termination",
      "source": [
        "Examples/AffineRecurrence.lean:19-55"
      ],
      "assessment": "Actual n<=1 cutoff and Nat.div_lt_self supply termination. Branch equations and values 1,1,5,7,19,31 at 0,1,2,4,8,16 match independent arithmetic."
    },
    {
      "scope": "Rational generic application",
      "source": [
        "Examples/AffineRecurrence.lean:59-73"
      ],
      "assessment": "rho=1/2,K=0,C=1,D=1, both child maps n/4 and cutoff1. Natural division product bound is cast and supplies every remainder; actual quarter branch supplies recurrence. No selector/runtime cost claim."
    },
    {
      "scope": "Signed integer nonfield application",
      "source": [
        "Examples/AffineRecurrence.lean:76-100"
      ],
      "assessment": "signed n=-n-1 has negative base and toll1-n, zero children and rho=0. Actual signed recurrence and nonpositive bound make the generic client satisfiable."
    },
    {
      "scope": "One-sided bound versus norm",
      "source": [
        "Examples/AffineRecurrence.lean:103-109"
      ],
      "assessment": "Negative square is nonpositive; concrete Int input2 has absolute value4. No signed Big-O theorem or complete asymptotic counterexample is claimed or required here."
    },
    {
      "scope": "Parameter quantifier order",
      "source": [
        "Examples/AffineRecurrence.lean:113-140"
      ],
      "assessment": "Per-p integer constant function has shared recurrence coefficients, but constants remain after p. Natural and arbitrary integer coefficient obstructions at n=0 rule out a common all-p intercept."
    },
