    {
      "name": "Examples.RandomSelectionMean.empty_means",
      "kind": "theorem",
      "private": false,
      "header": "theorem empty_means (k : Nat) :\n    scanMean k ([] : List \u03b1) = 0 \u2227 sourceMean k ([] : List \u03b1) = 2"
    },
    {
      "name": "Examples.RandomSelectionMean.singleton_means",
      "kind": "theorem",
      "private": false,
      "header": "theorem singleton_means (x : \u03b1) : scanMean 0 [x] = 1 \u2227 sourceMean 0 [x] = 9"
    },
    {
      "name": "Examples.RandomSelectionMean.invalid_singleton_means",
      "kind": "theorem",
      "private": false,
      "header": "theorem invalid_singleton_means :\n    scanMean 1 ([7] : List Nat) = 1 \u2227 sourceMean 1 ([7] : List Nat) = 11"
    },
    {
      "name": "Examples.RandomSelectionMean.integral_nat_map_fin",
      "kind": "theorem",
      "private": true,
      "header": "private theorem integral_nat_map_fin {n : Nat} (p : PMF (Fin n)) (f : Fin n \u2192 Nat) :\n    (\u222b k : Nat, (k : \u211d) \u2202(p.map f).toMeasure) =\n      \u2211 i : Fin n, (p i).toReal * (f i : \u211d)"
    },
    {
      "name": "Examples.RandomSelectionMean.two_key_scan_law",
      "kind": "theorem",
      "private": false,
      "header": "theorem two_key_scan_law :\n    scanLaw 0 ([0, 1] : List Nat) =\n      PMF.map (fun i : Fin 2 => if i = 0 then 2 else 3)\n        (Resources.RandomQuickSort.uniformIndex 1)"
    },
    {
      "name": "Examples.RandomSelectionMean.two_key_source_law",
      "kind": "theorem",
      "private": false,
      "header": "theorem two_key_source_law :\n    sourceLaw 0 ([0, 1] : List Nat) =\n      PMF.map (fun i : Fin 2 => if i = 0 then 11 else 20)\n        (Resources.RandomQuickSort.uniformIndex 1)"
    },
    {
      "name": "Examples.RandomSelectionMean.two_key_scan_mean",
      "kind": "theorem",
      "private": false,
      "header": "theorem two_key_scan_mean : scanMean 0 ([0, 1] : List Nat) = (5 : \u211d) / 2"
    },
    {
      "name": "Examples.RandomSelectionMean.two_key_source_mean",
      "kind": "theorem",
      "private": false,
      "header": "theorem two_key_source_mean : sourceMean 0 ([0, 1] : List Nat) = (31 : \u211d) / 2"
    },
    {
      "name": "Examples.RandomSelectionMean.duplicate_scan_law",
      "kind": "theorem",
      "private": false,
      "header": "theorem duplicate_scan_law (x : \u03b1) : scanLaw 1 [x, x] = PMF.pure 2"
    },
    {
      "name": "Examples.RandomSelectionMean.duplicate_source_law",
      "kind": "theorem",
      "private": false,
      "header": "theorem duplicate_source_law (x : \u03b1) :\n    sourceLaw 1 [x, x] = PMF.map (fun i : Fin 2 => 12 + i.val)\n      (Resources.RandomQuickSort.uniformIndex 1)"
    },
    {
      "name": "Examples.RandomSelectionMean.duplicate_means",
      "kind": "theorem",
      "private": false,
      "header": "theorem duplicate_means (x : \u03b1) :\n    scanMean 1 [x, x] = 2 \u2227 sourceMean 1 [x, x] = (25 : \u211d) / 2"
    },
    {
      "name": "Examples.RandomSelectionMean.two_key_scan_step",
      "kind": "theorem",
      "private": false,
      "header": "theorem two_key_scan_step :\n    scanExpectation 0 ([0, 1] : List Nat) =\n      2 + (2 : \u211d\u22650\u221e)\u207b\u00b9 * scanExpectation 0 ([0] : List Nat)"
    },
    {
      "name": "Examples.RandomSelectionMean.arbitrary_input_integrable",
      "kind": "theorem",
      "private": false,
      "header": "theorem arbitrary_input_integrable (k : Nat) (xs : List \u03b1) :\n    Integrable (fun w : Nat => (w : \u211d)) (scanLaw k xs).toMeasure \u2227\n      Integrable (fun t : Nat => (t : \u211d)) (sourceLaw k xs).toMeasure"
    },
    {
      "name": "Examples.RandomSelectionMean.actual_mean_bridge",
      "kind": "theorem",
      "private": false,
      "header": "theorem actual_mean_bridge (k : Nat) (xs : List \u03b1) :\n    scanMean k xs \u2264 sourceMean k xs \u2227 sourceMean k xs \u2264 9 * scanMean k xs + 2"
    },
    {
      "name": "Examples.RandomSelectionMean.selected_value_and_mean_bounds",
      "kind": "theorem",
      "private": false,
      "header": "theorem selected_value_and_mean_bounds (k : Nat) (xs : List \u03b1) (hk : k < xs.length)\n    (result : Outcome \u03b1) (hr : result \u2208 (run k xs).support) :\n    \u2203 a, result.1 = some a \u2227 Applications.Selection.RankedAt xs k a \u2227\n      (xs.length : \u211d) \u2264 scanMean k xs \u2227 scanMean k xs \u2264 sourceMean k xs"
    }
  ],
