SquareKit.Internal.DependentJudgments.Sigma.Reindexing.Tm.splitSubComp {V : Type} {Ω : List (Sigma.Judgment V)}
  {Γ Δ A B C d σ Θ τ : Sigma.Expression V} (hA : Sigma.Reindexing.Ty Γ A)
  (hB : Sigma.Reindexing.Ty (Sigma.extend Γ A) B) (hC : Sigma.Reindexing.Ty (Sigma.extend Γ (Sigma.sigma A B)) C)
  (hd : Sigma.Reindexing.Tm (Sigma.branchContext Γ A B) (Sigma.subTy C (Sigma.pack A B)) d)
  (hσ : Sigma.Reindexing.Sub Δ Γ σ) (hτ : Sigma.Reindexing.Sub Θ Δ τ) :
  have A₁ := Sigma.subTy A σ;
  have B₁ := Sigma.subTy B (Sigma.lift Δ A σ);
  have d₁ := Sigma.subTm d (Sigma.lift (Sigma.extend Δ A₁) B (Sigma.lift Δ A σ));
  Sigma.Reindexing.Equal
    (Sigma.subTm (Sigma.subTm (Sigma.split A B d) (Sigma.lift Δ (Sigma.sigma A B) σ))
      (Sigma.lift Θ (Sigma.sigma A₁ B₁) τ))
    (Sigma.split (Sigma.subTy A₁ τ) (Sigma.subTy B₁ (Sigma.lift Θ A₁ τ))
      (Sigma.subTm d₁ (Sigma.lift (Sigma.extend Θ (Sigma.subTy A₁ τ)) B₁ (Sigma.lift Θ A₁ τ))))
