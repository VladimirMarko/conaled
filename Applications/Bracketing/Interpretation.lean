import Applications.Bracketing.Array
import Applications.Optimization.Basic
import Squares

/-! Tree interpretations expose only leaf and fork operations. Their fusion
law justifies cached annotations independently of optimality. -/
namespace Bracketing

variable {α β γ δ : Type}

def Tree.fold (leaf : α → β) (fork : β → β → β) : Tree α → β
  | .leaf x => leaf x
  | .fork l r => fork (l.fold leaf fork) (r.fold leaf fork)

theorem Tree.fold_fusion (leaf : α → β) (fork : β → β → β)
    (leaf' : α → γ) (fork' : γ → γ → γ) (decode : β → γ)
    (onLeaf : ∀ x, decode (leaf x) = leaf' x)
    (onFork : ∀ l r, decode (fork l r) = fork' (decode l) (decode r))
    (t : Tree α) : decode (t.fold leaf fork) = t.fold leaf' fork' := by
  induction t with
  | leaf x => exact onLeaf x
  | fork l r ihl ihr => simp only [fold, onFork, ihl, ihr]

/-- Product interpretations compute two observations in one tree traversal. -/
theorem Tree.fold_pair (leaf : α → β) (fork : β → β → β)
    (leaf' : α → γ) (fork' : γ → γ → γ) (t : Tree α) :
    t.fold (fun x => (leaf x, leaf' x))
      (fun l r => (fork l.1 r.1, fork' l.2 r.2)) =
      (t.fold leaf fork, t.fold leaf' fork') := by
  induction t with
  | leaf x => rfl
  | fork l r ihl ihr => simp only [fold, ihl, ihr]

theorem Tree.fold_identity (t : Tree α) : t.fold Tree.leaf Tree.fork = t := by
  induction t with
  | leaf x => rfl
  | fork l r ihl ihr => simp only [fold, ihl, ihr]

open Recursive Cached

theorem cached_fold (h f : Nat → Nat → Nat) (t : Tree α) :
    t.fold (fun x => (0, 1, Tree.leaf x)) (forkT h f) = pack h f t := by
  have he := Tree.fold_fusion Tree.leaf Tree.fork
    (fun x => (0, 1, Tree.leaf x)) (forkT h f) (pack h f)
    (fun _ => rfl) (fun _ _ => rfl) t
  rw [Tree.fold_identity] at he
  exact he.symm

abbrev Input (α : Type) := {ws : List α // ws ≠ []}

def inputRep (α : Type) : Squares.Rep where
  R := Input α
  S := Input α
  decode := id

def cacheRep (α : Type) : Squares.Rep where
  R := Triple α
  S := Tree α
  decode := treeT

def treeRep (α : Type) : Squares.Rep where
  R := Tree α
  S := Tree α
  decode := id

/-- The implementation builds the table; its exact meaning is the recursive
choice, including the recursively selected first ties. -/
def arraySquare (h f : Nat → Nat → Nat) : Squares.Square (inputRep α) (cacheRep α) where
  impl := fun ws => (Array.mct3Tuple h f ws.val).get
    (by rw [Array.mct3Tuple_eq_triple h f ws.val ws.property]; rfl)
  spec := fun ws => mctH h f ws.val ws.property
  commutes := fun ws => by
    change treeT ((Array.mct3Tuple h f ws.val).get _) = _
    rw [Option.get_of_eq_some _ (Array.mct3Tuple_eq_triple h f ws.val ws.property)]
    exact mct2_eq_mct h f ws.val ws.property

def forgetCache : Squares.Square (cacheRep α) (treeRep α) where
  impl := treeT
  spec := id
  commutes := fun _ => rfl

def solveSquare (h f : Nat → Nat → Nat) : Squares.Square (inputRep α) (treeRep α) :=
  Squares.compose forgetCache (arraySquare h f)

theorem minimum_iff_minimizer (h f : Nat → Nat → Nat) (ws : List α) (t : Tree α) :
    MinimumH h f ws t ↔ t ∈ Optimization.minimizers {u | fringeSpec u = ws} (costH h f) := by
  rfl

/-- Exact refinement transports the independent all-tree optimum, rather than
restricting comparison to trees generated by the implementation. -/
theorem solveSquare_minimizer (h f : Nat → Nat → Nat) (hm : Monotone2 h)
    (ws : Input α) : (solveSquare h f).impl ws ∈
      Optimization.minimizers {u | fringeSpec u = ws.val} (costH h f) := by
  have he := (solveSquare (α := α) h f).commutes ws
  change (solveSquare h f).impl ws = mctH h f ws.val ws.property at he
  rw [he]
  exact (minimum_iff_minimizer h f _ _).mp (mctH_minimum h f hm ws.val ws.property)

end Bracketing
