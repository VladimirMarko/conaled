import Applications.Search.HeuristicTermination
import SquareKit.Relations

/-! Completed static searches interpreted as independent shortest distances.
Fuel exhaustion remains outside this completed-input domain. Finite closure
supplies an inhabitant; it is not an assumed optimum. Paths with tied costs need
not agree between queue representations. -/
namespace Search.Heuristic
variable {V : Type} [DecidableEq V]

def Completed (Q : Frontier V) (g : Graph V) (h : Heuristic V)
    (goal : V → Bool) (s : V) :=
  {fuel : Nat // (run Q .reopen g h goal fuel [] (start Q h s)).isSome}

theorem completed_exists (Q : Frontier V) (g : Graph V) (h : Heuristic V)
    (goal : V → Bool) (domain : List V) (s : V) (hs : s ∈ domain)
    (closed : ∀ u ∈ domain, ∀ v d, (v,d) ∈ g u → v ∈ domain) :
    Nonempty (Completed Q g h goal s) := by
  obtain ⟨fuel,out,he⟩ := astar_terminates Q g h goal domain s hs closed
  exact ⟨⟨fuel, by rw [he]; rfl⟩⟩

def pathResultRep (g : Graph V) (goal : V → Bool) (s : V) : Relational.RelRep :=
  ⟨Option (Path V), Unit, fun out _ => CorrectResult g goal s out⟩

def completedRep (Q : Frontier V) (g : Graph V) (h : Heuristic V)
    (goal : V → Bool) (s : V) : Relational.RelRep :=
  ⟨Completed Q g h goal s, Unit, fun _ _ => True⟩

def astarSquare (Q : Frontier V) (g : Graph V) (h : Heuristic V)
    (goal : V → Bool) (s : V) (ho : Optimistic g h goal) :
    Relational.RelSquare (completedRep Q g h goal s) (pathResultRep g goal s) where
  impl budget := (run Q .reopen g h goal budget.val [] (start Q h s)).get budget.property
  spec _ := ()
  preserves := by
    intro budget _ _
    apply astar_correct Q g h goal s ho budget.val
    exact (Option.some_get budget.property).symm

/-- A distance specification over all graph walks, independently of paths
stored or generated by either queue implementation. -/
def DistanceResult (g : Graph V) (goal : V → Bool) (s : V) : Option Nat → Prop
  | none => NoGoal g goal s
  | some c => ∃ t, Walk g s t c ∧ goal t = true ∧
      ∀ u d, Walk g s u d → goal u = true → c ≤ d

def distanceRep (g : Graph V) (goal : V → Bool) (s : V) : Relational.RelRep :=
  ⟨Option Nat, Unit, fun out _ => DistanceResult g goal s out⟩

def observeDistance (g : Graph V) (goal : V → Bool) (s : V) :
    Relational.RelSquare (pathResultRep g goal s) (distanceRep g goal s) where
  impl := Option.map Path.cost
  spec _ := ()
  preserves := by
    intro out _ correct
    cases out with
    | none => exact correct
    | some p => exact ⟨p.vertex, route_walk correct.1, correct.2.1, correct.2.2⟩

def distanceSquare (Q : Frontier V) (g : Graph V) (h : Heuristic V)
    (goal : V → Bool) (s : V) (ho : Optimistic g h goal) :
    Relational.RelSquare (completedRep Q g h goal s) (distanceRep g goal s) :=
  Relational.compose (observeDistance g goal s) (astarSquare Q g h goal s ho)

theorem distanceSquare_correct (Q : Frontier V) (g : Graph V) (h : Heuristic V)
    (goal : V → Bool) (s : V) (ho : Optimistic g h goal) (budget : Completed Q g h goal s) :
    DistanceResult g goal s ((distanceSquare Q g h goal s ho).impl budget) :=
  (distanceSquare Q g h goal s ho).preserves (s := ()) True.intro

end Search.Heuristic
