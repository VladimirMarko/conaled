import Applications.Matroid.Flats
import Mathlib.Order.Atoms

/-! # Finite geometric lattices and simple matroids

A geometric lattice is supplied through `Finite`, `IsAtomistic`, and
`IsUpperModularLattice` instances on a complete lattice. Atom-generated closure
constructs its matroid; the flat lattice recovers the original order. In the
other direction singleton flats identify the actual ground with the atoms,
and reconstruction returns the entire original ambient matroid.
-/

set_option autoImplicit false
set_option warningAsError true

open Set
namespace Applications.Matroid

/-- Simplicity as absence of loops and of nontrivial singleton closures. -/
class IsSimple {α : Type*} (M : _root_.Matroid α) : Prop where
  closure_empty : M.closure ∅ = ∅
  closure_singleton : ∀ e ∈ M.E, M.closure {e} = {e}

namespace Geometric
variable (L : Type*) [CompleteLattice L]

abbrev Atom := {a : L // IsAtom a}

def joinAtoms (X : Set (Atom L)) : L := sSup (Subtype.val '' X)
def below (a : L) : Set (Atom L) := {p | p.val ≤ a}

theorem join_le_iff (X : Set (Atom L)) (a : L) : joinAtoms L X ≤ a ↔ X ⊆ below L a := by
  simp [joinAtoms, below, sSup_le_iff, Set.subset_def]

theorem join_below [IsAtomistic L] (a : L) : joinAtoms L (below L a) = a := by
  rw [joinAtoms]
  have h : Subtype.val '' below L a = {p : L | IsAtom p ∧ p ≤ a} := by
    ext p
    simp [below, and_comm]
  rw [h, sSup_atoms_le_eq]

theorem join_insert (p : Atom L) (X : Set (Atom L)) :
    joinAtoms L (insert p X) = p.val ⊔ joinAtoms L X := by
  simp [joinAtoms]

theorem join_singleton (p : Atom L) : joinAtoms L {p} = p.val := by simp [joinAtoms]

theorem atom_sup_covers [IsUpperModularLattice L] (p : Atom L) (a : L) (h : ¬ p.val ≤ a) :
    a ⋖ p.val ⊔ a := by
  have hi : p.val ⊓ a = ⊥ := p.property.2 _ (lt_of_le_of_ne inf_le_left (by
    intro heq
    exact h (heq ▸ inf_le_right)))
  exact IsUpperModularLattice.covBy_sup_of_inf_covBy (hi ▸ p.property.bot_covBy)

/-- Closure generated by atoms below the join of the selected atoms. -/
def closurePresentation [Finite L] [IsAtomistic L] [IsUpperModularLattice L] :
    ClosurePresentation (Atom L) where
  ground := univ
  finite_ground := toFinite _
  cl := fun X ↦ below L (joinAtoms L X)
  subset_ground := fun _ ↦ subset_univ _
  inter_ground := fun _ ↦ by rw [inter_univ]
  extensive := by
    intro X p hp
    exact le_sSup (mem_image_of_mem Subtype.val hp.1)
  mono := by
    intro X Y h p hp
    exact hp.trans (sSup_le_sSup (image_mono h))
  idempotent := fun X ↦ by rw [join_below]
  exchange := by
    intro X x y hx
    have hxle := hx.1
    have hxnot := hx.2
    change ¬ x.val ≤ joinAtoms L X at hxnot
    rw [join_insert] at hxle
    have hynot : ¬ y.val ≤ joinAtoms L X := by
      intro hy
      exact hxnot (hxle.trans (sup_le hy le_rfl))
    have hcov := atom_sup_covers L y (joinAtoms L X) hynot
    have hlt : joinAtoms L X < x.val ⊔ joinAtoms L X :=
      lt_of_le_of_ne le_sup_right (by
        intro heq
        exact hxnot (le_sup_left.trans_eq heq.symm))
    have hle : x.val ⊔ joinAtoms L X ≤ y.val ⊔ joinAtoms L X := sup_le hxle le_sup_right
    have heq : x.val ⊔ joinAtoms L X = y.val ⊔ joinAtoms L X :=
      hle.eq_of_not_lt (fun hlt' ↦ hcov.2 hlt hlt')
    change y.val ≤ joinAtoms L (insert x X)
    rw [join_insert, heq]
    exact le_sup_left

noncomputable def matroid [Finite L] [IsAtomistic L] [IsUpperModularLattice L] :
    _root_.Matroid (Atom L) := (closurePresentation L).matroid

variable [Finite L] [IsAtomistic L] [IsUpperModularLattice L]

@[simp] theorem closure_eq (X : Set (Atom L)) :
    (matroid L).closure X = below L (joinAtoms L X) := (closurePresentation L).matroid_closure X

instance : IsSimple (matroid L) where
  closure_empty := by
    rw [closure_eq]
    ext p
    simp [below, joinAtoms, p.property.ne_bot]
  closure_singleton := by
    intro p _
    rw [closure_eq, join_singleton]
    ext q
    change q.val ≤ p.val ↔ q = p
    rw [p.property.le_iff_eq q.property.ne_bot, Subtype.ext_iff]

/-- Recover the geometric lattice with its explicit atom-incidence representation. -/
noncomputable def flatsIso : L ≃o Flat (matroid L) where
  toFun a := Flat.ofIsFlat _ (below L a) (by
    rw [_root_.Matroid.isFlat_iff_closure_eq, closure_eq, join_below])
  invFun F := joinAtoms L (Flat.carrier _ F)
  left_inv a := join_below L a
  right_inv F := by
    apply Flat.ext
    exact (closure_eq L (Flat.carrier _ F)).symm.trans (Flat.carrier_isFlat _ F).closure
  map_rel_iff' := by
    intro a b
    change below L a ⊆ below L b ↔ a ≤ b
    constructor
    · intro h
      rw [← join_below L a, ← join_below L b]
      exact sSup_le_sSup (image_mono h)
    · intro h p hp
      exact hp.trans h
end Geometric
namespace Flat
variable {α : Type*} (M : _root_.Matroid α)

@[simp] theorem carrier_inf (F G : Flat M) : carrier M (F ⊓ G) = carrier M F ∩ carrier M G := rfl

theorem sup_eq_span (F G : Flat M) : F ⊔ G = span M (carrier M F ∪ carrier M G) := by
  apply le_antisymm
  · apply sup_le
    · exact subset_union_left.trans (M.subset_closure _ (union_subset (carrier_subset M F) (carrier_subset M G)))
    · exact subset_union_right.trans (M.subset_closure _ (union_subset (carrier_subset M F) (carrier_subset M G)))
  · apply (span_le_iff M _ _).mpr
    exact inter_subset_left.trans (union_subset (show F ≤ F ⊔ G from le_sup_left) (show G ≤ F ⊔ G from le_sup_right))

theorem covBy_span_insert (F : Flat M) {e : α} (he : e ∈ M.E \ carrier M F) :
    F ⋖ span M (insert e (carrier M F)) := by
  have hle : F ≤ span M (insert e (carrier M F)) :=
    (subset_insert _ _).trans (M.subset_closure _ (insert_subset he.1 (carrier_subset M F)))
  have hem : e ∈ carrier M (span M (insert e (carrier M F))) :=
    M.subset_closure _ (insert_subset he.1 (carrier_subset M F)) (mem_insert _ _)
  refine ⟨lt_of_le_of_ne hle (fun h ↦ he.2 (h ▸ hem)), ?_⟩
  intro G hFG hGF
  obtain ⟨x, hxG, hxF⟩ := not_subset.mp (show ¬ carrier M G ⊆ carrier M F from hFG.not_ge)
  have hxcl : x ∈ M.closure (insert e (carrier M F)) \ M.closure (carrier M F) := by
    rw [(carrier_isFlat M F).closure]
    exact ⟨hGF.le hxG, hxF⟩
  have hecl := (M.closure_exchange hxcl).1
  have heG : e ∈ carrier M G := by
    have hh := M.closure_subset_closure (insert_subset hxG hFG.le) hecl
    simpa only [(carrier_isFlat M G).closure] using hh
  apply hGF.not_ge
  apply (span_le_iff M _ G).mpr
  exact inter_subset_left.trans (insert_subset heG hFG.le)

instance [M.Finite] : Finite (Flat M) := by
  let : Finite M.E := M.ground_finite
  apply Finite.of_injective (fun F : Flat M ↦ {e : M.E | e.val ∈ carrier M F})
  intro F G h
  apply ext
  ext e
  constructor
  · intro he
    exact (Set.ext_iff.mp h ⟨e, carrier_subset M F he⟩).mp he
  · intro he
    exact (Set.ext_iff.mp h ⟨e, carrier_subset M G he⟩).mpr he

instance : IsUpperModularLattice (Flat M) where
  covBy_sup_of_inf_covBy := by
    intro F G h
    have hn : ¬ carrier M F ⊆ carrier M G := by
      intro hFG
      exact h.ne (inf_eq_left.mpr hFG)
    obtain ⟨e, heF, heG⟩ := not_subset.mp hn
    have heE := carrier_subset M F heF
    have hcov := covBy_span_insert M (F ⊓ G) ⟨heE, fun h ↦ heG h.2⟩
    have hspan : span M (insert e (carrier M (F ⊓ G))) ≤ F := by
      apply (span_le_iff M _ F).mpr
      exact inter_subset_left.trans (insert_subset heF inf_le_left)
    have heq : span M (insert e (carrier M (F ⊓ G))) = F :=
      hspan.eq_of_not_lt (fun hlt ↦ h.2 hcov.lt hlt)
    have hs : F ⊔ G = span M (insert e (carrier M G)) := by
      apply le_antisymm
      · apply sup_le
        · rw [← heq]
          exact M.closure_subset_closure (insert_subset_insert inf_le_right)
        · exact (covBy_span_insert M G ⟨heE, heG⟩).le
      · apply (span_le_iff M _ (F ⊔ G)).mpr
        exact inter_subset_left.trans (insert_subset ((show F ≤ F ⊔ G from le_sup_left) heF) (show G ≤ F ⊔ G from le_sup_right))
    rw [hs]
    exact covBy_span_insert M G ⟨heE, heG⟩

variable [IsSimple M]

@[simp] theorem simple_carrier_bot : carrier M (⊥ : Flat M) = ∅ := by
  rw [carrier_bot, IsSimple.closure_empty]

def point (e : M.E) : Flat M := ofIsFlat M {e.val}
  (_root_.Matroid.isFlat_iff_closure_eq.mpr (IsSimple.closure_singleton e.val e.property))

@[simp] theorem carrier_point (e : M.E) : carrier M (point M e) = {e.val} := rfl

theorem point_ne_bot (e : M.E) : point M e ≠ ⊥ := by
  intro h
  have hc := congrArg (carrier M) h
  rw [carrier_point, simple_carrier_bot] at hc
  exact singleton_ne_empty _ hc

theorem point_atom (e : M.E) : IsAtom (point M e) := by
  refine ⟨point_ne_bot M e, ?_⟩
  intro F hF
  apply ext
  rw [simple_carrier_bot]
  apply eq_empty_iff_forall_notMem.mpr
  intro x hx
  have hxe : x = e.val := hF.le hx
  apply hF.not_ge
  intro y hy
  have hye : y = e.val := hy
  change y ∈ carrier M F
  simpa only [hye, hxe] using hx

theorem atom_eq_point (F : Flat M) (hF : IsAtom F) : ∃ e : M.E, F = point M e := by
  have hn : (carrier M F).Nonempty := by
    apply Set.nonempty_iff_ne_empty.mpr
    intro he
    exact hF.ne_bot (ext M (he.trans (simple_carrier_bot M).symm))
  obtain ⟨e, he⟩ := hn
  let p : M.E := ⟨e, carrier_subset M F he⟩
  exact ⟨p, ((hF.le_iff_eq (point_ne_bot M p)).mp (singleton_subset_iff.mpr he)).symm⟩

instance : IsAtomistic (Flat M) := by
  apply CompleteLattice.isAtomistic_iff.mpr
  intro F
  refine ⟨{P | ∃ e : M.E, e.val ∈ carrier M F ∧ P = point M e}, ?_, ?_⟩
  · apply le_antisymm
    · intro e he
      change e ∈ carrier M F at he
      have h := le_sSup (show point M ⟨e, carrier_subset M F he⟩ ∈
        {P | ∃ e : M.E, e.val ∈ carrier M F ∧ P = point M e} from ⟨_, he, rfl⟩)
      exact h (mem_singleton e)
    · apply sSup_le
      rintro P ⟨e, he, rfl⟩
      exact singleton_subset_iff.mpr he
  · rintro P ⟨e, _, rfl⟩
    exact point_atom M e

/-- Every ground element corresponds to exactly one atom of the flat lattice. -/
noncomputable def groundEquivAtoms : M.E ≃ Geometric.Atom (Flat M) :=
  Equiv.ofBijective (fun e ↦ ⟨point M e, point_atom M e⟩) ⟨by
    intro e f h
    apply Subtype.ext
    have hc := congrArg (fun a : Geometric.Atom (Flat M) ↦ carrier M a.val) h
    exact singleton_injective hc,
    by
      intro F
      obtain ⟨e, he⟩ := atom_eq_point M F.val F.property
      exact ⟨e, Subtype.ext he.symm⟩⟩

@[simp] theorem groundEquivAtoms_apply (e : M.E) :
    (groundEquivAtoms M e).val = point M e := rfl

theorem join_points (X : Set M.E) :
    Geometric.joinAtoms (Flat M) (groundEquivAtoms M '' X) = span M (Subtype.val '' X) := by
  apply le_antisymm
  · apply sSup_le
    rintro P ⟨a, ⟨e, he, rfl⟩, rfl⟩
    change point M e ≤ span M (Subtype.val '' X)
    intro x hx
    have hxe : x = e.val := hx
    subst x
    exact M.subset_closure _ (by rintro x ⟨p, _, rfl⟩; exact p.property)
      (mem_image_of_mem _ he)
  · apply (span_le_iff M _ _).mpr
    rintro x ⟨⟨e, he, rfl⟩, _⟩
    have h : point M e ≤ Geometric.joinAtoms (Flat M) (groundEquivAtoms M '' X) :=
      le_sSup ⟨groundEquivAtoms M e, mem_image_of_mem _ he, rfl⟩
    exact h (mem_singleton _)

variable [M.Finite]

/-- The ground subtype retains every labelled element; the ambient complement is excluded. -/
instance finiteGround : Finite M.E := M.ground_finite

/-- Reconstruct the ground restriction, with the specified singleton-flat relabelling. -/
theorem reconstruct : Geometric.matroid (Flat M) =
    (M.comap (Subtype.val : M.E → α)).mapEquiv (groundEquivAtoms M) := by
  apply _root_.Matroid.ext_closure
  intro X
  let e := groundEquivAtoms M
  have hX : X = e '' (e.symm '' X) := by simp
  rw [hX, relabel_closure, Geometric.closure_eq, join_points]
  ext p
  constructor
  · intro hp
    change p.val ≤ span M (Subtype.val '' (e.symm '' X)) at hp
    have hpeq : p = e (e.symm p) := (e.apply_symm_apply p).symm
    have hmem : (e.symm p).val ∈ M.closure (Subtype.val '' (e.symm '' X)) := by
      rw [hpeq] at hp
      exact hp (mem_singleton _)
    exact ⟨e.symm p, by rw [_root_.Matroid.comap_closure_eq]; exact hmem,
      e.apply_symm_apply p⟩
  · rintro ⟨q, hq, rfl⟩
    change point M q ≤ span M (Subtype.val '' (e.symm '' X))
    rw [_root_.Matroid.comap_closure_eq] at hq
    exact singleton_subset_iff.mpr hq

/-- Return the reconstructed object to the original ambient type, retaining its ground. -/
noncomputable def restore : _root_.Matroid α :=
  ((Geometric.matroid (Flat M)).mapEquiv (groundEquivAtoms M).symm).mapEmbedding
    ⟨(Subtype.val : M.E → α), Subtype.val_injective⟩

@[simp] theorem restore_eq : restore M = M := by
  unfold restore
  rw [reconstruct]
  have h : ((M.comap (Subtype.val : M.E → α)).mapEquiv
      (groundEquivAtoms M)).mapEquiv (groundEquivAtoms M).symm = M.comap Subtype.val := by
    apply _root_.Matroid.ext_indep
    · simp
    · intro I _; simp
  rw [h]
  exact _root_.Matroid.map_comap (by simp) Subtype.val_injective.injOn

/-- All four observations survive reconstruction on arbitrary ambient subsets. -/
theorem restore_observations (X : Set α) :
    ((restore M).Indep X ↔ M.Indep X) ∧
    ((restore M).IsCircuit X ↔ M.IsCircuit X) ∧
    (restore M).closure X = M.closure X ∧ (restore M).eRk X = M.eRk X := by
  rw [restore_eq]
  exact ⟨Iff.rfl, Iff.rfl, rfl, rfl⟩

@[simp] theorem restore_ground : (restore M).E = M.E := by rw [restore_eq]

end Flat
end Applications.Matroid
