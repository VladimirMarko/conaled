import Mathlib.Combinatorics.Matroid.Closure
import Mathlib.Combinatorics.Matroid.IndepAxioms

/-! # Finite matroids from closure axioms

The ambient type may contain elements outside the finite ground set. Closure
ignores those elements; independence excludes them.
-/

set_option autoImplicit false
set_option warningAsError true

open Set

namespace Applications.Matroid

/-- Ground-aware finite closure axioms, including Steinitz exchange. -/
structure ClosurePresentation (α : Type*) where
  ground : Set α
  finite_ground : ground.Finite
  cl : Set α → Set α
  subset_ground : ∀ X, cl X ⊆ ground
  inter_ground : ∀ X, cl (X ∩ ground) = cl X
  extensive : ∀ X, X ∩ ground ⊆ cl X
  mono : Monotone cl
  idempotent : ∀ X, cl (cl X) = cl X
  exchange : ∀ {X x y}, x ∈ cl (insert y X) \ cl X → y ∈ cl (insert x X)

namespace ClosurePresentation

variable {α : Type*} (C : ClosurePresentation α)

/-- No element is generated by the other elements of the set. -/
def Indep (I : Set α) : Prop :=
  I ⊆ C.ground ∧ ∀ e ∈ I, e ∉ C.cl (I \ {e})

theorem subset_cl {I : Set α} (hI : I ⊆ C.ground) : I ⊆ C.cl I :=
  fun _ he ↦ C.extensive I ⟨he, hI he⟩

theorem indep_empty : C.Indep ∅ := ⟨empty_subset _, by simp⟩

theorem indep_subset {I J : Set α} (hJ : C.Indep J) (hIJ : I ⊆ J) : C.Indep I := by
  refine ⟨hIJ.trans hJ.1, fun e he hc ↦ hJ.2 e (hIJ he) ?_⟩
  exact C.mono (sdiff_subset_sdiff_left hIJ) hc

theorem insert_indep {I : Set α} {e : α} (hI : C.Indep I)
    (he : e ∈ C.ground) (hc : e ∉ C.cl I) : C.Indep (insert e I) := by
  refine ⟨insert_subset he hI.1, ?_⟩
  intro x hx hxcl
  rcases hx with rfl | hx
  · exact hc (C.mono (by intro y hy; rcases hy.1 with h | h; exact False.elim (hy.2 h); exact h) hxcl)
  · have hxcl' : x ∈ C.cl (insert e (I \ {x})) := C.mono (by
      intro y hy
      rcases hy.1 with rfl | hyI
      · exact mem_insert _ _
      · exact mem_insert_of_mem _ ⟨hyI, hy.2⟩) hxcl
    have hecl := C.exchange ⟨hxcl', hI.2 x hx⟩
    exact hc (C.mono (by simp [hx]) hecl)

theorem maximal_iff {I : Set α} (hI : C.Indep I) :
    Maximal C.Indep I ↔ C.cl I = C.ground := by
  constructor
  · intro hm
    apply (C.subset_ground I).antisymm
    intro e he
    by_contra hc
    have hi := hm.2 (C.insert_indep hI he hc) (subset_insert e I)
    exact hc (C.subset_cl hI.1 (hi (mem_insert e I)))
  · intro hcl
    refine ⟨hI, ?_⟩
    intro J hJ hIJ e heJ
    by_contra heI
    apply hJ.2 e heJ
    apply C.mono (show I ⊆ J \ {e} from fun x hx ↦ ⟨hIJ hx, by
      intro hxe; exact heI (mem_singleton_iff.mp hxe ▸ hx)⟩)
    rw [hcl]
    exact hJ.1 heJ

theorem augment {I B : Set α} (hI : C.Indep I) (hn : ¬ Maximal C.Indep I)
    (hB : Maximal C.Indep B) : ∃ e ∈ B \ I, C.Indep (insert e I) := by
  classical
  have hnB : ¬ B ⊆ C.cl I := by
    intro h
    apply hn
    apply (C.maximal_iff hI).mpr
    apply (C.subset_ground I).antisymm
    rw [← (C.maximal_iff hB.1).mp hB, ← C.idempotent I]
    exact C.mono h
  obtain ⟨e, heB, hecl⟩ := not_subset.mp hnB
  exact ⟨e, ⟨heB, fun heI ↦ hecl (C.subset_cl hI.1 heI)⟩,
    C.insert_indep hI (hB.1.1 heB) hecl⟩

/-- Construct a matroid from closure, without supplying a matroid realization. -/
noncomputable def matroid : _root_.Matroid α :=
  (IndepMatroid.ofBdd C.ground C.Indep C.indep_empty
    (fun _ _ ↦ C.indep_subset) (fun _ _ ↦ C.augment)
    (fun _ h ↦ h.1) ⟨C.ground.ncard, fun I h ↦ by
      rw [C.finite_ground.cast_ncard_eq]
      exact encard_le_encard h.1⟩).matroid

@[simp] theorem matroid_ground : C.matroid.E = C.ground := rfl

@[simp] theorem matroid_indep {I : Set α} : C.matroid.Indep I ↔ C.Indep I := Iff.rfl

instance : C.matroid.Finite := ⟨C.finite_ground⟩

/-- The constructed matroid has exactly the supplied closure on every ambient set. -/
@[simp] theorem matroid_closure (X : Set α) : C.matroid.closure X = C.cl X := by
  classical
  have hind : ∀ I, C.Indep I → C.matroid.closure I = C.cl I := by
    intro I hI
    ext e
    rw [(show C.matroid.Indep I from hI).mem_closure_iff']
    constructor
    · rintro ⟨he, h⟩
      by_contra hc
      exact hc (C.subset_cl hI.1 (h (C.insert_indep hI he hc)))
    · intro hc
      refine ⟨C.subset_ground I hc, fun hi ↦ ?_⟩
      by_contra heI
      apply hi.2 e (mem_insert e I)
      exact C.mono (by intro x hx; exact ⟨mem_insert_of_mem _ hx, by
        intro h; exact heI (mem_singleton_iff.mp h ▸ hx)⟩) hc
  obtain ⟨I, hI⟩ := C.matroid.exists_isBasis (X ∩ C.ground) inter_subset_right
  have hXI : X ∩ C.ground ⊆ C.cl I := by
    intro e he
    by_contra hc
    have hi := C.insert_indep hI.indep he.2 hc
    have heI : e ∈ I := by
      rw [(hI.eq_of_subset_indep hi (subset_insert _ _) (insert_subset he hI.subset))]
      exact mem_insert _ _
    exact hc (C.subset_cl hI.indep.1 heI)
  calc
    C.matroid.closure X = C.matroid.closure I := by
      rw [← C.matroid.closure_inter_ground X, matroid_ground, ← hI.closure_eq_closure]
    _ = C.cl I := hind I hI.indep
    _ = C.cl (X ∩ C.ground) := (C.mono hI.subset).antisymm (by
      simpa only [C.idempotent] using C.mono hXI)
    _ = C.cl X := C.inter_ground X

/-- Read the closure axioms of a native finite matroid. -/
def ofMatroid (M : _root_.Matroid α) [M.Finite] : ClosurePresentation α where
  ground := M.E
  finite_ground := M.ground_finite
  cl := M.closure
  subset_ground := M.closure_subset_ground
  inter_ground := M.closure_inter_ground
  extensive := M.inter_ground_subset_closure
  mono := fun _ _ h ↦ M.closure_subset_closure h
  idempotent := M.closure_closure
  exchange := fun h ↦ (M.closure_exchange h).1

@[simp] theorem ofMatroid_matroid (M : _root_.Matroid α) [M.Finite] :
    (ofMatroid M).matroid = M := by
  apply _root_.Matroid.ext_closure
  intro X
  exact (ofMatroid M).matroid_closure X

@[simp] theorem matroid_ofMatroid : ofMatroid C.matroid = C := by
  cases C with
  | mk E hE cl hground hinter hext hmono hidem hex =>
    have hcl := matroid_closure (ClosurePresentation.mk E hE cl hground hinter hext hmono hidem hex)
    simp only [ofMatroid, matroid_ground]
    congr
    exact funext hcl

end ClosurePresentation
end Applications.Matroid
