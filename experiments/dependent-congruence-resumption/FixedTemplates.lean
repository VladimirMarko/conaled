import SquareKit.Internal.PathTransport.ConcatenationCongr
import SquareKit.Internal.PathTransport.TransferFrame

/-! Bounded #107 experiment. These are applications of the existing generated
rules, not a proposed new author API. The template is fixed before the second
substitution. Freshly rebuilding a named operation is a separate comparison. -/
namespace Experiments.DependentCongruenceResumption
open SquareKit.Internal.PathTransport
open SquareKit.Internal.PathTransport.Typed
open SquareKit.Internal.PathTransport.Typed.Authoring
set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true

variable (hΓ : CtxDeriv Γ γ) (hΔ : CtxDeriv Δ δ)
variable {x y z : BasePoint Γ γ} (p : Path x y) (q : Path y z)
variable (hs : SubDeriv Δ δ Γ γ σ s)

/-- The actual dependent argument environment contains y, p : x = y,
z, and q : y = z. Its construction needs no caller annotation equality. -/
def concatArguments := ConcatApplication.endpoint hΓ x y z p q

def concatOpen := (ConcatFrame.command hΓ x).genericTerm

def concatApplied := TmDeriv.sub (concatOpen hΓ (x := x)) (concatArguments hΓ p q)

/-- Both routes preserve the fixed open term and its generated derivation.
The type comparison and annotation cast are generated by source substitution
composition, without equality arguments supplied by this caller. -/
def concatApplicationReindex := TmEqDeriv.subComp (concatOpen hΓ (x := x))
  (concatArguments hΓ p q) hs

/-- Arbitrary typed substitutions include projections from dependent telescope
contexts. The telescope is arbitrary, rather than restricted to fixed sorts. -/
def concatUnderDependentTail
    (hT : TelDeriv Γ γ n Ξ T) :=
  concatApplicationReindex hΓ p q (SubDeriv.projection hΓ hT)

/-- Build the new argument environment from substituted named paths. This
construction succeeds independently of the unresolved command comparison. -/
def freshConcatArguments := ConcatApplication.endpoint hΔ (x.reindex hs)
  (y.reindex hs) (z.reindex hs) (p.reindex hΓ hs) (q.reindex hΓ hs)

/-- Applying a fixed template at generated-convertible arguments inherits
source congruence. The result remains in the left pulled-back motive. -/
def concatApplicationCongr (p' : Path x y)
    (ep : TmEqDeriv Γ γ (.identity .base x.raw y.raw)
      (identityCode (baseCode γ) x.code y.code) p.raw p.code p'.raw p'.code) :=
  TmEqDeriv.substitutionCongr (concatOpen hΓ (x := x))
    (concat_endpoints_congr hΓ p p' q ep)

/-- Beta for the same nonempty dependent template: the original reflexive
branch and its arguments are constructed by the existing command builder. -/
def concatTemplateBeta := (ConcatFrame.command hΓ x).reflexiveBeta

/-- The generic source template really has the retained named concat syntax
when applied to its original argument environment. -/
theorem concatApplicationRaw :
    (genericJRaw 2 .base x.raw (ConcatFrame.command hΓ x).motive.raw
      (ConcatFrame.command hΓ x).motive.branch).sub
      (eliminationSub y.raw p.raw (ConcatApplication.arguments y z q)) =
      (concat hΓ p q).raw := by
  unfold eliminationSub
  rw [genericJRaw_sub]
  simp only [Expr.sub_id, Expr.liftSubN_var]
  rfl

/-- Concrete dependent extension: q : y = z is retained and a new
b : fiber x is introduced. Neither argument is specialized to reflexivity. -/
def concatWithFiberTail (x : BasePoint Γ γ) :=
  concatApplicationReindex (TransferFrame.beforeB hΓ x)
    (TransferFrame.firstBeforeB hΓ x) (ConcatFrame.q hΓ x)
    (TransferFrame.forgetB hΓ x)

variable (b : FiberElement x)

def transportOpen := (transportCommand hΓ x b).genericTerm

def transportArguments := SubDeriv.endpoint hΓ (.base hΓ) x.deriv y.deriv p.deriv

/-- The very same generated composition rule works for transport. -/
def transportApplicationReindex := TmEqDeriv.subComp (transportOpen hΓ b)
  (transportArguments hΓ p) hs

/-- Existing presentation coherence DOES additionally reach freshly built
transport. This result is stronger than fixed-template composition. -/
theorem transportFreshComparison :
    ((transport hΓ p b).reindex hs).code =
      (transport hΔ (p.reindex hΓ hs) (b.reindex hs)).code :=
  transport_code_reindex hΓ hΔ p b hs

/-- The concatenation raw syntax also reaches fresh construction. The missing
parallel result concerns its all-model annotation, not expression substitution. -/
theorem concatFreshRawComparison :
    (concat hΓ p q).raw.sub σ =
      (concat hΔ (p.reindex hΓ hs) (q.reindex hΓ hs)).raw :=
  concat_raw_reindex hΓ hΔ p q hs

end Experiments.DependentCongruenceResumption
